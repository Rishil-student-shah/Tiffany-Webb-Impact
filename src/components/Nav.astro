---
import Button from './Button.astro';
---

<header class="header js-header" role="banner" aria-label="Main Navigation">
  <!-- The clickable Dynamic Island pill (only active when scrolled-down) -->
  <button class="island-back-to-top js-island-btn" aria-label="Back to top">
    <span class="island-name">Tiffany Webb</span>
  </button>

  <div class="header-container">
    <a href="/" class="logo" aria-label="Tiffany Webb Homepage">
      <span class="logo-text">Tiffany Webb</span>
      <span class="logo-sub"><span class="italic-accent">Community Impact Strategist</span></span>
    </a>

    <nav class="nav-desktop" aria-label="Desktop Navigation">
      <ul class="nav-list">
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/about" class="nav-link">About</a></li>
        <li><a href="/speaking" class="nav-link">Speaking</a></li>
        <li><a href="/impact" class="nav-link">Impact</a></li>
        <li><a href="/media" class="nav-link">Media</a></li>
      </ul>
      <Button href="/book" variant="primary" className="nav-cta">Book Tiffany</Button>
    </nav>

    <button class="menu-toggle js-menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Toggle navigation">
      <span class="hamburger"></span>
    </button>
  </div>

  <!-- Mobile Overlay -->
  <nav id="mobile-nav" class="nav-mobile" aria-hidden="true" aria-label="Mobile Navigation">
    <ul class="nav-mobile-list">
      <li><a href="/" class="nav-mobile-link">Home</a></li>
      <li><a href="/about" class="nav-mobile-link">About</a></li>
      <li><a href="/speaking" class="nav-mobile-link">Speaking</a></li>
      <li><a href="/impact" class="nav-mobile-link">Impact</a></li>
      <li><a href="/media" class="nav-mobile-link">Media</a></li>
      <li class="mt-8"><Button href="/book" variant="primary">Book Tiffany</Button></li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector('.js-header') as HTMLElement | null;
  const toggle = document.querySelector('.js-menu-toggle') as HTMLButtonElement | null;
  const mobileNav = document.getElementById('mobile-nav');
  const islandBtn = document.querySelector('.js-island-btn') as HTMLButtonElement | null;

  let lastScrollY = window.scrollY;
  let ticking = false;
  let scrollDirection = 'down';

  // Scroll to top when clicking the dynamic island pill
  islandBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  const updateHeaderState = () => {
    const currentScrollY = window.scrollY;
    
    // Determine scroll direction with a 2px buffer to ignore micro-jitters
    if (currentScrollY > lastScrollY + 2) {
      scrollDirection = 'down';
    } else if (currentScrollY < lastScrollY - 2) {
      scrollDirection = 'up';
    }

    // ── ZONE 1: Top of page — fully transparent, full nav ──
    if (currentScrollY <= 15) {
      if (header?.classList.contains('is-scrolled-down') || header?.classList.contains('is-scrolled-up')) {
        header?.classList.remove('is-scrolled-down', 'is-scrolled-up');
      }
    }
    // ── ZONE 2: Scrolling DOWN past threshold → Dynamic Island ──
    // Trigger almost instantly
    else if (scrollDirection === 'down' && currentScrollY > 30) {
      if (!header?.classList.contains('is-scrolled-down')) {
        header?.classList.remove('is-scrolled-up');
        header?.classList.add('is-scrolled-down');
      }
    }
    // ── ZONE 3: Scrolling UP (must be past top threshold) ──
    else if (scrollDirection === 'up' && currentScrollY > 15) {
      if (!header?.classList.contains('is-scrolled-up')) {
        header?.classList.remove('is-scrolled-down');
        header?.classList.add('is-scrolled-up');
      }
    }

    lastScrollY = currentScrollY;
    ticking = false;
  };

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(updateHeaderState);
      ticking = true;
    }
  }, { passive: true });

  // Mobile Menu Toggle
  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isExpanded));
    mobileNav?.setAttribute('aria-hidden', String(isExpanded));

    if (!isExpanded) {
      header?.classList.add('menu-open');
      document.body.style.overflow = 'hidden';
    } else {
      header?.classList.remove('menu-open');
      document.body.style.overflow = '';
    }
  });
</script>

<style>
  /* ============================================================
     BASE HEADER — at top of page, transparent over hero
  ============================================================ */
  .header {
    position: fixed;
    top: 32px; /* Pushed down from the top edge as requested */
    left: 50%;
    transform: translateX(-50%);
    /* 48px each side = clear breathing room from viewport edge */
    width: calc(100% - 96px);
    max-width: 1400px;
    z-index: 1000;
    padding: var(--sp-5) var(--sp-8);
    border-radius: 28px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-ivory);
    transition:
      max-width 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      padding 0.15s ease,
      top 0.15s ease;
  }

  @media (min-width: 768px) {
    .header {
      top: 48px; /* Push the logo down further on desktop */
      /* Wider screens get more generous margin */
      width: calc(100% - 96px);
      border-radius: 40px;
      padding: var(--sp-5) var(--sp-10);
    }
  }

  /* ============================================================
     STATE: SCROLLING UP — Glassmorphic floating full-width bar
  ============================================================ */
  .header.is-scrolled-up {
    background: rgba(14, 12, 9, 0.75);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.55);
    padding: var(--sp-4) var(--sp-8);
    max-width: 1100px;
    width: calc(100% - 80px);
  }

  /* ============================================================
     STATE: SCROLLING DOWN — Dynamic Island pill (name only)
  ============================================================ */
  .header.is-scrolled-down {
    /* Exact iPhone Dynamic Island dimensions */
    max-width: 220px; /* Made longer for a sleek, non-rectangular pill shape */
    width: 220px;
    height: 36px;
    top: 24px; 
    padding: 0 var(--sp-4);
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 100px; /* 100px guarantees a perfect pill shape */
    background: #0e0c09; /* Pure dark pill */
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(217, 162, 58, 0.35);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.7), 0 0 0 0.5px rgba(217, 162, 58, 0.15);
  }

  /* Scale slightly when user hovers the pill to invite a click */
  .header.is-scrolled-down:hover {
    border-color: rgba(217, 162, 58, 0.65);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.8), 0 0 18px rgba(217, 162, 58, 0.15);
  }

  /* ============================================================
     MOBILE MENU OPEN override
  ============================================================ */
  .header.menu-open {
    max-width: calc(100% - 32px) !important;
    background: var(--color-charcoal) !important;
    border-color: transparent !important;
    box-shadow: none !important;
    border-radius: 28px 28px 0 0 !important;
  }

  /* ============================================================
     DYNAMIC ISLAND BACK-TO-TOP BUTTON
  ============================================================ */
  .island-back-to-top {
    /* Hidden by default — only visible in Dynamic Island mode */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: transparent;
    border: none;
    color: var(--color-ivory);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    border-radius: inherit;
  }

  .header.is-scrolled-down .island-back-to-top {
    opacity: 1;
    pointer-events: auto;
  } /* <-- FIXED MISSING BRACKET HERE */

  .island-name {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    white-space: nowrap;
    line-height: 1;
    /* Subtle gradient echo of the logo */
    background: linear-gradient(92deg, var(--color-mustard), var(--color-ivory));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .island-arrow {
    font-size: 0.75rem;
    color: rgba(217, 162, 58, 0.7);
    transition: transform 0.3s ease;
  }

  .header.is-scrolled-down:hover .island-arrow {
    transform: translateY(-3px);
  }

  /* ============================================================
     HEADER INNER CONTAINER
  ============================================================ */
  .header-container {
    width: 100%;
    box-sizing: border-box;
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: opacity 0.35s ease;
  }

  @media (min-width: 1024px) {
    .header-container {
      /* No extra padding, let the header padding handle it */
    }
  }

  /* Hide the normal nav row when in island mode */
  .header.is-scrolled-down .header-container {
    opacity: 0;
    pointer-events: none;
  }

  /* ============================================================
     LOGO
  ============================================================ */
  .logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-serif); /* Reverted to serif */
    font-size: 2rem; /* Adjusted size */
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    transition: font-size 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Shrink logo text in floating bar to keep things compact */
  .header.is-scrolled-up .logo-text {
    font-size: 1.5rem;
  }

  .logo-sub {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin-top: 4px;
    overflow: hidden;
    max-height: 40px;
    opacity: 1;
    transition: opacity 0.4s ease, max-height 0.4s ease, margin-top 0.4s ease;
  }

  .header.is-scrolled-up .logo-sub {
    opacity: 0;
    max-height: 0;
    margin-top: 0;
  }

  .logo-sub .italic-accent {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(92deg, var(--color-mustard), var(--color-coral), var(--color-berry));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ============================================================
     DESKTOP NAV
  ============================================================ */
  .nav-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: flex;
      align-items: center;
      gap: var(--sp-8);
    }
    .nav-list {
      display: flex;
      list-style: none;
      gap: var(--sp-8);
    }
  }

  /* ============================================================
     NAV LINKS — Glassmorphic pill hover
  ============================================================ */
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: inherit;
    text-decoration: none;
    position: relative;
    padding: var(--sp-2) var(--sp-4);
    border-radius: 20px;
    transition: color 0.35s ease;
    z-index: 1;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(217, 162, 58, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 20px;
    z-index: -1;
    transform: scale(0.75);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }

  .nav-link:hover {
    color: var(--color-gold);
  }

  .nav-link:hover::before {
    transform: scale(1);
    opacity: 1;
  }

  /* ============================================================
     HAMBURGER (mobile only)
  ============================================================ */
  .menu-toggle {
    display: block;
    width: 32px;
    height: 32px;
    position: relative;
    z-index: 101;
    color: inherit;
    background: transparent;
    border: none;
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 24px;
    height: 1px;
    background-color: currentColor;
    position: absolute;
    transition: transform 0.3s ease, top 0.3s ease, bottom 0.3s ease;
  }

  .hamburger {
    top: 50%;
    left: 4px;
    transform: translateY(-50%);
  }

  .hamburger::before {
    content: '';
    top: -6px;
    left: 0;
  }

  .hamburger::after {
    content: '';
    bottom: -6px;
    left: 0;
  }

  .menu-toggle[aria-expanded="true"] .hamburger {
    background-color: transparent;
  }

  .menu-toggle[aria-expanded="true"] .hamburger::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .hamburger::after {
    bottom: 0;
    transform: rotate(-45deg);
  }

  /* ============================================================
     MOBILE OVERLAY
  ============================================================ */
  .nav-mobile {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--color-charcoal);
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--sp-6);
    opacity: 0;
    visibility: hidden; /* Fixes ARIA focus issue */
    pointer-events: none;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  .nav-mobile[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .nav-mobile-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    text-align: center;
    list-style: none;
  }

  .nav-mobile-link {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    color: var(--color-ivory);
    text-decoration: none;
  }

  .mt-8 {
    margin-top: var(--sp-8);
  }
</style>
