---
import { navLinks, navCta } from '../config/navigation.js';
import mysql from 'mysql2/promise';

let activePages = [];
try {
  const pool = mysql.createPool({
    host: 'localhost',
    user: 'root',
    password: '@rishil8124shah',
    database: 'tiffany_crm',
    waitForConnections: true,
    connectionLimit: 10,
    queueLimit: 0
  });
  const [rows] = await pool.query('SELECT slug FROM website_pages WHERE is_active = 1');
  activePages = rows.map(r => r.slug === 'home' ? '/' : `/${r.slug}`);
  await pool.end();
} catch(e) {
  console.error('Navbar DB Query Error:', e);
}

const currentPath = Astro.url.pathname;
const filteredNavLinks = navLinks.filter(link => activePages.includes(link.href) || link.href.startsWith('http'));
---

<header class="fixed-luxury-header js-fixed-header" role="banner" aria-label="Main Navigation">
  <div class="header-inner">
    <!-- Brand Logo / Wordmark -->
    <a href="/" class="brand-logo" aria-label="Tiffany Webb Homepage">
      <span class="brand-title">Tiffany Webb</span>
      <span class="brand-subtitle">Community Impact Strategist</span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-desktop" aria-label="Desktop Navigation">
      <ul class="nav-list">
        {filteredNavLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <li class="nav-item">
              <a href={link.href} class={`nav-link ${isActive ? 'is-active' : ''}`}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Header Right Actions: CTA Button + Mobile Hamburger -->
    <div class="header-actions">
      <a href={navCta.href} class="nav-cta-btn">
        {navCta.label}
      </a>

      <button 
        class="mobile-toggle-btn js-mobile-toggle" 
        type="button"
        aria-expanded="false" 
        aria-controls="mobile-nav-drawer" 
        aria-label="Toggle navigation menu"
      >
        <span class="hamburger-icon">
          <span class="line line-1"></span>
          <span class="line line-2"></span>
        </span>
      </button>

      <!-- Compact Floating Dropdown Menu (Exact Dynamic Island Menu Size) -->
      <div id="mobile-nav-drawer" class="mobile-drawer" aria-hidden="true">
        <ul class="mobile-nav-list">
          {filteredNavLinks.map((link) => {
            const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
            return (
              <li class="mobile-nav-item">
                <a href={link.href} class={`mobile-nav-link ${isActive ? 'is-active' : ''}`}>
                  <span>{link.label}</span>
                  {isActive && <span class="mobile-active-dot"></span>}
                </a>
              </li>
            );
          })}
        </ul>

        <div class="mobile-drawer-footer">
          <a href={navCta.href} class="mobile-cta-btn">
            {navCta.label}
          </a>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.querySelector('.js-fixed-header') as HTMLElement | null;
    const toggleBtn = document.querySelector('.js-mobile-toggle') as HTMLButtonElement | null;
    const mobileDrawer = document.getElementById('mobile-nav-drawer');

    // Subtle shadow depth on scroll
    const handleScroll = () => {
      if (window.scrollY > 20) {
        header?.classList.add('is-scrolled');
      } else {
        header?.classList.remove('is-scrolled');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Compact Dropdown Toggle
    if (toggleBtn && mobileDrawer) {
      const closeDrawer = () => {
        toggleBtn.setAttribute('aria-expanded', 'false');
        mobileDrawer.setAttribute('aria-hidden', 'true');
        mobileDrawer.classList.remove('is-open');
        toggleBtn.classList.remove('is-active');
      };

      const openDrawer = () => {
        toggleBtn.setAttribute('aria-expanded', 'true');
        mobileDrawer.setAttribute('aria-hidden', 'false');
        mobileDrawer.classList.add('is-open');
        toggleBtn.classList.add('is-active');
      };

      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = mobileDrawer.classList.contains('is-open');
        if (isOpen) {
          closeDrawer();
        } else {
          openDrawer();
        }
      });

      // Close when clicking any link inside dropdown
      mobileDrawer.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          closeDrawer();
        });
      });

      // Close when clicking anywhere outside
      document.addEventListener('click', (e) => {
        if (!header?.contains(e.target as Node)) {
          closeDrawer();
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeDrawer();
        }
      });
    }
  });
</script>

<style>
  /* ============================================================
     SOLID INTEGRATED NAVBAR (Inside Website Card, Solid Background)
  ============================================================ */
  .fixed-luxury-header {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    background-color: var(--color-ink, #0D0C08);
    border-bottom: 1px solid rgba(217, 162, 58, 0.2);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    z-index: 1000;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
  }

  @media (min-width: 768px) {
    .fixed-luxury-header {
      height: 76px;
    }
  }

  .fixed-luxury-header.is-scrolled {
    border-bottom-color: rgba(217, 162, 58, 0.35);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.7);
  }

  .header-inner {
    max-width: 1360px;
    height: 100%;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    position: relative;
  }

  @media (min-width: 768px) {
    .header-inner {
      padding: 0 2.5rem;
    }
  }

  /* Brand Logo / Wordmark */
  .brand-logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .brand-logo:hover {
    opacity: 0.9;
  }

  .brand-title {
    font-family: var(--font-serif, 'Fraunces', serif);
    font-size: 1.35rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-ivory, #FBF6EA);
    line-height: 1.1;
    transition: color 0.3s ease;
  }

  .brand-logo:hover .brand-title {
    color: var(--color-gold, #D9A23A);
  }

  .brand-subtitle {
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold, #D9A23A);
    opacity: 0.9;
    margin-top: 2px;
  }

  /* Desktop Navigation Links */
  .nav-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: block;
    }
  }

  .nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .nav-item {
    position: relative;
  }

  .nav-link {
    display: inline-block;
    position: relative;
    padding: 0.5rem 0.85rem;
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ivory, #FBF6EA);
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 75%;
    height: 1.5px;
    background: var(--color-gold, #D9A23A);
    box-shadow: 0 0 8px rgba(217, 162, 58, 0.6);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover, .nav-link.is-active {
    color: var(--color-gold, #D9A23A);
  }

  .nav-link:hover::after, .nav-link.is-active::after {
    transform: translateX(-50%) scaleX(1);
  }

  /* Header Actions (Right) */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    position: relative;
  }

  .nav-cta-btn {
    display: none;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.65rem 1.4rem;
    border-radius: 999px;
    background: rgba(217, 162, 58, 0.12);
    color: var(--color-gold, #D9A23A) !important;
    border: 1.5px solid var(--color-gold, #D9A23A);
    text-decoration: none;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .nav-cta-btn {
      display: inline-flex;
    }
  }

  .nav-cta-btn:hover {
    background: var(--color-gold, #D9A23A);
    color: #080705 !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(217, 162, 58, 0.4), 0 0 15px rgba(217, 162, 58, 0.25);
  }

  /* Mobile Hamburger Toggle Button */
  .mobile-toggle-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(217, 162, 58, 0.08);
    border: 1px solid rgba(217, 162, 58, 0.35);
    color: var(--color-gold, #D9A23A);
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  @media (min-width: 1024px) {
    .mobile-toggle-btn {
      display: none;
    }
  }

  .mobile-toggle-btn:hover {
    background: rgba(217, 162, 58, 0.2);
    border-color: var(--color-gold, #D9A23A);
  }

  .hamburger-icon {
    position: relative;
    width: 18px;
    height: 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .hamburger-icon .line {
    display: block;
    width: 100%;
    height: 2px;
    background-color: var(--color-gold, #D9A23A);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .mobile-toggle-btn.is-active .line-1 {
    transform: translateY(5px) rotate(45deg);
  }

  .mobile-toggle-btn.is-active .line-2 {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* ============================================================
     COMPACT FLOATING DROPDOWN (Matches Dynamic Island Menu Size)
  ============================================================ */
  .mobile-drawer {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 230px;
    height: auto;
    border-radius: 20px;
    padding: 1.25rem 1.1rem;
    background: #0e0c09;
    border: 1px solid rgba(217, 162, 58, 0.35);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.85), 0 0 20px rgba(217, 162, 58, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transform: translateY(-10px) scale(0.95);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.3s ease;
    z-index: 1001;
    box-sizing: border-box;
  }

  .mobile-drawer.is-open {
    transform: translateY(0) scale(1);
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .mobile-nav-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 0.5rem;
  }

  .mobile-nav-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-serif, 'Fraunces', serif);
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--color-ivory, #FBF6EA);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    padding: 0.15rem 0;
  }

  .mobile-nav-link:hover, .mobile-nav-link.is-active {
    color: var(--color-gold, #D9A23A);
    transform: translateX(4px);
  }

  .mobile-active-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold, #D9A23A);
    box-shadow: 0 0 8px rgba(217, 162, 58, 0.8);
  }

  .mobile-drawer-footer {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(217, 162, 58, 0.2);
  }

  .mobile-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    background: var(--color-gold, #D9A23A);
    color: #080705 !important;
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 4px 15px rgba(217, 162, 58, 0.3);
    box-sizing: border-box;
    transition: transform 0.2s ease;
  }

  .mobile-cta-btn:active {
    transform: scale(0.97);
  }

  /* Responsive header height on mobile */
  @media (max-width: 640px) {
    .fixed-luxury-header {
      height: 64px;
    }

    .brand-title {
      font-size: 1.15rem;
    }

    .brand-subtitle {
      font-size: 0.58rem;
      letter-spacing: 0.14em;
    }
  }
</style>
