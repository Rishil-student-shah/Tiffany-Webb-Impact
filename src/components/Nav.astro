---
import Button from './Button.astro';
import { navLinks, navCta } from '../config/navigation.js';
import Waveform from './Waveform.astro';
import mysql from 'mysql2/promise';

let activePages = [];
try {
  const pool = mysql.createPool({
    host: 'localhost',
    user: 'root',
    password: '@rishil8124shah',
    database: 'tiffany_crm',
    waitForConnections: true,
    connectionLimit: 10,
    queueLimit: 0
  });
  const [rows] = await pool.query('SELECT slug FROM website_pages WHERE is_active = 1');
  activePages = rows.map(r => r.slug === 'home' ? '/' : `/${r.slug}`);
 await pool.end();
} catch(e) {
  console.error(e);
}

const filteredNavLinks = navLinks.filter(link => activePages.includes(link.href) || link.href.startsWith('http'));

---

<header class="header js-header" role="banner" aria-label="Main Navigation" style="overflow: hidden;">
    <div style="position: absolute; inset: 0; z-index: -1; pointer-events: none;">
      <Waveform opacity={0.06} variant="A" />
    </div>
  <!-- The clickable Dynamic Island pill (only active when scrolled-down) -->
  <div class="island-back-to-top">
    <button class="js-island-btn" aria-label="Back to top" style="background:none; border:none; color:inherit; font:inherit; cursor:pointer; display:flex; align-items:center; padding: 0; outline: none;">
      <span class="island-name">Tiffany Webb</span>
    </button>
    <button class="menu-toggle js-menu-toggle island-menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Toggle navigation">
      <span class="hamburger"></span>
    </button>
  </div>

  <div class="header-container">
    <a href="/" class="logo" aria-label="Tiffany Webb Homepage">
      <span class="logo-text">Tiffany Webb</span>
      <span class="logo-sub"><span class="italic-accent">Community Impact Strategist</span></span>
    </a>

    <nav class="nav-desktop" aria-label="Desktop Navigation">
      <ul class="nav-list">
        {filteredNavLinks.map((link) => (
          <li><a href={link.href} class="nav-link">{link.label}</a></li>
        ))}
      </ul>
      <Button href={navCta.href} variant="secondary" className="nav-cta">{navCta.label}</Button>
    </nav>

    <button class="menu-toggle js-menu-toggle" aria-expanded="false" aria-controls="mobile-nav" aria-label="Toggle navigation">
      <span class="hamburger"></span>
    </button>
  </div>

  <!-- Mobile Overlay -->
  <nav id="mobile-nav" class="nav-mobile" aria-hidden="true" aria-label="Mobile Navigation">
    <ul class="nav-mobile-list">
      {filteredNavLinks.map((link) => (
        <li><a href={link.href} class="nav-mobile-link">{link.label}</a></li>
      ))}
      <li class="mt-8"><Button href={navCta.href} variant="secondary">{navCta.label}</Button></li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector('.js-header') as HTMLElement | null;
  const mobileNav = document.getElementById('mobile-nav');
  const islandBtn = document.querySelector('.js-island-btn') as HTMLButtonElement | null;

  let lastScrollY = window.scrollY;
  let ticking = false;

  // Scroll to top when clicking the dynamic island pill
  islandBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  const updateHeaderState = () => {
    const currentScrollY = window.scrollY;

    // ZONE 1: Top of page – fully transparent, full nav
    if (currentScrollY <= 15) {
      if (header?.classList.contains('is-scrolled-down') || header?.classList.contains('is-scrolled-up')) {
        header?.classList.remove('is-scrolled-down', 'is-scrolled-up');
      }
    }
    // ZONE 2: Scrolled past top -> Dynamic Island (always on, even when scrolling up)
    else if (currentScrollY > 15) {
      if (!header?.classList.contains('is-scrolled-down')) {
        header?.classList.remove('is-scrolled-up');
        header?.classList.add('is-scrolled-down');
      }
    }

    lastScrollY = currentScrollY;
    ticking = false;
  };

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(updateHeaderState);
      ticking = true;
    }
  }, { passive: true });

  // Initial check in case they navigated to a page scrolled down
  updateHeaderState();

  // Mobile Menu Toggles
  const toggles = document.querySelectorAll('.js-menu-toggle');
  toggles.forEach(toggle => {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggles.forEach(t => t.setAttribute('aria-expanded', String(!isExpanded)));
      mobileNav?.setAttribute('aria-hidden', String(isExpanded));

      if (!isExpanded) {
        header?.classList.add('menu-open');
        document.body.style.overflow = 'hidden';
      } else {
        header?.classList.remove('menu-open');
        document.body.style.overflow = '';
      }
    });
  });
</script>

<style>
  /* ============================================================
     BASE HEADER — at top of page, transparent over hero
  ============================================================ */
  .header {
    background: transparent;
    position: fixed;
    top: 32px; /* Pushed down from the top edge as requested */
    left: 50%;
    transform: translateX(-50%);
    /* 48px each side = clear breathing room from viewport edge */
    width: calc(100% - 96px);
    max-width: 1400px;
    z-index: 1000;
    padding: var(--sp-5) var(--sp-8);
    border-radius: 28px;
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-ivory);
    transition:
      max-width 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.18s cubic-bezier(0.16, 1, 0.3, 1),
      background 0.15s ease,
      border-color 0.15s ease,
      box-shadow 0.15s ease,
      padding 0.15s ease,
      top 0.15s ease;
  }

  @media (min-width: 768px) {
    .header {
      top: 48px; /* Push the logo down further on desktop */
      /* Wider screens get more generous margin */
      width: calc(100% - 96px);
      border-radius: 40px;
      padding: var(--sp-5) var(--sp-10);
    }
  }

  /* ============================================================
     STATE: SCROLLING DOWN — Dynamic Island pill (name only)
  ============================================================ */
  .header.is-scrolled-down {
    /* Exact iPhone Dynamic Island dimensions */
    max-width: 220px; /* Made longer for a sleek, non-rectangular pill shape */
    width: 220px;
    height: 36px;
    top: 24px; 
    padding: 0 var(--sp-4);
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 100px; /* 100px guarantees a perfect pill shape */
    background: #0e0c09; /* Pure dark pill */
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(217, 162, 58, 0.35);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.7), 0 0 0 0.5px rgba(217, 162, 58, 0.15);
  }

  /* Scale slightly when user hovers the pill to invite a click */
  .header.is-scrolled-down:hover {
    border-color: rgba(217, 162, 58, 0.65);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.8), 0 0 18px rgba(217, 162, 58, 0.15);
  }

  /* ============================================================
     MOBILE MENU OPEN override
  ============================================================ */
  .header:not(.is-scrolled-down).menu-open {
    max-width: calc(100% - 32px) !important;
    background: var(--color-charcoal) !important;
    border-color: transparent !important;
    box-shadow: none !important;
    border-radius: 28px 28px 0 0 !important;
  }

  /* ============================================================
     DYNAMIC ISLAND BACK-TO-TOP BUTTON
  ============================================================ */
  .island-back-to-top {
    /* Hidden by default — only visible in Dynamic Island mode */
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    background: transparent;
    border: none;
    color: var(--color-ivory);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
    border-radius: inherit;
  }

  .island-menu-toggle {
    display: block !important;
    position: relative;
    width: 24px;
    height: 24px;
  }

  .header.is-scrolled-down .island-back-to-top {
    opacity: 1;
    pointer-events: auto;
  }

  .island-name {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    white-space: nowrap;
    line-height: 1;
    /* Subtle gradient echo of the logo */
    background: linear-gradient(92deg, var(--color-mustard), var(--color-ivory));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .island-arrow {
    font-size: 0.75rem;
    color: rgba(217, 162, 58, 0.7);
    transition: transform 0.3s ease;
  }

  .header.is-scrolled-down:hover .island-arrow {
    transform: translateY(-3px);
  }

  /* ============================================================
     HEADER INNER CONTAINER
  ============================================================ */
  .header-container {
    width: 100%;
    box-sizing: border-box;
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: opacity 0.35s ease;
  }

  @media (min-width: 1024px) {
    .header-container {
      /* No extra padding, let the header padding handle it */
    }
  }

  /* Hide the normal nav row when in island mode */
  .header.is-scrolled-down .header-container {
    opacity: 0;
    pointer-events: none;
  }

  /* ============================================================
     LOGO
  ============================================================ */
  .logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--font-serif); /* Reverted to serif */
    font-size: 2rem; /* Adjusted size */
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    transition: font-size 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Shrink logo text in floating bar to keep things compact */

  .logo-sub {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    margin-top: 4px;
    overflow: hidden;
    max-height: 40px;
    opacity: 1;
    transition: opacity 0.4s ease, max-height 0.4s ease, margin-top 0.4s ease;
  }

  .logo-sub .italic-accent {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(92deg, var(--color-mustard), var(--color-coral), var(--color-berry));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ============================================================
     DESKTOP NAV
  ============================================================ */
  .nav-desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .nav-desktop {
      display: flex;
      align-items: center;
      gap: var(--sp-8);
    }
    .nav-list {
      display: flex;
      list-style: none;
      gap: var(--sp-8);
    }
  }

  /* ============================================================
     NAV LINKS — Glassmorphic pill hover
  ============================================================ */
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: inherit;
    text-decoration: none;
    position: relative;
    padding: var(--sp-2) var(--sp-4);
    border-radius: 20px;
    transition: color 0.35s ease;
    z-index: 1;
  }

  .nav-link::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(217, 162, 58, 0.12);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-radius: 20px;
    z-index: -1;
    transform: scale(0.75);
    opacity: 0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
  }

  .nav-link:hover {
    color: var(--color-gold);
  }

  .nav-link:hover::before {
    transform: scale(1);
    opacity: 1;
  }

  /* ============================================================
     HAMBURGER (mobile only)
  ============================================================ */
  .menu-toggle {
    display: block;
    width: 32px;
    height: 32px;
    position: relative;
    z-index: 101;
    color: inherit;
    background: transparent;
    border: none;
  }

  @media (min-width: 1024px) {
    .menu-toggle {
      display: none;
    }
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 24px;
    height: 1px;
    background-color: currentColor;
    position: absolute;
    transition: transform 0.3s ease, top 0.3s ease, bottom 0.3s ease;
  }

  .hamburger {
    top: 50%;
    left: 4px;
    transform: translateY(-50%);
  }

  .hamburger::before {
    content: '';
    top: -6px;
    left: 0;
  }

  .hamburger::after {
    content: '';
    bottom: -6px;
    left: 0;
  }

  .menu-toggle[aria-expanded="true"] .hamburger {
    background-color: transparent;
  }

  .menu-toggle[aria-expanded="true"] .hamburger::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .hamburger::after {
    bottom: 0;
    transform: rotate(-45deg);
  }

  /* ============================================================
     MOBILE OVERLAY / COMPACT DROPDOWN
  ============================================================ */
  .nav-mobile {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: var(--color-charcoal);
    z-index: 99;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--sp-6);
    opacity: 0;
    visibility: hidden; /* Fixes ARIA focus issue */
    pointer-events: none;
    transition: opacity 0.4s ease, visibility 0.4s ease;
  }

  /* When the header is the Dynamic Island pill, make the menu a small compact dropdown */
  .header.is-scrolled-down .nav-mobile {
    position: absolute;
    top: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(-10px);
    width: 220px; /* Match pill width exactly */
    height: auto;
    border-radius: 24px;
    padding: var(--sp-6) var(--sp-4);
    background: #0e0c09;
    border: 1px solid rgba(217, 162, 58, 0.35); /* Gold border */
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.8), 0 0 20px rgba(217, 162, 58, 0.15);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: opacity 0.4s ease, visibility 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-mobile[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .header.is-scrolled-down .nav-mobile[aria-hidden="false"] {
    transform: translateX(-50%) translateY(0);
  }

  .nav-mobile-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    text-align: center;
    list-style: none;
  }

  /* Shrink the gap inside the compact dropdown */
  .header.is-scrolled-down .nav-mobile-list {
    gap: var(--sp-4);
  }

  .nav-mobile-link {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    color: var(--color-ivory);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .nav-mobile-link:hover {
    color: var(--color-gold);
  }

  /* Shrink text size inside the compact dropdown */
  .header.is-scrolled-down .nav-mobile-link {
    font-size: 1.15rem;
    padding: var(--sp-1) 0;
    display: block;
  }

  .mt-8 {
    margin-top: var(--sp-8);
  }

  .header.is-scrolled-down .mt-8 {
    margin-top: var(--sp-4);
  }
</style>

