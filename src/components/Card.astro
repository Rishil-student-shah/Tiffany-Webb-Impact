---
interface Props {
  isPlaceholder?: boolean;
  aspectRatio?: 'video' | 'square' | 'portrait';
  className?: string;
  imageSrc?: string;
  altText?: string;
}

const { 
  isPlaceholder = false, 
  aspectRatio = 'portrait',
  className = '',
  imageSrc,
  altText = ''
} = Astro.props;

const aspectClass = `aspect-${aspectRatio}`;
---

<div class={`card-wrapper ${aspectClass} ${className}`} data-placeholder={isPlaceholder ? 'true' : 'false'}>
  {isPlaceholder || !imageSrc ? (
    <div class="card-placeholder">
      <span class="text-micro">Asset Pending</span>
    </div>
  ) : (
    <img src={imageSrc} alt={altText} class="card-image" loading="lazy" />
  )}
  <slot />
</div>

<style>
  .card-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: var(--color-charcoal);
    border-radius: 2px; /* Slight softening */
  }

  /* Aspect Ratios */
  .aspect-video { aspect-ratio: 16 / 9; }
  .aspect-square { aspect-ratio: 1 / 1; }
  .aspect-portrait { aspect-ratio: 4 / 5; }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .card-wrapper:hover .card-image {
    transform: scale(1.03);
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--border-light);
    color: var(--color-muted-grey);
    border: 1px dashed var(--color-muted-grey);
  }
</style>
