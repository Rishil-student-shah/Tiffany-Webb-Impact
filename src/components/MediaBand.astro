---
import Button from './Button.astro';
---

<div class="media-band">
  <div class="media-container glass-card" style="background: rgba(10, 10, 10, 0.75); padding: 2.5rem; border-radius: 24px;">
    <div class="media-content">
      <h3 class="media-title">Need materials for your event?</h3>
      <p class="media-desc">Download Tiffany's speaker sheet or request a full press kit.</p>
    </div>
    <div class="media-actions">
      <Button href="/media" variant="secondary" className="media-btn">Get Media Kit &rarr;</Button>
    </div>
  </div>
</div>

<style>
  .media-band {
    padding: var(--sp-6) 0;
  }

  .media-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
    text-align: center;
  }

  @media (min-width: 768px) {
    .media-container {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }
  }

  .media-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-gold);
    margin-bottom: 4px;
  }

  .media-desc {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .media-btn {
    white-space: nowrap;
  }
</style>