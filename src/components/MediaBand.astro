---
const { content = {} } = Astro.props;

const headline = content.headline || "Ready for the room — and the story.";
const link1 = content.link_1 || "Download the speaker sheet";
const link2 = content.link_2 || "Media resources";
---

<div class="media-band-section theme-ink">
  <div class="container-narrow relative z-10 h-full" style="padding-left: 5vw; padding-right: 5vw;">
    <div class="media-band-wrapper">
      <div class="media-left">
        <h3 class="media-headline" style="background: linear-gradient(92deg, var(--color-gold), var(--color-coral)); -webkit-background-clip: text; background-clip: text; color: transparent; display: inline-block;">{headline}</h3>
      </div>
      
      <div class="media-right">
        <a href="/media" class="btn btn-outline-ivory media-btn">
          {link1}
        </a>
        <a href="/media" class="media-text-link" style="display: inline-block;">{link2} <span class="arrow">&rarr;</span></a>
      </div>
    </div>
  </div>
</div>

<style>
  .media-band-section {
    width: 100%;
    /* Visually quieter background, just a faint dark ink */
    background: var(--color-ink);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .media-band-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    padding: 3rem 0;
    min-height: 160px; /* Roughly 160px tall on desktop */
  }

  @media (min-width: 768px) {
    .media-band-wrapper {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      padding: 0;
    }
  }

  .media-left {
    flex: 1;
  }

  .media-headline {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--color-ivory);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: 0.02em;
    opacity: 0.9;
  }

  .media-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .media-right {
      flex-direction: row;
      align-items: center;
      gap: 2.5rem;
    }
  }


  .media-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8rem;
    padding: 0.85rem 1.8rem;
    white-space: nowrap;
    background: transparent;
    color: var(--color-ivory) !important;
    border: 1.5px solid rgba(251, 246, 234, 0.45);
    border-radius: 100px;
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .media-btn:hover {
    background: rgba(251, 246, 234, 0.14);
    border-color: var(--color-ivory);
    transform: translateY(-3px);
  }


  .media-text-link {
    color: var(--color-parchment);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.3s ease;
    white-space: nowrap;
  }

  .media-text-link:hover {
    color: var(--color-gold);
  }
</style>
