---
const { content = {} } = Astro.props;

let rawHeadline = content.headline || "Ready for the room and the story.";
let cleanHeadline = rawHeadline.replace(/\s*\?\s*/g, ' ').replace(/\s*—\s*/g, ' ');
let headline = cleanHeadline.includes('<span')
  ? cleanHeadline
  : `<span class="title-white">Ready for the room</span> <span class="italic-accent">and the story.</span>`;

const link1 = content.link_1 ?? "Download the speaker sheet";
const link2 = content.link_2 ?? "Media resources";
---

<div class="media-band-section theme-ink">
  <div class="container-narrow relative z-10 h-full" style="padding-left: 5vw; padding-right: 5vw;">
    <div class="media-band-wrapper">
      <div class="media-left">
        {headline && <h3 class="media-headline" set:html={headline}></h3>}
      </div>
      
      <div class="media-right">
        <a href="/media" class="media-btn">
          {link1}
        </a>
        <a href="/media" class="media-text-link">
          <span>{link2}</span> <span class="arrow">&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .media-band-section {
    width: 100%;
    background: var(--color-ink);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .media-band-wrapper {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2rem;
    padding: 3.5rem 0;
    min-height: 160px;
  }

  @media (min-width: 768px) {
    .media-band-wrapper {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
      padding: 0;
    }
  }

  .media-left {
    flex: 1;
  }

  .media-headline {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    color: var(--color-ivory, #FBF6EA);
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .title-white {
    color: var(--color-ivory, #FBF6EA) !important;
  }

  .media-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .media-right {
      flex-direction: row;
      align-items: center;
      gap: 2.5rem;
    }
  }

  .media-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.9rem 2.2rem;
    white-space: nowrap;
    background: rgba(217, 162, 58, 0.12);
    color: var(--color-gold, #D9A23A) !important;
    border: 1.5px solid var(--color-gold, #D9A23A);
    border-radius: 100px;
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    text-shadow: none !important;
  }

  .media-btn:hover {
    background: var(--color-gold, #D9A23A);
    color: #0D0C08 !important;
    border-color: var(--color-gold, #D9A23A);
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(217, 162, 58, 0.35);
    text-shadow: none !important;
  }

  .media-text-link {
    color: #FBF6EA !important;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.3s ease;
    white-space: nowrap;
    opacity: 1 !important;
  }

  .media-text-link .arrow {
    color: var(--color-gold, #D9A23A);
    font-size: 1.1rem;
    transition: transform 0.3s ease;
  }

  .media-text-link:hover {
    color: var(--color-gold, #D9A23A) !important;
  }

  .media-text-link:hover .arrow {
    transform: translateX(4px);
  }
</style>
