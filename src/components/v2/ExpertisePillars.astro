---
import Eyebrow from '../Eyebrow.astro';
import Button from '../Button.astro';
---

<section class="expertise-pillars theme-ink reveal-up" style="background-color: var(--color-ink);">
  <div class="expertise-container">
    <div class="expertise-header">
      <Eyebrow>EXPERTISE</Eyebrow>
      <h2 class="section-title">What she speaks about.</h2>
      <p class="section-subtext">Six areas where fifteen years of frontline work turns into something a room can use on Monday.</p>
    </div>

    <div class="pillars-grid stagger-group">
      <div class="pillar-card stagger-item">
        <span class="pillar-number">01</span>
        <h3 class="pillar-title">Gambling Prevention</h3>
        <p class="pillar-desc">Awareness, early intervention, and prevention strategy built for real communities — not just campaigns that look good on paper.</p>
      </div>

      <div class="pillar-card stagger-item">
        <span class="pillar-number">02</span>
        <h3 class="pillar-title">Youth Gambling Prevention</h3>
        <p class="pillar-desc">Reaching students, parents, and educators before gambling harm takes hold — including the sports-betting apps already in their pockets.</p>
      </div>

      <div class="pillar-card stagger-item">
        <span class="pillar-number">03</span>
        <h3 class="pillar-title">Community Outreach</h3>
        <p class="pillar-desc">The relationship work that determines whether a prevention program lands or gets ignored.</p>
      </div>

      <div class="pillar-card stagger-item">
        <span class="pillar-number">04</span>
        <h3 class="pillar-title">Public Health Education</h3>
        <p class="pillar-desc">Making complex health information clear, human, and genuinely actionable for the people who need it most.</p>
      </div>

      <div class="pillar-card stagger-item">
        <span class="pillar-number">05</span>
        <h3 class="pillar-title">Behavioral Health Awareness</h3>
        <p class="pillar-desc">Reducing stigma and opening the conversations people have been carefully avoiding.</p>
      </div>

      <div class="pillar-card stagger-item">
        <span class="pillar-number">06</span>
        <h3 class="pillar-title">Screening & Early Intervention</h3>
        <p class="pillar-desc">Helping organizations move from reacting to crises toward catching harm early.</p>
      </div>
    </div>

    <div class="expertise-cta">
      <Button href="/speaking" variant="primary" className="magnetic-btn">Explore all 20 topics &rarr;</Button>
    </div>
  </div>
</section>

<style>
  .expertise-pillars {
    padding: var(--sp-24) 0;
    color: var(--color-ivory);
  }

  .expertise-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  .expertise-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto var(--sp-16);
  }

  .section-title {
    margin-top: var(--sp-4);
    margin-bottom: var(--sp-6);
  }

  .section-subtext {
    font-size: 1.125rem;
    color: #e7e0cf;
    line-height: 1.6;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    margin-bottom: var(--sp-16);
  }

  @media (min-width: 768px) {
    .pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pillars-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .pillar-card {
    background: rgba(20, 18, 14, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: var(--sp-8);
    transition: transform 0.3s ease, border-color 0.3s ease;
  }

  .pillar-card:hover {
    transform: translateY(-5px);
    border-color: rgba(217, 162, 58, 0.3); /* gold subtle hover */
  }

  .pillar-number {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-gold);
    display: block;
    margin-bottom: var(--sp-4);
  }

  .pillar-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-ivory);
    margin-bottom: var(--sp-3);
    line-height: 1.2;
  }

  .pillar-desc {
    font-size: 1rem;
    color: #e7e0cf;
    line-height: 1.5;
  }

  .expertise-cta {
    text-align: center;
  }
</style>
