---
import Waveform from '../Waveform.astro';
import Eyebrow from '../Eyebrow.astro';
import Button from '../Button.astro';
---

<section id="formats" class="speaking-formats section-pad theme-bold">
  <Waveform opacity={0.12} flipX={true} flipY={true} />
  <div class="container stagger-group">
    <div class="formats-header stagger-item">
      <Eyebrow>HOW TO WORK WITH HER</Eyebrow>
      <h2 class="section-title">Six ways to <span class="italic-accent">bring her in.</span></h2>
      <p class="formats-sub">Same expertise, shaped to fit your event — from a main-stage keynote to a full-day training.</p>
    </div>
    
    <div class="formats-grid">
      <!-- 1. Keynote -->
      <div class="flip-card stagger-item">
        <div class="flip-card-inner">
          <div class="flip-card-front glass-card" style="--card-accent: var(--color-gold);">
            <div class="card-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="22"></line></svg>
            </div>
            <h3 class="format-title">Keynote</h3>
            <p class="format-desc">A main-stage talk that reframes how a room thinks about prevention — and sends them home with something to do.</p>
            <span class="card-link">See details &rarr; <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
          </div>
          <div class="flip-card-back glass-card" style="--card-accent: var(--color-gold);">
            <h3 class="format-title" style="margin-bottom: var(--sp-6);">Keynote</h3>
            <p class="format-desc">45–60 minutes, main stage. Her story plus a practical call to action, tailored to your event's theme.</p>
            <p class="format-desc">Best for plenaries and opening or closing sessions.</p>
          </div>
        </div>
      </div>

      <!-- 2. Conference Session -->
      <div class="flip-card stagger-item">
        <div class="flip-card-inner">
          <div class="flip-card-front glass-card" style="--card-accent: var(--color-teal);">
            <div class="card-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
            <h3 class="format-title">Conference Session</h3>
            <p class="format-desc">Educational sessions built around your event's theme, track, and audience.</p>
            <span class="card-link">See details &rarr; <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
          </div>
          <div class="flip-card-back glass-card" style="--card-accent: var(--color-teal);">
            <h3 class="format-title" style="margin-bottom: var(--sp-6);">Conference Session</h3>
            <p class="format-desc">60–90 minutes, breakout format. Deeper on a chosen topic, with room for questions.</p>
            <p class="format-desc">CE-oriented content available for professional tracks.</p>
          </div>
        </div>
      </div>

      <!-- 3. Panel -->
      <div class="flip-card stagger-item">
        <div class="flip-card-inner">
          <div class="flip-card-front glass-card" style="--card-accent: var(--color-emerald);">
            <div class="card-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <h3 class="format-title">Panel</h3>
            <p class="format-desc">An expert voice on gambling harm, public health, and community impact — and a generous co-panelist.</p>
            <span class="card-link">See details &rarr; <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
          </div>
          <div class="flip-card-back glass-card" style="--card-accent: var(--color-emerald);">
            <h3 class="format-title" style="margin-bottom: var(--sp-6);">Panel</h3>
            <p class="format-desc">Tiffany as panelist or moderator. Brings frontline specificity to broader public-health discussions.</p>
            <p class="format-desc">Generous with co-panelists and comfortable with live audience questions.</p>
          </div>
        </div>
      </div>

      <!-- 4. School & University -->
      <div class="flip-card stagger-item">
        <div class="flip-card-inner">
          <div class="flip-card-front glass-card" style="--card-accent: var(--color-burnt);">
            <div class="card-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
            </div>
            <h3 class="format-title">School & University</h3>
            <p class="format-desc">Age-appropriate programs for students, plus separate sessions for parents and staff.</p>
            <span class="card-link">See details &rarr; <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
          </div>
          <div class="flip-card-back glass-card" style="--card-accent: var(--color-burnt);">
            <h3 class="format-title" style="margin-bottom: var(--sp-6);">School & University</h3>
            <p class="format-desc">A two-part structure works best: one session for students, and a separate one for the adults around them.</p>
            <p class="format-desc">Covers sports-betting apps, the crossover from gaming into gambling, and practical interventions.</p>
          </div>
        </div>
      </div>

      <!-- 5. Workshop -->
      <div class="flip-card stagger-item">
        <div class="flip-card-inner">
          <div class="flip-card-front glass-card" style="--card-accent: var(--color-purple);">
            <div class="card-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
            </div>
            <h3 class="format-title">Workshop</h3>
            <p class="format-desc">Interactive training for clinicians, coalitions, and frontline teams. Tools, not theory.</p>
            <span class="card-link">See details &rarr; <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
          </div>
          <div class="flip-card-back glass-card" style="--card-accent: var(--color-purple);">
            <h3 class="format-title" style="margin-bottom: var(--sp-6);">Workshop</h3>
            <p class="format-desc">Half-day or full-day, hands-on throughout. Skills practice in screening, motivational interviewing, and referral pathways.</p>
            <p class="format-desc">Built for teams who need to apply it on Monday, not just understand it on Friday.</p>
          </div>
        </div>
      </div>

      <!-- 6. Custom Program -->
      <div class="flip-card stagger-item">
        <div class="flip-card-inner">
          <div class="flip-card-front glass-card" style="--card-accent: var(--color-blue);">
            <div class="card-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
            </div>
            <h3 class="format-title">Custom Program</h3>
            <p class="format-desc">Built around your audience, objectives, timeline, and format.</p>
            <span class="card-link">See details &rarr; <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
          </div>
          <div class="flip-card-back glass-card" style="--card-accent: var(--color-blue);">
            <h3 class="format-title" style="margin-bottom: var(--sp-6);">Custom Program</h3>
            <p class="format-desc">A multi-session series, ongoing coalition support, or a program designed from scratch for your community.</p>
            <p class="format-desc">For organizations that want more than a single talk.</p>
          </div>
        </div>
      </div>
      
    </div>
    
    <div class="formats-cta stagger-item">
      <Button href="/book" variant="primary" style="background: var(--section-accent); color: var(--ink);">Request rates & availability &rarr;</Button>
    </div>
  </div>
</section>

<style>
  .speaking-formats {
    position: relative;
    z-index: 2;
    overflow: hidden;
  }
  
  .formats-header {
    text-align: center;
    margin-bottom: var(--sp-12);
  }
  
  .formats-sub {
    margin-top: 1rem;
    color: var(--section-text-muted);
    font-size: 1.125rem;
    max-width: 600px;
    margin-inline: auto;
  }
  
  .formats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--sp-6);
    margin-bottom: var(--sp-12);
  }

  /* Flip Card Container */
  .flip-card {
    background-color: transparent;
    height: 380px;
    perspective: 1000px; /* 3D effect */
  }

  /* The inner container that flips */
  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275); /* Bouncy flip */
    transform-style: preserve-3d;
  }

  /* Flip on hover */
  .flip-card:hover .flip-card-inner {
    transform: rotateY(180deg);
  }

  /* Front and back sides */
  .flip-card-front, .flip-card-back {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 16px;
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }

  /* Front styling */
  .card-icon-box {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--card-accent) 20%, transparent);
    color: var(--card-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--sp-6);
  }

  .format-title {
    font-size: 1.5rem;
    margin-bottom: var(--sp-4);
  }

  .format-desc {
    font-size: 1.05rem;
    line-height: 1.5;
    margin-bottom: var(--sp-6);
    flex-grow: 1;
    color: var(--section-text-muted);
  }

  .card-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--card-accent);
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
  }

  /* Back styling */
  .flip-card-back {
    transform: rotateY(180deg);
    justify-content: center;
  }

  .formats-cta {
    display: flex;
    justify-content: center;
  }
</style>
