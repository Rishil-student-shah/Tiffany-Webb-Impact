---
import Waveform from '../Waveform.astro';
---

<section class="credibility-bar theme-ink reveal-up" style="background-color: var(--color-ink); color: var(--color-gold); min-height: 76px; display: flex; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.05);">
  <Waveform opacity={0.04} flipX={true} />
  <div class="credibility-container">
    <div class="credibility-item">
      <span class="credibility-stat">15+</span>
      <span class="text-micro credibility-label">Years</span>
    </div>
    
    <div class="credibility-divider"></div>
    
    <div class="credibility-item">
      <span class="credibility-stat">4,000+</span>
      <span class="text-micro credibility-label">Hours of Outreach</span>
    </div>
    
    <div class="credibility-divider"></div>
    
    <div class="credibility-item">
      <span class="credibility-stat">20</span>
      <span class="text-micro credibility-label">Speaking Topics</span>
    </div>
  </div>
</section>

<style>
  .credibility-bar {
    padding: var(--sp-6) 0;
    border-top: none;
    border-bottom: none;
  }

  .credibility-container {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
  }

  @media (min-width: 768px) {
    .credibility-container {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .credibility-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .credibility-stat {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    line-height: 1;
    margin-bottom: var(--sp-2);
  }

  .credibility-divider {
    width: 40px;
    height: 1px;
    background-color: var(--color-gold);
    opacity: 0.3;
  }

  @media (min-width: 768px) {
    .credibility-divider {
      width: 1px;
      height: 60px;
    }
  }
</style>
