---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  className?: string;
  target?: string;
}

const { href, variant = 'primary', className = '', target } = Astro.props;
---

<a 
  href={href} 
  class={`btn btn-${variant} ${className}`}
  target={target}
  rel={target === '_blank' ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-4) var(--sp-8);
    font-family: var(--font-mono);
    font-size: var(--text-button);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.3s ease;
    border-radius: 99px;
  }

  .btn-primary {
    background-color: rgba(200, 162, 76, 0.15); /* Semi-transparent Gold */
    color: var(--color-ivory);
    backdrop-filter: blur(16px) saturate(180%);
    -webkit-backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid rgba(200, 162, 76, 0.4);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.2), 0 4px 12px rgba(0,0,0,0.1);
  }

  .btn-primary:hover {
    background-color: #D9A23A;
    border-color: #D9A23A;
    color: #0D0C08;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(217, 162, 58, 0.4);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-gold, #D9A23A);
    border: 1px solid var(--color-gold, #D9A23A);
  }

  .btn-secondary:hover {
    background-color: #D9A23A;
    border-color: #D9A23A;
    color: #0D0C08;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(217, 162, 58, 0.4);
  }
</style>
