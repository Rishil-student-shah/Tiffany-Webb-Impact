---
import Waveform from './Waveform.astro';
---

<section class="newsletter section-pad theme-ink">
  <Waveform opacity={0.06} flipX={true} />
  <div class="container stagger-group">
    <div class="newsletter-content stagger-item">
      <h2 class="section-title">Stay <span class="italic-accent">connected.</span></h2>
      <p class="newsletter-desc">Insights on prevention, public health, and the conversations that change communities. One email a month. Nothing else.</p>
    </div>
    
    <div class="newsletter-form-wrapper stagger-item">
      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Newsletter signup - backend integration required');">
        <label for="email" class="visually-hidden">Your email address</label>
        <input type="email" id="email" name="email" placeholder="Your email address" required class="newsletter-input" />
        <button type="submit" class="newsletter-btn">JOIN THE COMMUNITY</button>
      </form>
      <p class="newsletter-consent text-micro">By subscribing you agree to receive occasional emails from Tiffany Webb. Unsubscribe any time. See our Privacy Policy.</p>
    </div>
  </div>
</section>

<style>
  .newsletter {
    position: relative;
    z-index: 2;
    background: var(--glow-gradient);
  }
  
  .section-pad {
    padding: var(--sp-24) 0;
  }
  
  .container {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }

  @media (min-width: 768px) {
    .container {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-12);
      align-items: center;
    }
  }

  .newsletter-title {
    margin-bottom: var(--sp-4);
  }

  .newsletter-prose {
    font-size: 1.125rem;
    color: var(--section-text-muted);
  }

  .newsletter-form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }

  @media (min-width: 480px) {
    .newsletter-form {
      flex-direction: row;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .newsletter-input {
    flex: 1;
    padding: var(--sp-4);
    font-family: var(--font-sans);
    font-size: 1rem;
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--color-ivory);
    border-radius: 2px;
    transition: border-color 0.3s ease;
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--color-gold);
  }

  .newsletter-btn {
    padding: var(--sp-4) var(--sp-6);
    font-family: var(--font-mono);
    font-size: var(--text-button);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background-color: var(--color-gold);
    color: var(--color-ink);
    border: 1px solid var(--color-gold);
    border-radius: 2px;
    transition: background-color 0.3s ease;
    white-space: nowrap;
  }

  .newsletter-btn:hover {
    background-color: #E5C354;
  }

  .newsletter-consent {
    color: rgba(253, 252, 248, 0.5);
    line-height: 1.4;
  }
</style>
