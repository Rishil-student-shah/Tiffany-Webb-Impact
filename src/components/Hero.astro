---
import Button from './Button.astro';
import Eyebrow from './Eyebrow.astro';
import Waveform from './Waveform.astro';
---

<section class="hero theme-dark">
  <div class="hero-waveform fade-in-delay">
    <Waveform opacity={0.06} />
  </div>
  
  <div class="hero-container">
    <div class="hero-content">
      <div class="hero-eyebrow-wrap">
        <span class="hero-eyebrow">COMMUNITY IMPACT STRATEGIST · PUBLIC HEALTH EDUCATOR & SPEAKER</span>
      </div>
      
      <h1 class="hero-title">
        <span class="hero-title-line">Break the</span>
        <span class="hero-title-line italic-accent">Silence.</span>
      </h1>
      
      <div class="hero-meta">
        <span>TIFFANY WEBB, BBA, MHP</span>
      </div>
      
      <p class="hero-subtext">
        Fifteen years turning the hardest conversations about gambling harm into prevention communities can actually use.
      </p>
      
      <div class="hero-ctas">
        <Button href="/book" variant="primary" className="magnetic-btn">Book Tiffany</Button>
        <Button href="/about" variant="secondary" className="magnetic-btn">WATCH THE REEL</Button>
      </div>

      <p class="hero-formats-list text-micro" style="margin-top: 24px; color: var(--color-gold); opacity: 0.8;">
        Keynotes · Conference sessions · Panels · Workshops · School programs
      </p>


    </div>
    
    <div class="hero-media">
      <div class="hero-glass-frame">
        <div class="hero-image-mask parallax-wrap">
          <img src="/tiffany_hero_new.jpg" alt="Tiffany Webb speaking on stage" class="hero-image parallax-img" data-speed="0.1" />
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // GSAP Timeline for Hero Entrance
    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });
    
    tl.fromTo(".hero-title-line", 
      { y: 100, opacity: 0, rotation: 2 },
      { y: 0, opacity: 1, rotation: 0, duration: 1.2, stagger: 0.2 }
    )
    .fromTo(".hero-eyebrow-wrap", 
      { opacity: 0, x: -20 },
      { opacity: 1, x: 0, duration: 0.8 },
      "-=0.8"
    )
    .fromTo(".hero-meta", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8 },
      "-=0.6"
    )
    .fromTo(".hero-subtext", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8 },
      "-=0.6"
    )
    .fromTo(".hero-ctas .magnetic-btn", 
      { opacity: 0, scale: 0.9 },
      { opacity: 1, scale: 1, duration: 0.6, stagger: 0.1 },
      "-=0.4"
    )

    .fromTo(".hero-glass-frame", 
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 1.5, ease: "power3.out" },
      0
    )
    .fromTo(".hero-image-mask", 
      { clipPath: "inset(100% 0 0 0)" },
      { clipPath: "inset(0% 0 0 0)", duration: 1.5, ease: "power3.inOut" },
      0
    )
    .fromTo(".hero-image", 
      { scale: 1.2 },
      { scale: 1.05, duration: 2, ease: "power2.out" },
      0
    );


    // Parallax Effect
    gsap.to(".parallax-img", {
      yPercent: 15,
      ease: "none",
      scrollTrigger: {
        trigger: ".hero",
        start: "top top",
        end: "bottom top",
        scrub: true
      }
    });

    // Magnetic Button Effect
    const magneticBtns = document.querySelectorAll('.magnetic-btn');
    magneticBtns.forEach(btn => {
      btn.addEventListener('mousemove', (e) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        
        gsap.to(btn, {
          x: x * 0.3,
          y: y * 0.3,
          duration: 0.4,
          ease: "power2.out"
        });
      });
      
      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, {
          x: 0,
          y: 0,
          duration: 0.7,
          ease: "elastic.out(1, 0.3)"
        });
      });
    });
  });
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--glow-gradient);
    padding-top: 110px; /* Reduced from 160px to move text up */
  }

  .hero-waveform {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .hero-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: var(--sp-12) var(--sp-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
    position: relative;
    z-index: 2;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: 6fr 4fr; /* 60/40 split */
      align-items: center;
      min-height: calc(100vh - 80px);
    }
  }

  .hero-content {
    max-width: 720px;
    padding-left: var(--sp-4);
  }

  @media (min-width: 1024px) {
    .hero-content {
      padding-left: 5vw; /* Push inward from the left */
      margin-top: 40px;  /* Push down a bit more */
    }
  }

  .hero-eyebrow-wrap {
    overflow: hidden;
    margin-bottom: var(--sp-6);
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--color-gold);
    display: inline-block;
  }

  .hero-title {
    margin-bottom: var(--sp-2);
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 8vw, 6.5rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    color: var(--color-ivory);
    display: flex;
    flex-direction: column;
  }

  .hero-title-line {
    display: block;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0% 100%);
  }

  .hero-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-4);
    color: #e7e0cf;
    margin-bottom: var(--sp-8);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero-meta .highlight {
    color: var(--color-gold);
    font-weight: 600;
  }

  .hero-subtext {
    font-size: 1.125rem;
    color: #e7e0cf;
    margin-bottom: var(--sp-8);
    max-width: 600px;
    font-weight: 400;
    line-height: 1.66;
  }
  
  .hero-subtext b {
    color: var(--color-ivory);
    font-weight: 600;
  }

  .hero-ctas {
    display: flex;
    gap: var(--sp-4);
    flex-wrap: wrap;
    margin-bottom: var(--sp-12);
  }



  .hero-media {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    perspective: 1000px;
  }

  /* Glow behind image */
  .hero-media::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at center, rgba(14, 107, 84, 0.35) 0%, transparent 70%);
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-glass-frame {
    padding: 14px;
    background: rgba(20, 18, 14, 0.45);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 999px 999px 16px 16px; /* Elegant Cathedral Arch */
    box-shadow: 
      0 30px 60px rgba(0,0,0,0.5), 
      inset 0 1px 1px rgba(255,255,255,0.2),
      inset 0 -1px 1px rgba(0,0,0,0.5);
    position: relative;
    /* Gentle floating animation for uniqueness */
    animation: heroFloat 8s ease-in-out infinite;
    transform-style: preserve-3d;
    transform: translateZ(0);
    backface-visibility: hidden;
    will-change: transform, backdrop-filter;
  }

  @keyframes heroFloat {
    0% { transform: translateY(0px) rotateX(0deg); }
    50% { transform: translateY(-12px) rotateX(2deg); }
    100% { transform: translateY(0px) rotateX(0deg); }
  }

  .hero-image-mask {
    width: 100%;
    max-width: 440px;
    aspect-ratio: 4 / 5;
    border-radius: 999px 999px 12px 12px; /* Matches outer arch perfectly */
    overflow: hidden;
    position: relative;
    border: 1px solid var(--color-gold);
    clip-path: inset(100% 0 0 0); /* for GSAP */
  }

  .hero-image {
    width: 100%;
    height: 120%; /* Extra height for parallax */
    object-fit: cover;
    transform: scale(1.15); /* for GSAP */
  }
</style>
