---
import Button from './Button.astro';
import Waveform from './Waveform.astro';

const { content = {} } = Astro.props;

// Fallbacks if DB is empty
const eyebrow = content.eyebrow ?? "COMMUNITY IMPACT STRATEGIST · SPEAKER";
const rawHeadline = content.headline || (content.title_line_1 ? `${content.title_line_1} <span class="italic-accent">${content.title_line_2 || ''}</span>` : 'Bold ideas.<br/>Human connection.<br/><span class="italic-accent">Meaningful impact.</span>');
const headline = rawHeadline;
const metaText = content.meta ?? "TIFFANY WEBB";
const subtext = content.subtitle || content.subtext || "Tiffany Webb helps healthcare and community leaders think bigger about impact. She brings lived understanding, professional expertise, and community insight together to challenge convention, reimagine what's possible, and build bold strategies that help organizations—and the people, families, and communities they serve—thrive.";
const formats = content.formats ?? "SPEAKING · STRATEGY · PUBLIC & BEHAVIORAL HEALTH · COMMUNITY ENGAGEMENT · PROGRAM DEVELOPMENT";
const frameStyle = content.hero_frame_style || 'shape-hero-arch';

const showReel = content.show_reel_btn !== "0" && content.show_reel_btn !== 0 && content.show_reel_btn !== false && content.show_reel_btn !== "false";
---

<section class="hero theme-dark">
  <div class="hero-waveform fade-in-delay">
    <Waveform opacity={0.06} color="var(--color-gold)" />
  </div>
  
  <div class="hero-container">
    <div class="hero-content">
      {eyebrow && (<div class="hero-eyebrow-wrap"><span class="hero-eyebrow" set:html={eyebrow}></span></div>)}
      
      <h1 class="hero-title" set:html={headline}></h1>
      
      <div class="hero-meta">
        <span set:html={metaText}></span>
      </div>
      
      <p class="hero-subtext" set:html={subtext}></p>
      
      <div class="hero-ctas">
        <Button href="/work-with-tiffany" variant="primary" className="magnetic-btn">WORK WITH TIFFANY</Button>
        {showReel && (
          <Button href="#video-reels" variant="secondary" className="magnetic-btn">WATCH THE REEL</Button>
        )}
      </div>

      <div class="hero-capability-strip" set:html={formats}></div>
    </div>
    
    <div class="hero-media">
      <div class={`hero-glass-frame ${frameStyle}`}>
        <div class={`hero-image-mask parallax-wrap ${frameStyle}`}>
          <img src={content.hero_image || "/uploads/tiffany_hero_composite.jpg"} alt="Tiffany Webb" class="hero-image parallax-img" data-speed="0.15" />
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // GSAP Timeline for Hero Entrance
    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });
    
    tl.fromTo(".hero-title span", 
      { y: 60, opacity: 0, rotation: 2 },
      { y: 0, opacity: 1, rotation: 0, duration: 1.2, stagger: 0.1 }
    )
    .fromTo(".hero-eyebrow-wrap", 
      { opacity: 0, x: -20 },
      { opacity: 1, x: 0, duration: 0.8 },
      "-=0.8"
    )
    .fromTo(".hero-meta", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8 },
      "-=0.6"
    )
    .fromTo(".hero-subtext", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8 },
      "-=0.6"
    )
    .fromTo(".hero-ctas .magnetic-btn", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8, stagger: 0.15 },
      "-=0.6"
    )
    .fromTo(".hero-media", 
      { opacity: 0, scale: 0.95 },
      { opacity: 1, scale: 1, duration: 1.4, ease: "power3.out" },
      "-=1.2"
    );

    // Parallax logic for Hero Media
    const parallaxWrap = document.querySelector('.parallax-wrap');
    const parallaxImg = document.querySelector('.parallax-img');
    
    if (parallaxWrap && parallaxImg) {
      window.addEventListener('scroll', () => {
        const scrolled = window.pageYOffset;
        const speed = parseFloat(parallaxImg.getAttribute('data-speed') || '0.15');
        gsap.to(parallaxImg, {
          y: scrolled * speed,
          duration: 0.5,
          ease: "power1.out"
        });
      });
    }

    // Magnetic Button Effect
    const magneticBtns = document.querySelectorAll('.magnetic-btn');
    magneticBtns.forEach(btn => {
      btn.addEventListener('mousemove', (e) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        
        gsap.to(btn, {
          x: x * 0.2,
          y: y * 0.2,
          duration: 0.3,
          ease: "power2.out"
        });
      });

      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, {
          x: 0,
          y: 0,
          duration: 0.7,
          ease: "elastic.out(1, 0.3)"
        });
      });
    });
  });
</script>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: radial-gradient(circle at 80% 20%, rgba(200, 162, 76, 0.08) 0%, transparent 60%),
                radial-gradient(circle at 10% 80%, rgba(14, 107, 84, 0.08) 0%, transparent 60%),
                #000000;
  }

  .hero-waveform {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .hero-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: var(--sp-10) var(--sp-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    position: relative;
    z-index: 2;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: center;
      gap: 2.5rem;
      min-height: calc(100vh - 100px);
      padding: var(--sp-10) 1.5rem;
    }
  }

  .hero-content {
    max-width: 100%;
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .hero-content {
      padding-left: 0;
      margin-top: 10px;
    }
  }

  .hero-eyebrow-wrap {
    overflow: hidden;
    margin-bottom: var(--sp-6);
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold, #D9A23A) !important;
    display: inline-block;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
  }

  .hero-title {
    margin-bottom: var(--sp-4);
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 4.2vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-weight: 300;
    color: var(--color-ivory, #FBF6EA);
  }

  .hero-title :global(.italic-accent),
  .hero-title :global(.hero-title-gradient) {
    font-style: italic;
    background: linear-gradient(92deg, #D9A23A 0%, #E17356 50%, #6C2D5A 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    font-weight: 400;
    display: inline;
  }

  .hero-meta {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-gold, #D9A23A) !important;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: var(--sp-4);
    opacity: 1;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
  }

  .hero-subtext,
  .hero-description {
    font-size: clamp(1.05rem, 1.25vw, 1.18rem);
    color: var(--color-ivory, #FBF6EA) !important;
    line-height: 1.7;
    margin-bottom: var(--sp-8, 2rem);
    max-width: 540px;
    opacity: 0.95;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .hero-subtext :global(b),
  .hero-subtext :global(strong) {
    color: #ffffff;
    font-weight: 600;
  }

  .hero-ctas {
    display: flex;
    gap: var(--sp-4);
    margin-bottom: var(--sp-8);
    flex-wrap: wrap;
  }

  .hero-capability-strip {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(253, 252, 248, 0.75);
    letter-spacing: 0.12em;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    padding-top: var(--sp-4);
    margin-top: var(--sp-4);
    line-height: 1.6;
    max-width: 540px;
  }

  .hero-media {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 100%;
    min-width: 0;
  }

  .hero-glass-frame {
    position: relative;
    background: rgba(200, 162, 76, 0.05);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(200, 162, 76, 0.3);
    box-shadow: 0 30px 60px rgba(0,0,0,0.4), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    box-sizing: border-box;
  }

  .hero-glass-frame.shape-hero-arch {
    padding: 10px;
    border-radius: 200px 200px 24px 24px;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 4 / 5.2;
    margin: 0 auto;
  }

  .hero-image-mask {
    position: relative;
    overflow: hidden;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
  }

  .hero-image-mask.shape-hero-arch {
    border-radius: 190px 190px 16px 16px;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transform: scale(1.08);
  }
</style>
