---
import Button from './Button.astro';
import Waveform from './Waveform.astro';
import { Image } from 'astro:assets';

const { content = {} } = Astro.props;

// Fallbacks if DB is empty
const eyebrow = content.eyebrow ?? "COMMUNITY IMPACT STRATEGIST &middot; SPEAKER";
const title1 = content.title_line_1 ?? "Bold ideas, human connection, and";
const title2 = content.title_line_2 ?? "meaningful impact.";
const metaText = content.meta ?? "TIFFANY WEBB";
const subtext = content.subtext ?? "I help healthcare and <b>community leaders think bigger about impact.</b> I bring lived understanding, professional expertise, and community insight together to challenge convention, reimagine what's possible, and build bold strategies that help organizations&mdash;<b>and the people,</b> families, and communities they serve&mdash;thrive.";
const formats = content.formats ?? "SPEAKING &middot; STRATEGY &middot; PUBLIC &amp; BEHAVIORAL HEALTH &middot; COMMUNITY ENGAGEMENT &middot; PROGRAM DEVELOPMENT";
const frameStyle = content.hero_frame_style || 'shape-hero-arch';

const showReel = content.show_reel_btn !== "0" && content.show_reel_btn !== 0 && content.show_reel_btn !== false && content.show_reel_btn !== "false";
---

<section class="hero theme-dark">
  <div class="hero-waveform fade-in-delay">
    <Waveform opacity={0.06} color="var(--color-gold)" />
  </div>
  
  <div class="hero-container">
    <div class="hero-content">
      {eyebrow && (<div class="hero-eyebrow-wrap"><span class="hero-eyebrow" set:html={eyebrow}></span></div>)}
      
      <h1 class="hero-title">
        <span class="hero-title-cream" set:html={title1}></span>
        <span class="hero-title-gradient" set:html={title2}></span>
      </h1>
      
      <div class="hero-meta">
        <span set:html={metaText}></span>
      </div>
      
      <p class="hero-subtext" set:html={subtext}></p>
      
      <div class="hero-ctas">
        <Button href="/work-with-tiffany" variant="primary" className="magnetic-btn">WORK WITH TIFFANY</Button>
        {showReel && (
          <Button href="#video-reels" variant="secondary" className="magnetic-btn">WATCH THE REEL</Button>
        )}
      </div>

      <div class="hero-capability-strip" set:html={formats}></div>
    </div>
    
    <div class="hero-media">
      <div class={`hero-glass-frame ${frameStyle}`}>
        <div class={`hero-image-mask parallax-wrap ${frameStyle}`}>
          <img src={content.hero_image || "/uploads/tiffany_hero_composite.jpg"} alt="Tiffany Webb" class="hero-image parallax-img" data-speed="0.15" />
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    // GSAP Timeline for Hero Entrance
    const tl = gsap.timeline({ defaults: { ease: "power4.out" } });
    
    tl.fromTo(".hero-title span", 
      { y: 60, opacity: 0, rotation: 2 },
      { y: 0, opacity: 1, rotation: 0, duration: 1.2, stagger: 0.1 }
    )
    .fromTo(".hero-eyebrow-wrap", 
      { opacity: 0, x: -20 },
      { opacity: 1, x: 0, duration: 0.8 },
      "-=0.8"
    )
    .fromTo(".hero-meta", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8 },
      "-=0.6"
    )
    .fromTo(".hero-subtext", 
      { opacity: 0, y: 20 },
      { opacity: 1, y: 0, duration: 0.8 },
      "-=0.6"
    )
    .fromTo(".hero-ctas .magnetic-btn", 
      { opacity: 0, scale: 0.9 },
      { opacity: 1, scale: 1, duration: 0.6, stagger: 0.1 },
      "-=0.4"
    )
    .fromTo(".hero-capability-strip",
      { opacity: 0 },
      { opacity: 1, duration: 0.8 },
      "-=0.2"
    )
    .fromTo(".hero-glass-frame", 
      { opacity: 0, y: 40 },
      { opacity: 1, y: 0, duration: 1.5, ease: "power3.out" },
      0
    )
    .fromTo(".hero-image-mask", 
      { clipPath: "inset(100% 0 0 0)" },
      { clipPath: "inset(0% 0 0 0)", duration: 1.5, ease: "power3.inOut" },
      0
    )
    .fromTo(".hero-image", 
      { scale: 1.08 },
      { scale: 1.0, duration: 1.8, ease: "power2.out" },
      0
    );

    // Magnetic Button Effect
    const magneticBtns = document.querySelectorAll('.magnetic-btn');
    magneticBtns.forEach(btn => {
      btn.addEventListener('mousemove', (e) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        
        gsap.to(btn, {
          x: x * 0.3,
          y: y * 0.3,
          duration: 0.4,
          ease: "power2.out"
        });
      });
      
      btn.addEventListener('mouseleave', () => {
        gsap.to(btn, {
          x: 0,
          y: 0,
          duration: 0.7,
          ease: "elastic.out(1, 0.3)"
        });
      });
    });
  });
</script>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: var(--sp-6, 1.5rem);
    background-color: var(--color-ink);
  }

  .hero-waveform {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .hero-container {
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    padding: var(--sp-10) var(--sp-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    position: relative;
    z-index: 2;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: center;
      gap: 2.5rem;
      min-height: calc(100vh - 100px);
      padding: var(--sp-10) 1.5rem;
    }
  }

  .hero-content {
    max-width: 100%;
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .hero-content {
      padding-left: 0;
      margin-top: 10px;
    }
  }

  .hero-eyebrow-wrap {
    overflow: hidden;
    margin-bottom: var(--sp-6);
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-gold, #D9A23A) !important;
    display: inline-block;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.7);
  }

  .hero-title {
    margin-bottom: var(--sp-4);
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 4.2vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    font-weight: 300;
  }

  .hero-title span {
    display: inline-block;
  }

  .hero-title-cream {
    color: var(--color-ivory);
  }

  .hero-title-gradient {
    font-style: italic;
    background: linear-gradient(92deg, var(--color-mustard, #D9A23A) 0%, var(--color-coral, #E17356) 50%, var(--color-berry, #6C2D5A) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    font-weight: 400;
  }

  .hero-meta {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--color-gold, #D9A23A) !important;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: var(--sp-4);
    opacity: 1;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.7);
  }

  .hero-subtext,
  .hero-description {
    font-size: clamp(1.05rem, 1.25vw, 1.18rem);
    color: var(--color-ivory, #FBF6EA) !important;
    line-height: 1.7;
    margin-bottom: var(--sp-8, 2rem);
    max-width: 540px;
    opacity: 0.95;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .hero-subtext strong,
  .hero-description strong {
    color: #ffffff !important;
    font-weight: 600;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4, 1rem);
    margin-bottom: 2rem;
  }

  .hero-capability-strip {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-gold, #D9A23A) !important;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 1;
    line-height: 1.6;
    margin-top: 0.5rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .hero-media {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    perspective: 1000px;
    box-sizing: border-box;
    padding-right: 0.5rem;
  }

  .hero-glass-frame {
    padding: 12px;
    background: rgba(20, 18, 14, 0.45);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    border: 1px solid var(--color-gold); /* Thin gold border */
    box-shadow: 
      0 30px 60px rgba(0,0,0,0.5), 
      inset 0 1px 1px rgba(217,162,58,0.2),
      inset 0 -1px 1px rgba(0,0,0,0.5);
    position: relative;
    animation: heroFloat 8s ease-in-out infinite;
    transform-style: preserve-3d;
    transform: translateZ(0);
    backface-visibility: hidden;
    transition: all 0.5s ease;
    box-sizing: border-box;
    width: 100%;
  }

  @keyframes heroFloat {
    0% { transform: translateY(0px) rotateX(0deg); }
    50% { transform: translateY(-12px) rotateX(2deg); }
    100% { transform: translateY(0px) rotateX(0deg); }
  }

  .hero-image-mask {
    width: 100%;
    overflow: hidden;
    position: relative;
    clip-path: inset(100% 0 0 0); /* for GSAP */
    transition: all 0.5s ease;
  }

  /* 1. Cathedral Arch (Hero Default - Vertical 4:5 with Half Circle Arch Dome) */
  .hero-glass-frame.shape-hero-arch, .hero-image-mask.shape-hero-arch {
    border-radius: 999px 999px 16px 16px;
    aspect-ratio: 4 / 5;
    max-width: min(100%, 350px);
    width: 100%;
  }

  /* 2. Wide Cinema Arch (Wide 16:9 with Half Circle Arch Dome on Top - Full Width) */
  .hero-glass-frame.shape-landscape-arch, .hero-image-mask.shape-landscape-arch {
    border-radius: 220px 220px 16px 16px;
    aspect-ratio: 16 / 9;
    max-width: min(100%, 420px);
    width: 100%;
  }

  /* 3. Expansive Arch (3:2 with Half Circle Arch Dome on Top) */
  .hero-glass-frame.shape-wide-arch, .hero-image-mask.shape-wide-arch {
    border-radius: 200px 200px 16px 16px;
    aspect-ratio: 3 / 2;
    max-width: min(100%, 400px);
    width: 100%;
  }

  /* 4. Square Arch Dome (Square 1:1 with Half Circle Arch Dome on Top) */
  .hero-glass-frame.shape-square-arch, .hero-image-mask.shape-square-arch {
    border-radius: 220px 220px 16px 16px;
    aspect-ratio: 1 / 1;
    max-width: min(100%, 360px);
    width: 100%;
  }

  /* 5. Soft Editorial Arch */
  .hero-glass-frame.shape-meet-arch, .hero-image-mask.shape-meet-arch {
    border-radius: 280px 280px 16px 16px;
    aspect-ratio: 3.5 / 5;
    max-width: min(100%, 350px);
    width: 100%;
  }

  /* 6. Modern Wide Landscape (Rectangular) */
  .hero-glass-frame.shape-landscape, .hero-image-mask.shape-landscape {
    border-radius: 16px;
    aspect-ratio: 16 / 9;
    max-width: min(100%, 420px);
    width: 100%;
  }

  /* 7. Classic Portrait */
  .hero-glass-frame.shape-portrait, .hero-image-mask.shape-portrait {
    border-radius: 16px;
    aspect-ratio: 3 / 4;
    max-width: min(100%, 340px);
    width: 100%;
  }

  /* 8. Luxury Square */
  .hero-glass-frame.shape-square, .hero-image-mask.shape-square {
    border-radius: 16px;
    aspect-ratio: 1 / 1;
    max-width: min(100%, 360px);
    width: 100%;
  }

  /* 9. Adaptive / Freeform */
  .hero-glass-frame.shape-adaptive, .hero-image-mask.shape-adaptive {
    border-radius: 16px;
    aspect-ratio: auto;
    max-width: min(100%, 420px);
    width: 100%;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Single column on mobile is the default grid behavior */
  @media (max-width: 1023px) {
    .hero-media {
      margin-top: var(--sp-8); /* Put below buttons/text */
    }
  }
</style>
