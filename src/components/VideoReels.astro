---
import Eyebrow from './Eyebrow.astro';
import Waveform from './Waveform.astro';
import { Image } from 'astro:assets';

// Dynamically import all possible thumbnails from the assets directory
const allImages = import.meta.glob('../assets/*.{jpeg,jpg,png,gif,webp}', { eager: true });

const { content = {}, collections = {} } = Astro.props;

// Fallback values
const eyebrowText = content.eyebrow || "IN THE ROOM";
let titleHtml = content.headline || "Watch Tiffany <span class=\"italic-accent\">in action.</span>";
if (titleHtml && !titleHtml.includes('<span') && titleHtml.includes('action')) {
  titleHtml = titleHtml.replace('in action.', '<span class="italic-accent">in action.</span>').replace('in action', '<span class="italic-accent">in action.</span>');
}
const description = content.description || "See how she commands the room, breaks down complex topics, and connects with audiences of all sizes. From intimate workshops to national keynotes, the message remains clear and the impact remains real.";

// Process collections to resolve image paths
let videos = [];
if (collections.video_reels && Array.isArray(collections.video_reels)) {
  videos = collections.video_reels;
} else {
  // Fallbacks if no DB content is found
  videos = [
    { title: 'National Problem Gambling Conference', subtitle: 'Keynote Address', badge: 'KEYNOTE', image_url: 'thumb_1', link_url: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ' },
    { title: 'Youth Prevention Summit', subtitle: 'Student Workshop', badge: 'WORKSHOP', image_url: 'thumb_2', link_url: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ' },
    { title: 'Behavioral Health Alliance', subtitle: 'Professional Training', badge: 'TRAINING', image_url: 'thumb_3', link_url: 'https://www.youtube.com/watch?v=dQw4w9WgXcQ' }
  ];
}

// Map the DB image_url (e.g. 'thumb_1', 'thumb_1.jpg', or '/uploads/...') to an image
const resolveImage = (imgName) => {
  if (!imgName) return null;
  if (imgName.startsWith('/uploads/') || imgName.startsWith('http://') || imgName.startsWith('https://')) {
    return imgName;
  }
  // Make sure it has an extension for the glob match if it doesn't already
  const cleanName = imgName.includes('.') ? imgName : `${imgName}.jpg`;
  
  // Find the exact match in the eagerly imported glob
  const assetKey = Object.keys(allImages).find(path => path.endsWith(cleanName));
  
  if (assetKey) {
    return allImages[assetKey].default;
  }
  
  return imgName;
};
---

<section class="section-pad theme-ink relative overflow-hidden" id="video-reels" style="padding-top: 8rem; padding-bottom: 8rem;">
  <Waveform opacity={0.04} variant="B" flipY={true} />
  
  <div class="relative z-10" style="width: 90%; max-width: 1200px; margin: 0 auto;">
    <div class="reveal-up text-center" style="margin: 0 auto 5rem auto; max-width: 800px; text-align: center; display: flex; flex-direction: column; align-items: center;">
      <div style="margin-bottom: 1rem; width: 100%; text-align: center;"><Eyebrow className="justify-center text-center">{eyebrowText}</Eyebrow></div>
      <h2 class="section-title works-title" style="margin-bottom: 2rem; font-size: clamp(2.5rem, 4vw, 4rem); color: var(--color-ivory); text-align: center;" set:html={titleHtml}></h2>
      <p class="subtitle" style="text-align: center; margin: 0 auto; line-height: 1.6; font-size: 1.1rem; color: rgba(251, 246, 234, 0.85);">{description}</p>
    </div>
    
    <div class="videos-grid stagger-group">
      {videos.map((vid) => {
        const imgSrc = resolveImage(vid.image_url);
        return (
          <div 
            class="video-card ultra-glass-card glass-obsidian stagger-item" 
            data-video-src={vid.link_url || vid.video_url || ''} 
            data-video-title={vid.title || ''}
          >
            <div class="video-thumbnail-wrap">
              {typeof imgSrc === 'object' && imgSrc !== null ? (
                <Image src={imgSrc} alt={vid.title} class="video-thumbnail" />
              ) : (
                <img src={imgSrc || '/uploads/thumb_default.jpg'} alt={vid.title} class="video-thumbnail" />
              )}
              <span class="video-duration-badge">{vid.badge || 'REEL'}</span>
              <div class="video-overlay"></div>
              <button class="spk-play-btn" type="button" aria-label={`Watch ${vid.title}`}>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="spk-play-icon">
                  <path d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347c-.75.412-1.667-.13-1.667-.986V5.653Z" />
                </svg>
              </button>
            </div>
            <div class="video-info">
              {vid.subtitle && <p class="video-subtitle">{vid.subtitle}</p>}
              {vid.title && <h3 class="video-title">{vid.title}</h3>}
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Cinematic Lightbox Modal -->
  <div id="video-lightbox" class="video-lightbox-modal hidden" aria-hidden="true">
    <div class="lightbox-backdrop"></div>
    <div class="lightbox-dialog">
      <button class="lightbox-close-btn" type="button" aria-label="Close Video">&times;</button>
      <div class="lightbox-player-container" id="player-container">
        <!-- Injected dynamically via JS: <video> or <iframe> -->
      </div>
      <h4 id="lightbox-video-title" class="lightbox-title"></h4>
    </div>
  </div>
</section>

<script>
  function initVideoLightbox() {
    const modal = document.getElementById('video-lightbox');
    const container = document.getElementById('player-container');
    const titleEl = document.getElementById('lightbox-video-title');
    const closeBtn = document.querySelector('.lightbox-close-btn');
    const backdrop = document.querySelector('.lightbox-backdrop');

    if (!modal || !container) return;

    function getYouTubeId(url) {
      try {
        const parsed = new URL(url, window.location.origin);
        if (parsed.hostname.includes('youtu.be')) {
          return parsed.pathname.slice(1).split('/')[0].split('?')[0];
        }
        if (parsed.pathname.includes('/embed/')) {
          return parsed.pathname.split('/embed/')[1].split('/')[0].split('?')[0];
        }
        if (parsed.pathname.includes('/shorts/')) {
          return parsed.pathname.split('/shorts/')[1].split('/')[0].split('?')[0];
        }
        return parsed.searchParams.get('v');
      } catch (e) {
        const match = url.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);
        return match ? match[1] : null;
      }
    }

    function getVimeoId(url) {
      try {
        const match = url.match(/vimeo\.com\/(?:video\/)?([0-9]+)/);
        return match ? match[1] : url.split('/').pop().split('?')[0];
      } catch (e) {
        return null;
      }
    }

    function openVideo(src, title) {
      if (!src) return;
      if (titleEl) titleEl.innerText = title || '';
      container.innerHTML = '';
      
      if (src.includes('youtube.com') || src.includes('youtu.be')) {
        const id = getYouTubeId(src);
        if (id) {
          container.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1&modestbranding=1&rel=0" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen class="video-frame"></iframe>`;
        } else {
          container.innerHTML = `<iframe src="${src}" frameborder="0" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen class="video-frame"></iframe>`;
        }
      } else if (src.includes('vimeo.com')) {
        const id = getVimeoId(src);
        if (id) {
          container.innerHTML = `<iframe src="https://player.vimeo.com/video/${id}?autoplay=1" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen class="video-frame"></iframe>`;
        } else {
          container.innerHTML = `<iframe src="${src}" frameborder="0" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen class="video-frame"></iframe>`;
        }
      } else {
        // Direct MP4 / WebM / Mov
        container.innerHTML = `<video src="${src}" controls autoplay playsinline class="video-player-el"></video>`;
      }
      modal.classList.remove('hidden');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeVideo() {
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      container.innerHTML = '';
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.video-card').forEach(card => {
      card.addEventListener('click', (e) => {
        const src = card.getAttribute('data-video-src');
        const title = card.getAttribute('data-video-title');
        if (src) {
          e.preventDefault();
          openVideo(src, title);
        }
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeVideo();
      });
    }

    if (backdrop) {
      backdrop.addEventListener('click', (e) => {
        e.stopPropagation();
        closeVideo();
      });
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        closeVideo();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initVideoLightbox);
  } else {
    initVideoLightbox();
  }
  document.addEventListener('astro:page-load', initVideoLightbox);
</script>

<style>
  .title-grad {
    background: linear-gradient(92deg, var(--color-mustard), var(--color-coral), var(--color-berry));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .videos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    width: 100%;
  }
  @media (min-width: 768px) {
    .videos-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2.5rem;
    }
  }
  @media (min-width: 1024px) {
    .videos-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 3rem;
    }
  }

  .video-card {
    border-radius: 16px;
    overflow: hidden;
    padding: 0;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease, border-color 0.4s ease;
    border: 1px solid rgba(255, 255, 255, 0.05);
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }
  .video-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5), 0 0 30px rgba(217, 162, 58, 0.1);
    border-color: rgba(217, 162, 58, 0.3);
  }

  .video-thumbnail-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    overflow: hidden;
    background: #000;
  }

  .video-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .video-duration-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: rgba(10, 10, 10, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #D9A23A;
    border: 1px solid rgba(217, 162, 58, 0.35);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 2;
  }

  .video-placeholder {
    width: 100%;
    height: 100%;
    background: #111;
  }

  .video-card:hover .video-thumbnail {
    transform: scale(1.05);
  }

  .video-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.2);
    z-index: 1;
    transition: background 0.4s ease;
  }
  .video-card:hover .video-overlay {
    background: rgba(0, 0, 0, 0.0);
  }

  .spk-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(217, 162, 58, 0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  }
  .video-card:hover .spk-play-btn {
    transform: translate(-50%, -50%) scale(1.15);
    background: var(--color-gold);
  }

  .spk-play-icon {
    width: 28px;
    height: 28px;
    color: var(--ink);
    margin-left: 4px; /* optical center */
  }

  .video-info {
    padding: 1.5rem;
    flex-grow: 1;
  }
  .video-subtitle {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    margin-bottom: 0.5rem;
    opacity: 0.9;
  }
  .video-title {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    color: var(--color-ivory);
    margin: 0;
    line-height: 1.3;
  }

  /* Cinematic Lightbox Modal */
  .video-lightbox-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .video-lightbox-modal.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 5, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    cursor: pointer;
  }

  .lightbox-dialog {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 960px;
    background: #0d0d0f;
    border: 1px solid rgba(217, 162, 58, 0.3);
    border-radius: 20px;
    padding: 1.25rem;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8), 0 0 40px rgba(217, 162, 58, 0.15);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transform: scale(1);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .video-lightbox-modal.hidden .lightbox-dialog {
    transform: scale(0.95);
  }

  .lightbox-close-btn {
    position: absolute;
    top: -1rem;
    right: -1rem;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #1a1a1e;
    border: 1px solid rgba(217, 162, 58, 0.5);
    color: #FBF6EA;
    font-size: 1.8rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 20;
    transition: all 0.2s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
  }

  .lightbox-close-btn:hover {
    background: #D9A23A;
    color: #0d0d0f;
    transform: rotate(90deg) scale(1.1);
  }

  .lightbox-player-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16/9;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }

  .lightbox-player-container iframe.video-frame,
  .lightbox-player-container video.video-player-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
    object-fit: contain;
  }

  .lightbox-title {
    font-family: var(--font-serif, Georgia, serif);
    font-size: 1.25rem;
    color: #FBF6EA;
    margin: 0;
    padding: 0 0.25rem;
    line-height: 1.4;
  }
</style>
