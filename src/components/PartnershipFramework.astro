---
import Eyebrow from './Eyebrow.astro';
import Waveform from './Waveform.astro';
import Button from './Button.astro';

const { 
  eyebrow = "COLLABORATIVE PARTNERSHIP",
  headline = 'More Than a Speaker. <span class="italic-accent">A Collaborative Partner.</span>',
  subtitle = "From one conversation to long-term strategy, Tiffany works alongside organizations to create stronger prevention, engagement, and community impact.",
  collections = {}
} = Astro.props;

const fallbackPillars = [
  {
    num: "01 // SPEAK",
    action: "Engage & Educate",
    desc: "Keynotes, Conference Sessions, Workshops, Panels, and Expert Moderation that inspire action and break down stigma.",
    items: ["Keynotes & Plenaries", "Conference Sessions", "Interactive Workshops", "Panel Participation", "Discussion Moderation"],
    color: "#0E6B54"
  },
  {
    num: "02 // PARTNER",
    action: "Connect & Activate",
    desc: "Resource tables, community health & resource fairs, ROSC coalition engagement, and grassroots activation.",
    items: ["Resource Tables & Fairs", "Health & Wellness Expos", "ROSC Coalition Activation", "Community Listening Sessions", "Multicultural Outreach"],
    color: "#D9A23A"
  },
  {
    num: "03 // STRATEGIZE",
    action: "Plan & Build",
    desc: "Strategic planning, community engagement strategy, prevention program architecture, and multi-agency alignment.",
    items: ["Strategic Advisory", "Community Engagement Plans", "Program Architecture", "Screening Workflow Design", "Coalition Alignment"],
    color: "#C15427"
  },
  {
    num: "04 // STRENGTHEN",
    action: "Build Capacity & Sustainability",
    desc: "Staff development, technical assistance, capacity building, and long-term organizational sustainability.",
    items: ["Staff & Clinician Training", "Technical Assistance", "Capacity Building", "Curriculum Development", "Evaluation & Measurement"],
    color: "#6C2D5A"
  }
];

const colors = ["#0E6B54", "#D9A23A", "#C15427", "#6C2D5A"];

const pillars = (collections.partnership_framework && collections.partnership_framework.length > 0)
  ? collections.partnership_framework.map((c, idx) => ({
      num: c.badge || ("0" + (c.sort_order || idx + 1) + " // " + c.title),
      action: c.subtitle || "Collaborative Action",
      desc: c.content_html || c.description || c.content_value || "",
      items: (c.content_html || "").split(',').map(s => s.replace(/<[^>]*>?/gm, '').trim()).filter(Boolean),
      color: colors[idx % colors.length]
    }))
  : fallbackPillars;
---

<section class="partnership-framework-section theme-ink relative overflow-hidden" id="partnership-framework">
  <Waveform opacity={0.03} variant="B" flipY={true} />
  
  <div class="container relative z-10" style="max-width: 1240px; margin: 0 auto; padding: 0 1.5rem;">
    
    <!-- Section Header -->
    <div class="pf-header reveal-up text-center">
      {eyebrow && <Eyebrow className="justify-center">{eyebrow}</Eyebrow>}
      {headline && <h2 class="section-title" set:html={headline}></h2>}
      {subtitle && <p class="pf-subtitle">{subtitle}</p>}
    </div>

    <!-- 4 Pillars Grid -->
    <div class="pf-grid stagger-group mt-12">
      {pillars.map((pillar) => (
        <div class="pf-card ultra-glass-card stagger-item">
          <div class="pf-card-inner">
            
            <div class="pf-top">
              <span class="pf-num" style={`color: ${pillar.color};`}>{pillar.num}</span>
              <span class="pf-action">{pillar.action}</span>
            </div>

            <div class="pf-body">
              <p class="pf-desc">{pillar.desc}</p>
              
              {pillar.items && pillar.items.length > 0 && (
                <div class="pf-items-list">
                  <span class="pf-items-label">INCLUDES:</span>
                  <ul class="pf-tags">
                    {pillar.items.map((item) => (
                      <li class="pf-tag-pill">{item}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>

          </div>
        </div>
      ))}
    </div>

    <!-- Bottom CTA Action -->
    <div class="pf-bottom-cta reveal-up mt-14 text-center">
      <p class="pf-cta-lead mb-6">Looking for a strategic partner who understands both the system and the community?</p>
      <Button href="/work-with-tiffany" variant="primary" className="magnetic-btn">
        DISCUSS A COLLABORATIVE PARTNERSHIP &rarr;
      </Button>
    </div>

  </div>
</section>

<style>
  .partnership-framework-section {
    padding: 7rem 0;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: radial-gradient(circle at 50% 100%, rgba(217, 162, 58, 0.06) 0%, rgba(13, 12, 8, 1) 75%);
  }

  .pf-header {
    max-width: 820px;
    margin: 0 auto 3.5rem auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .pf-subtitle {
    font-size: 1.15rem;
    color: rgba(251, 246, 234, 0.85);
    line-height: 1.65;
    margin-top: 1rem;
  }

  .pf-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .pf-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .pf-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .pf-card {
    background: rgba(20, 18, 14, 0.75);
    border: 1px solid rgba(217, 162, 58, 0.22);
    border-radius: 20px;
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pf-card:hover {
    transform: translateY(-4px);
    border-color: rgba(217, 162, 58, 0.5);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.5), 0 0 25px rgba(217, 162, 58, 0.12);
  }

  .pf-card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pf-top {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 1rem;
  }

  .pf-num {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pf-action {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-ivory, #FBF6EA);
    font-weight: 500;
    line-height: 1.25;
  }

  .pf-desc {
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(251, 246, 234, 0.82);
    margin: 0 0 1.5rem 0;
  }

  .pf-items-list {
    margin-top: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1rem;
  }

  .pf-items-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(251, 246, 234, 0.5);
    margin-bottom: 0.6rem;
  }

  .pf-tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .pf-tag-pill {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(251, 246, 234, 0.75);
    background: rgba(255, 255, 255, 0.03);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .pf-cta-lead {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-ivory, #FBF6EA);
    font-style: italic;
  }
</style>
