---
import Waveform from './Waveform.astro';

const { collections = {} } = Astro.props;
let items = collections.credibility_bar || [];

// Filter out TBC and cap at 4 items
items = items.filter(item => item.title && item.title.toUpperCase() !== 'TBC').slice(0, 4);
---

{items.length > 0 && (
<section class="credibility-bar theme-ink reveal-up" aria-label="Key Figures">
  <Waveform opacity={0.04} flipX={true} />
  <div class="credibility-container">
    {items.map((item, index) => (
      <>
        <div class="credibility-item">
          <span class="credibility-stat">{item.title}</span>
          <span class="credibility-label">{item.subtitle}</span>
        </div>
        
        {index < items.length - 1 && (
          <div class="credibility-divider"></div>
        )}
      </>
    ))}
  </div>
</section>
)}

<style>
  .credibility-bar {
    position: relative;
    padding: var(--sp-12) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .credibility-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-8);
  }

  @media (min-width: 768px) {
    .credibility-container {
      flex-direction: row;
      justify-content: center;
      gap: 0;
    }
  }

  .credibility-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 4vw; /* Responsive spacing */
  }

  .credibility-stat {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 6vw, 4.5rem); /* Large serif numeral */
    line-height: 1;
    margin-bottom: var(--sp-3);
    color: var(--color-ivory); 
  }

  .credibility-label {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-gold); /* small-caps gold label */
  }

  .credibility-divider {
    width: 60px;
    height: 1px;
    background-color: var(--color-gold);
    opacity: 0.25;
  }

  @media (min-width: 768px) {
    .credibility-divider {
      width: 1px;
      height: 80px;
      align-self: center;
    }
  }
</style>
