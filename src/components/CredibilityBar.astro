---
import Waveform from './Waveform.astro';

const { collections = {} } = Astro.props;

const fallbackItems = [
  { title: "15+", subtitle: "YEARS OF EXPERIENCE" },
  { title: "50+", subtitle: "WORKSHOPS · PRESENTATIONS · ACTIVATIONS" },
  { title: "100+", subtitle: "COMMUNITY PARTNERS & COLLABORATIONS" }
];

let items = (collections.credibility_bar && collections.credibility_bar.length > 0)
  ? collections.credibility_bar.filter(item => item.title && item.title.toUpperCase() !== 'TBC').slice(0, 3)
  : fallbackItems;
---

<section class="credibility-bar theme-ink reveal-up" aria-label="Key Figures">
  <Waveform opacity={0.04} flipX={true} />
  <div class="credibility-container">
    {items.map((item, index) => (
      <>
        <div class="credibility-item">
          <span class="credibility-stat">{item.title}</span>
          <span class="credibility-label">{item.subtitle}</span>
        </div>
        
        {index < items.length - 1 && (
          <div class="credibility-divider"></div>
        )}
      </>
    ))}
  </div>
</section>

<style>
  .credibility-bar {
    position: relative;
    padding: 5rem 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .credibility-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-8);
  }

  @media (min-width: 768px) {
    .credibility-container {
      flex-direction: row;
      justify-content: center;
      gap: 0;
    }
  }

  .credibility-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 3vw;
    flex: 1;
  }

  .credibility-stat {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 5vw, 4rem);
    line-height: 1.05;
    margin-bottom: 0.6rem;
    color: var(--color-ivory, #FBF6EA);
    font-weight: 300;
  }

  .credibility-label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #D9A23A;
    line-height: 1.4;
    max-width: 280px;
  }

  .credibility-divider {
    width: 60px;
    height: 1px;
    background-color: var(--color-gold);
    opacity: 0.25;
  }

  @media (min-width: 768px) {
    .credibility-divider {
      width: 1px;
      height: 70px;
      align-self: center;
    }
  }
</style>
