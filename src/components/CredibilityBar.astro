---
import Waveform from './Waveform.astro';

const { collections = {} } = Astro.props;
let items = collections.credibility_bar || [];

if (items.length === 0) {
  // Fallbacks if db is empty
  items = [
    { title: "15+", subtitle: "Years" },
    { title: "4,000+", subtitle: "Hours of Outreach" },
    { title: "20", subtitle: "Speaking Topics" }
  ];
}

// Cap at 6 items
items = items.slice(0, 6);
---

<section class="credibility-bar theme-ink reveal-up">
  <Waveform opacity={0.04} flipX={true} />
  <div class="credibility-container">
    {items.map((item, index) => (
      <>
        <div class="credibility-item">
          <span class="credibility-stat">{item.title}</span>
          <span class="text-micro credibility-label">{item.subtitle}</span>
        </div>
        
        {index < items.length - 1 && (
          <div class="credibility-divider"></div>
        )}
      </>
    ))}
  </div>
</section>

<style>
  .credibility-bar {
    color: var(--color-gold);
    padding: var(--sp-8) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .credibility-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-6);
  }

  @media (min-width: 768px) {
    .credibility-container {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
      column-gap: 4rem;
      row-gap: 3rem;
    }
  }

  .credibility-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .credibility-stat {
    font-family: var(--font-serif);
    font-size: var(--text-h2);
    line-height: 1;
    margin-bottom: var(--sp-2);
  }

  .credibility-divider {
    width: 40px;
    height: 1px;
    background-color: var(--color-gold);
    opacity: 0.3;
  }

  @media (min-width: 768px) {
    .credibility-divider {
      width: 1px;
      height: 60px;
      align-self: center;
    }
    
    /* Hide dividers that wrap to a new line to keep it clean */
    .credibility-divider:nth-of-type(3n) {
      display: none;
    }
  }
</style>
