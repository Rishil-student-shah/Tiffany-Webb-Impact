---
import Eyebrow from './Eyebrow.astro';
import Waveform from './Waveform.astro';

const { content = {}, collections = {} } = Astro.props;

const fallbackTestimonials = [
  {
    title: "Director of Clinical Services",
    subtitle: "Midwest Behavioral Health Network",
    content_html: "Tiffany brought an unprecedented level of clarity, compassion, and practical rigor to our annual conference. Our clinical team walked away with screening protocols they implemented the very next morning."
  },
  {
    title: "ROSC Council Coordinator",
    subtitle: "Community Prevention Coalition",
    content_html: "Working with Tiffany transformed how our coalition approaches youth digital gaming and problem gambling prevention. Her ability to authentically connect with diverse community leaders is unmatched."
  },
  {
    title: "Executive Director",
    subtitle: "Public Health Advocacy Initiative",
    content_html: "More than just an inspiring keynote speaker — Tiffany is a true strategic partner who helped us structure community outreach programs designed for sustainable, long-term impact."
  }
];

const testimonials = (collections.proof_testimonials && collections.proof_testimonials.length > 0)
  ? collections.proof_testimonials
  : fallbackTestimonials;

const qualities = [
  "Engaging",
  "Practical",
  "Collaborative",
  "Community-centered",
  "Relationship builder",
  "Mission-focused"
];

const eyebrow = content.eyebrow ?? "TESTIMONIALS & FEEDBACK";
let rawHeadline = content.headline || "Words from the room.";
let headline = rawHeadline.includes('<span') 
  ? rawHeadline 
  : rawHeadline.replace(/from the room\.?/i, '<span class="italic-accent">from the room.</span>');
const description = content.description ?? "What conference organizers, coalition leaders, and clinical directors say about working with Tiffany.";
---

<section id="proof-testimonials" class="proof-testimonials-section section-pad theme-ink relative overflow-hidden">
  <Waveform opacity={0.04} variant="B" flipY={true} />
  
  <div class="relative z-10" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
    
    <!-- Header -->
    <div class="reveal-up text-center" style="margin-bottom: 3.5rem; max-width: 800px; margin-left: auto; margin-right: auto;">
      <Eyebrow className="justify-center">{eyebrow}</Eyebrow>
      <h2 class="section-title mt-4" style="color: var(--color-ivory);" set:html={headline}></h2>
      {description && <p class="testimonials-sub mt-4">{description}</p>}
    </div>

    <!-- 6 Core Qualities Band -->
    <div class="qualities-band reveal-up mb-12">
      {qualities.map((quality) => (
        <div class="quality-chip">
          <span class="quality-dot"></span>
          <span>{quality}</span>
        </div>
      ))}
    </div>

    <!-- Cinematic Testimonials Slider -->
    <div class="testimonials-block reveal-up">
      <div class="cinematic-slider">
        <div class="slider-viewport">
          {testimonials.map((test, index) => (
            <div class={`slider-slide ${index === 0 ? 'active' : ''}`}>
              <div class="slide-content">
                <svg class="giant-quote" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                </svg>
                <p class="slide-quote">"{test.content_html || test.subtitle}"</p>
                <div class="slide-author">
                  <span class="author-name">{test.title}</span>
                  {test.subtitle && (
                    <span class="author-role">{test.subtitle}</span>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
        
        {testimonials.length > 1 && (
          <div class="slider-controls">
            <button class="slider-btn prev-btn" aria-label="Previous quote">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
              </svg>
            </button>
            <div class="slider-progress">
              <div class="progress-bar"></div>
            </div>
            <button class="slider-btn next-btn" aria-label="Next quote">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </div>
        )}
      </div>
    </div>

  </div>
</section>

{testimonials.length > 1 && (
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.slider-slide');
    const nextBtn = document.querySelector('.next-btn');
    const prevBtn = document.querySelector('.prev-btn');
    const progressBar = document.querySelector('.progress-bar');
    
    if(!slides.length || !nextBtn || !prevBtn) return;

    let currentIndex = 0;
    const totalSlides = slides.length;

    function updateSlider(newIndex) {
      if(newIndex === currentIndex) return;
      
      slides[currentIndex].classList.remove('active');
      slides[newIndex].classList.add('active');
      
      currentIndex = newIndex;
      updateProgress();
    }
    
    function updateProgress() {
      const percentage = ((currentIndex + 1) / totalSlides) * 100;
      if(progressBar) {
        progressBar.style.width = `${percentage}%`;
      }
    }

    function goNext() {
      const newIndex = (currentIndex + 1) % totalSlides;
      updateSlider(newIndex);
    }

    function goPrev() {
      const newIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      updateSlider(newIndex);
    }

    // Autoplay Logic
    let autoplayInterval;
    
    function startAutoplay() {
      autoplayInterval = setInterval(goNext, 6000);
    }

    function resetAutoplay() {
      clearInterval(autoplayInterval);
      startAutoplay();
    }

    nextBtn.addEventListener('click', () => {
      goNext();
      resetAutoplay();
    });

    prevBtn.addEventListener('click', () => {
      goPrev();
      resetAutoplay();
    });

    updateProgress();
    startAutoplay();
  });
</script>
)}

<style>
  .proof-testimonials-section {
    padding: 7rem 0;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .testimonials-sub {
    font-size: 1.15rem;
    color: rgba(251, 246, 234, 0.85);
    line-height: 1.6;
  }

  /* 6 Core Qualities Band */
  .qualities-band {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 3.5rem;
  }

  .quality-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(217, 162, 58, 0.08);
    border: 1px solid rgba(217, 162, 58, 0.25);
    padding: 0.45rem 0.95rem;
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold, #D9A23A);
  }

  .quality-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold, #D9A23A);
  }

  /* Slider Container */
  .cinematic-slider {
    position: relative;
    background: radial-gradient(circle at 50% 0%, rgba(217, 162, 58, 0.1) 0%, rgba(13, 12, 8, 0.9) 75%);
    border: 1px solid rgba(217, 162, 58, 0.25);
    border-radius: 24px;
    padding: 3.5rem 2.5rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    max-width: 960px;
    margin: 0 auto;
  }

  .slider-viewport {
    position: relative;
    min-height: 200px;
  }

  .slider-slide {
    display: none;
    opacity: 0;
    transition: opacity 0.5s ease-in-out;
  }

  .slider-slide.active {
    display: block;
    opacity: 1;
  }

  .slide-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .giant-quote {
    width: 44px;
    height: 44px;
    color: var(--color-gold, #D9A23A);
    opacity: 0.4;
    margin-bottom: 1.5rem;
  }

  .slide-quote {
    font-family: var(--font-serif);
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    line-height: 1.45;
    color: var(--color-ivory, #FBF6EA);
    margin: 0 0 2rem 0;
    max-width: 820px;
    font-style: italic;
  }

  .slide-author {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .author-name {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--color-gold, #D9A23A);
    font-weight: 600;
  }

  .author-role {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: rgba(251, 246, 234, 0.7);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Slider Controls */
  .slider-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  .slider-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-ivory, #FBF6EA);
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .slider-btn svg {
    width: 18px;
    height: 18px;
  }

  .slider-btn:hover {
    background: var(--color-gold, #D9A23A);
    color: #0D0C08;
    border-color: var(--color-gold, #D9A23A);
  }

  .slider-progress {
    width: 120px;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    overflow: hidden;
  }

  .progress-bar {
    height: 100%;
    background: var(--color-gold, #D9A23A);
    width: 33.33%;
    transition: width 0.3s ease;
  }
</style>
