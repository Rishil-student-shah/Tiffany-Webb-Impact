    // ---------- Searchable Country Code Picker with digit validation ----------
    function initCCPicker(btnId, dropdownId, searchId, listId, hiddenId, phoneId) {
      const btn = document.getElementById(btnId);
      const dropdown = document.getElementById(dropdownId);
      const search = document.getElementById(searchId);
      const list = document.getElementById(listId);
      const hidden = document.getElementById(hiddenId);
      const phoneInput = document.getElementById(phoneId);
      if (!btn || !dropdown) return;

      function updatePhoneValidation(country) {
        if (phoneInput && country.d) {
          const [min, max] = country.d;
          if (min === max) {
            phoneInput.pattern = `[0-9]{${min}}`;
            phoneInput.title = `Enter exactly ${min} digits for ${country.n}`;
            phoneInput.placeholder = '0'.repeat(min);
          } else {
            phoneInput.pattern = `[0-9]{${min},${max}}`;
            phoneInput.title = `Enter ${min}-${max} digits for ${country.n}`;
            phoneInput.placeholder = '0'.repeat(min);
          }
        }
      }

      // Set initial validation for US
      const usEntry = CC.find(x => x.f === 'US');
      if (usEntry) updatePhoneValidation(usEntry);

      function render(filter = '') {
        const q = filter.toLowerCase();
        list.innerHTML = '';
        CC.filter(x => x.n.toLowerCase().includes(q) || x.c.includes(q) || x.f.toLowerCase().includes(q))
          .forEach(x => {
            const li = document.createElement('li');
            const digitInfo = x.d[0] === x.d[1] ? `${x.d[0]} digits` : `${x.d[0]}-${x.d[1]} digits`;
            li.textContent = `${x.c} — ${x.n} (${digitInfo})`;
            // Inline styles because Astro scoped CSS won't apply to dynamic elements
            li.style.cssText = 'padding:0.6rem 1rem;color:rgba(255,255,255,0.9);font-size:0.85rem;cursor:pointer;transition:background 0.15s;';
            li.addEventListener('mouseenter', () => { li.style.background = 'rgba(194,149,69,0.25)'; li.style.color = '#fff'; });
            li.addEventListener('mouseleave', () => { li.style.background = 'transparent'; li.style.color = 'rgba(255,255,255,0.9)'; });
            li.addEventListener('click', () => {
              hidden.value = x.c;
              btn.textContent = `${x.c} (${x.f})`;
              dropdown.classList.remove('open');
              search.value = '';
              updatePhoneValidation(x);
            });
            list.appendChild(li);
          });
      }

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('open');
        if (dropdown.classList.contains('open')) {
          render();
          setTimeout(() => search.focus(), 50);
        }
      });

      search.addEventListener('input', () => render(search.value));
      search.addEventListener('click', (e) => e.stopPropagation());

      document.addEventListener('click', () => {
        dropdown.classList.remove('open');
        search.value = '';
      });
    }

    initCCPicker('home-cc-btn', 'home-cc-dropdown', 'home-cc-search', 'home-cc-list', 'home-country-code', 'home-phone');

    // Set min date to today so users can't pick past dates
    const dateInput = document.getElementById('home-date');
    if (dateInput) {
      dateInput.min = new Date().toISOString().split('T')[0];
    }

    const form = document.getElementById('home-booking-form');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML = "Submit Request";
        }

        try {
          const formData = new FormData(form);
          const payload = {
            contact_name: formData.get('name'),
            organization_name: formData.get('org'),
            email: formData.get('email'),
            country_code: formData.get('country_code'),
            phone: formData.get('phone'),
            event_type: formData.get('event_type'),
            event_date: formData.get('date'),
            event_location: formData.get('location'),
            estimated_audience_size: formData.get('size'),
            message: formData.get('details'),
            source: 'website_form'
          };

          const response = await fetch('http://localhost:3000/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (response.ok) {
            const successMsg = document.getElementById('home-success-msg');
            successMsg.style.display = 'block';
            form.style.display = 'none';
            successMsg.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            alert('There was a problem submitting your request. Please try again later.');
            if (submitBtn) {
                submitBtn.disabled = false;
              submitBtn.innerHTML = "Submit Request";
            }
          }
        } catch (error) {
          console.error('Error submitting form:', error);
          alert('Could not connect to the server. Please try again later.');
          if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.innerHTML = "Submit Request";
          }
        }
      });
    }
  });
</script>

