---
import Eyebrow from './Eyebrow.astro';
import Waveform from './Waveform.astro';

const { content = {}, collections = {} } = Astro.props;
const attributes = collections.proof_attributes || [];
const testimonials = collections.proof_testimonials || [];

const eyebrow = content.eyebrow ?? "WHY ORGANIZATIONS BRING ME IN";
let rawHeadline = content.headline || "Credibility you can feel.";
let headline = rawHeadline.includes('<span')
  ? rawHeadline
  : `<span class="title-white">Credibility</span> <span class="italic-accent">you can feel.</span>`;
---

<section id="proof" class="proof section-pad theme-ink relative" style="padding-top: 6rem; padding-bottom: 6rem;">
  <Waveform opacity={0.03} variant="A" />
  
  <div class="container-narrow relative z-10">
    <div class="proof-header">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      {headline && <h2 class="section-title proof-title" set:html={headline}></h2>}
    </div>

    {/* Attribute Cards Grid */}
    {attributes.length > 0 && (
      <div class="attributes-grid reveal-up" style="margin: 0 4vw;">
        {attributes.map((attr, index) => {
          const num = (index + 1).toString().padStart(2, '0');
          return (
            <div class="attribute-card">
              <div class="attr-num">{num} <span class="num-slash">//</span></div>
              <h3 class="attr-title">{attr.title}</h3>
            </div>
          );
        })}
      </div>
    )}
  </div>
</section>

<style>
  .proof-header {
    text-align: center;
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .proof-title {
    font-size: clamp(2.5rem, 4vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-ivory, #FBF6EA) !important;
    display: inline-block;
  }

  .title-white {
    color: var(--color-ivory, #FBF6EA) !important;
  }

  /* Attribute Cards Grid */
  .attributes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .attributes-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .attributes-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .attribute-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: all 0.3s ease;
  }

  .attribute-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(217, 162, 58, 0.3);
    transform: translateY(-4px);
  }

  .attr-num {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-gold, #D9A23A) !important;
    letter-spacing: 0.15em;
  }

  .num-slash {
    color: var(--color-coral);
    opacity: 0.8;
  }

  .attr-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--color-ivory);
    line-height: 1.3;
  }
</style>