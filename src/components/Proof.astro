---
import Eyebrow from './Eyebrow.astro';
import Waveform from './Waveform.astro';

const { content = {}, collections = {} } = Astro.props;
const attributes = collections.proof_attributes || [];
const testimonials = collections.proof_testimonials || [];

const eyebrow = content.eyebrow || "WHY ORGANIZATIONS BRING ME IN";
const headline = content.headline || "Credibility you can feel.";
---

<section id="proof" class="proof section-pad theme-ink relative" style="padding-top: 6rem; padding-bottom: 6rem;">
  <Waveform opacity={0.03} variant="A" />
  
  <div class="container relative z-10">
    <div class="proof-header">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="section-title works-title">{headline}</h2>
    </div>

    {/* Attribute Cards Grid */}
    {attributes.length > 0 && (
      <div class="attributes-grid reveal-up">
        {attributes.map((attr, index) => {
          const num = (index + 1).toString().padStart(2, '0');
          return (
            <div class="attribute-card">
              <div class="attr-num">{num} <span class="num-slash">//</span></div>
              <h3 class="attr-title">{attr.title}</h3>
            </div>
          );
        })}
      </div>
    )}

    {/* Testimonials Block - ONLY renders if there are testimonials */}
    {testimonials.length > 0 && (
      <div class="testimonials-block reveal-up" style="margin-top: 8rem;">
        <div class="cinematic-slider">
          <div class="slider-viewport">
            {testimonials.map((test, index) => (
              <div class={`slider-slide ${index === 0 ? 'active' : ''}`}>
                <div class="slide-content">
                  <svg class="giant-quote" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                  </svg>
                  <p class="slide-quote">"{test.content_html || test.subtitle}"</p>
                  <div class="slide-author">
                    <span class="author-name">{test.title}</span>
                    {(test.subtitle || test.content_html) && (
                      <span class="author-role">Client</span>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
          {testimonials.length > 1 && (
            <div class="slider-controls">
              <button class="slider-btn prev-btn" aria-label="Previous quote">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              <div class="slider-progress">
                <div class="progress-bar"></div>
              </div>
              <button class="slider-btn next-btn" aria-label="Next quote">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</section>

{testimonials.length > 1 && (
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = document.querySelectorAll('.slider-slide');
      const nextBtn = document.querySelector('.next-btn');
      const prevBtn = document.querySelector('.prev-btn');
      const progressBar = document.querySelector('.progress-bar');
      
      if(!slides.length || !nextBtn || !prevBtn) return;

      let currentIndex = 0;
      const totalSlides = slides.length;

      function updateSlider(newIndex) {
        if(newIndex === currentIndex) return;
        
        slides[currentIndex].classList.remove('active');
        slides[newIndex].classList.add('active');
        
        currentIndex = newIndex;
        updateProgress();
      }
      
      function updateProgress() {
        const percentage = ((currentIndex + 1) / totalSlides) * 100;
        if(progressBar) {
          progressBar.style.width = `${percentage}%`;
        }
      }

      nextBtn.addEventListener('click', () => {
        const newIndex = (currentIndex + 1) % totalSlides;
        updateSlider(newIndex);
      });

      prevBtn.addEventListener('click', () => {
        const newIndex = (currentIndex - 1 + totalSlides) % totalSlides;
        updateSlider(newIndex);
      });
      
      updateProgress();
    });
  </script>
)}

<style>
  .proof-header {
    text-align: center;
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .works-title {
    font-size: clamp(2.5rem, 4vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  /* Attribute Cards Grid */
  .attributes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .attributes-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .attributes-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.5rem;
    }
  }

  .attribute-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-lg);
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    transition: all 0.3s ease;
  }

  .attribute-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(217, 162, 58, 0.3);
    transform: translateY(-4px);
  }

  .attr-num {
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .num-slash {
    color: rgba(217, 162, 58, 0.4);
    font-size: 0.75rem;
  }

  .attr-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--color-ivory);
    line-height: 1.3;
    font-weight: 400;
  }

  /* Testimonials Slider (Hidden initially) */
  .cinematic-slider {
    position: relative;
    width: 100%;
  }

  .slider-viewport {
    position: relative;
    width: 100%;
    display: grid;
    align-items: center;
  }
  
  .slider-slide {
    grid-column: 1 / 2;
    grid-row: 1 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
    visibility: hidden; 
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }

  .slider-slide.active {
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
    visibility: visible;
  }

  .slide-content {
    text-align: center;
    max-width: 800px;
    padding: 2rem 1rem;
    margin: 0 auto;
  }

  .giant-quote {
    width: 48px;
    height: 48px;
    color: var(--color-gold);
    opacity: 0.3;
    margin: 0 auto 1.5rem auto;
    display: block;
  }

  .slide-quote {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.4;
    color: var(--color-ivory);
    margin-bottom: 2rem;
    font-weight: 300;
  }

  .slide-author {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .author-name {
    font-size: 1.1rem;
    color: var(--color-gold);
    font-weight: 600;
  }

  .author-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-parchment);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.7;
  }

  .slider-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .slider-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: transparent;
    color: var(--color-ivory);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .slider-btn svg {
    width: 18px;
    height: 18px;
  }

  .slider-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--color-gold);
    color: var(--color-gold);
  }

  .slider-progress {
    width: 100px;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background: var(--color-gold);
    transition: width 0.3s ease;
  }
</style>
