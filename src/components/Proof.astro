---
import Waveform from './Waveform.astro';
import Eyebrow from './Eyebrow.astro';

const testimonials = [
  {
    quote: "Tiffany didn’t just give us statistics; she gave us a completely new framework for how we approach student wellness.",
    author: "Dr. Elena Rostova",
    role: "Director of Student Affairs"
  },
  {
    quote: "She has an unparalleled ability to remove the stigma from gambling harm. Our clinicians walked away with practical tools.",
    author: "James Harrington",
    role: "Clinical Director"
  },
  {
    quote: "The energy she brings to a room is electric. Tiffany doesn't just speak; she ignites a movement.",
    author: "Sarah Jenkins",
    role: "Coalition Leader"
  },
  {
    quote: "Her keynote fundamentally shifted how our community leaders talk about addiction. Highly actionable and profoundly authentic.",
    author: "Marcus Vance",
    role: "Event Organizer"
  }
];

// 5 Sleek Generative SVG Logos with Names
const partners = [
  { name: "Horizon Health", svg: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2"><circle cx="20" cy="20" r="12"/><path d="M20 8v24M8 20h24"/></svg>` },
  { name: "Astra Education", svg: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2"><rect x="10" y="10" width="20" height="20" rx="4"/><circle cx="20" cy="20" r="4"/></svg>` },
  { name: "Apex Coalition", svg: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L32 14V26L20 34L8 26V14L20 6Z"/><circle cx="20" cy="20" r="4"/></svg>` },
  { name: "Summit Wellness", svg: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 14L26 26M26 14L14 26"/><rect x="8" y="8" width="24" height="24" rx="12"/></svg>` },
  { name: "Nexus Care", svg: `<svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2"><circle cx="16" cy="20" r="8"/><circle cx="24" cy="20" r="8"/></svg>` }
];

// Create a large, perfectly duplicated array for seamless infinite scrolling
const track1 = [...partners, ...partners, ...partners, ...partners, ...partners, ...partners];
// Reverse the array for the second track so it looks varied
const reversedPartners = [...partners].reverse();
const track2 = [...reversedPartners, ...reversedPartners, ...reversedPartners, ...reversedPartners, ...reversedPartners, ...reversedPartners];
---

<section class="proof section-pad theme-ink">
  <Waveform opacity={0.06} flipX={true} flipY={true} />
  
  <div class="container">
    <div class="proof-header reveal-up">
      <Eyebrow>Proof & Press</Eyebrow>
      <h2 class="section-title">Trusted where <span class="italic-accent">prevention happens.</span></h2>
    </div>
    
    <!-- Cinematic Testimonial Slider -->
    <div class="cinematic-slider reveal-up">
      <div class="slider-viewport">
        {testimonials.map((t, index) => (
          <div class={`slider-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
            <div class="slide-content">
              <svg class="giant-quote" viewBox="0 0 24 24" fill="currentColor"><path d="M9.983 3v7.391C9.983 16.069 6.222 19.5 2.5 19.5V17c2.812 0 4.983-2.316 4.983-5.061H2.5V3h7.483zm11.517 0v7.391c0 5.678-3.761 9.109-7.483 9.109V17c2.812 0 4.983-2.316 4.983-5.061h-4.983V3h7.483z"/></svg>
              <h3 class="slide-quote">"{t.quote}"</h3>
              <div class="slide-author">
                <span class="author-name">{t.author}</span>
                <span class="author-role">{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
      
      <div class="slider-controls">
        <button class="slider-btn prev-btn" aria-label="Previous Testimonial">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <div class="slider-progress">
          <div class="progress-bar"></div>
        </div>
        <button class="slider-btn next-btn" aria-label="Next Testimonial">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
    
    <div class="proof-logos reveal-up">
      <div class="logos-title">
        <h3 class="partner-heading">Our Partners & Collaborators</h3>
      </div>
      <div class="marquee-dual">
        <div class="marquee-track track-left">
          {track1.map(partner => (
            <div class="partner-item">
              <div class="medallion glass-card">
                <div class="medallion-icon" set:html={partner.svg} />
              </div>
              <span class="partner-name">{partner.name}</span>
            </div>
          ))}
        </div>
        <div class="marquee-track track-right">
          {track2.map(partner => (
            <div class="partner-item">
              <div class="medallion glass-card">
                <div class="medallion-icon" set:html={partner.svg} />
              </div>
              <span class="partner-name">{partner.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const slides = document.querySelectorAll('.slider-slide');
    const nextBtn = document.querySelector('.next-btn');
    const prevBtn = document.querySelector('.prev-btn');
    const progressBar = document.querySelector('.progress-bar');
    
    if(!slides.length) return;

    let currentIndex = 0;
    const totalSlides = slides.length;
    let autoPlayTimer;

    function updateSlider(newIndex, direction) {
      if(newIndex === currentIndex) return;
      
      const currentSlide = slides[currentIndex];
      const nextSlide = slides[newIndex];
      
      // Dramatic Cinematic Blur Fade Out
      gsap.to(currentSlide, {
        opacity: 0,
        filter: "blur(12px)",
        scale: 0.95,
        duration: 0.6,
        ease: "power2.inOut",
        onComplete: () => {
          currentSlide.classList.remove('active');
          currentSlide.style.filter = "blur(0px)"; // Reset for next time
        }
      });
      
      // Dramatic Cinematic Blur Fade In
      nextSlide.classList.add('active');
      gsap.fromTo(nextSlide, 
        { opacity: 0, filter: "blur(12px)", scale: 1.05 },
        { opacity: 1, filter: "blur(0px)", scale: 1, duration: 0.8, ease: "power2.out", delay: 0.1 }
      );
      
      currentIndex = newIndex;
      updateProgress();
      resetAutoPlay();
    }
    
    function updateProgress() {
      const percentage = ((currentIndex + 1) / totalSlides) * 100;
      gsap.to(progressBar, { width: `${percentage}%`, duration: 0.4, ease: "power2.out" });
    }

    function next() {
      const newIndex = (currentIndex + 1) % totalSlides;
      updateSlider(newIndex, 1);
    }

    function prev() {
      const newIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      updateSlider(newIndex, -1);
    }
    
    function resetAutoPlay() {
      clearInterval(autoPlayTimer);
      autoPlayTimer = setInterval(next, 7000); // 7 seconds per quote
    }

    nextBtn.addEventListener('click', next);
    prevBtn.addEventListener('click', prev);
    
    // Init
    updateProgress();
    resetAutoPlay();
  });
</script>

<style>
  .proof {
    background: var(--color-ink);
    position: relative;
    z-index: 2;
    overflow: hidden;
  }
  
  .section-pad {
    padding: var(--sp-24) 0;
  }
  
  .container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  .proof-header {
    text-align: center;
    margin-bottom: var(--sp-12);
  }

  /* Cinematic Slider */
  .cinematic-slider {
    position: relative;
    width: 100%;
    margin-bottom: var(--sp-24);
  }

  /* Using CSS Grid to stack slides, automatically sizing to the tallest slide */
  .slider-viewport {
    position: relative;
    width: 100%;
    display: grid;
    align-items: center;
  }
  
  .slider-slide {
    grid-column: 1 / 2;
    grid-row: 1 / 2;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    z-index: 1;
    visibility: hidden; 
  }

  .slider-slide.active {
    opacity: 1;
    pointer-events: auto;
    z-index: 2;
    visibility: visible;
  }

  .slide-content {
    text-align: center;
    max-width: 800px;
    padding: var(--sp-8) var(--sp-4);
  }

  .giant-quote {
    width: 56px;
    height: 56px;
    color: var(--color-gold);
    opacity: 0.25;
    margin: 0 auto var(--sp-6) auto;
    display: block;
  }

  .slide-quote {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 4vw, 2.5rem);
    line-height: 1.4;
    color: var(--color-ivory);
    margin-bottom: var(--sp-8);
    font-weight: 300;
  }

  .slide-author {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .author-name {
    font-size: 1.15rem;
    color: var(--color-gold);
    font-weight: 600;
  }

  .author-role {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-parchment);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.7;
  }

  .slider-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--sp-6);
    margin-top: var(--sp-8);
  }

  .slider-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: transparent;
    color: var(--color-ivory);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .slider-btn svg {
    width: 20px;
    height: 20px;
  }

  .slider-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--color-gold);
    color: var(--color-gold);
    transform: scale(1.1);
  }

  .slider-progress {
    width: 140px;
    height: 2px;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
  }

  .progress-bar {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 25%;
    background: var(--color-gold);
  }

  /* Dual Marquee */
  .proof-logos {
    padding-top: var(--sp-12);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: var(--sp-12);
  }

  .logos-title {
    text-align: center;
    margin-bottom: var(--sp-12);
  }

  .partner-heading {
    font-family: var(--font-mono);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-gold);
  }

  .marquee-dual {
    display: flex;
    flex-direction: column;
    gap: var(--sp-12);
    width: 100%;
    overflow: hidden;
    padding: var(--sp-6) 0; /* Prevents bobbing animation from clipping */
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: var(--sp-8);
    width: max-content;
    will-change: transform;
  }

  /* Different speeds and directions */
  .track-left {
    animation: scrollLeft 45s linear infinite;
  }

  .track-right {
    animation: scrollRight 55s linear infinite;
    margin-left: -200px;
  }
  
  .marquee-track:hover {
    animation-play-state: paused;
  }

  .partner-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
  }

  .partner-name {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-parchment);
    opacity: 0.6;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  /* Highly Visible Glass Medallions */
  .medallion {
    width: 84px;
    height: 84px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 18px;
    color: var(--color-parchment);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(217, 162, 58, 0.25);
    box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.4);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    
    /* Gentle idle bobbing */
    animation: bob 4s ease-in-out infinite alternate;
  }
  
  /* Stagger the bobbing so they move independently */
  .partner-item:nth-child(even) .medallion { animation-delay: -1.5s; }
  .partner-item:nth-child(3n) .medallion { animation-delay: -3s; }

  .partner-item:hover .medallion {
    background: rgba(217, 162, 58, 0.15);
    border-color: var(--color-gold);
    color: var(--color-gold);
    transform: scale(1.1) translateY(-4px) !important;
    animation-play-state: paused;
    box-shadow: 0 10px 20px rgba(0,0,0,0.3), inset 0 0 20px rgba(217, 162, 58, 0.2);
  }
  
  .partner-item:hover .partner-name {
    opacity: 1;
    color: var(--color-gold);
  }

  .medallion-icon {
    width: 100%;
    height: 100%;
  }
  
  .medallion-icon svg {
    width: 100%;
    height: 100%;
  }

  @keyframes scrollLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes scrollRight {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }
  
  @keyframes bob {
    0% { transform: translateY(0); }
    100% { transform: translateY(-8px); }
  }
</style>
