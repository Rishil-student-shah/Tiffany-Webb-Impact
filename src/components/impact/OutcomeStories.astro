---
import Eyebrow from '../Eyebrow.astro';
import Waveform from '../Waveform.astro';
import { Image } from 'astro:assets';
import thumb1 from '../../assets/thumb_1.jpg';
import thumb2 from '../../assets/thumb_2.jpg';

const { collections = {} } = Astro.props;

const fallbackStories = [
  {
    tag: "YOUTH & COMMUNITY PREVENTION",
    badge: "EVENT SPOTLIGHT",
    title: "Youth Creative Arts Prevention & Resource Fair",
    partner: "Blocks 2 Cities + GambleFreeGear",
    reach: "67 Total Reach · Multi-Gen Attendees",
    dateLoc: "August 2026 · Chicago, IL",
    situation: "Grassroots youth and community families navigating emerging digital risks, mobile sports wagering exposure, and social media pressures without structured community screening or relatable prevention tools.",
    action: "Tiffany co-led a high-engagement prevention activation featuring the signature Prevention Passport, youth-led panel discussion, creative arts vision board session, and direct linkage to local care partners.",
    outcome: "67 youth, parents, and community members completed the interactive Prevention Passport screening journey, connecting families to care resources and establishing an ongoing youth prevention pipeline.",
    quote: "Tiffany brought a format the kids actually connected with. The Prevention Passport turned an intimidating public health conversation into an engaging, empowering experience.",
    thumb: thumb1,
    color: "#0E6B54"
  },
  {
    tag: "STATEWIDE PROFESSIONAL EDUCATION",
    badge: "CONFERENCE BREAKOUT",
    title: "ICPG Statewide Conference: Outreach Best Practices",
    partner: "Illinois Council on Problem Gambling",
    reach: "350+ Statewide Prevention Professionals",
    dateLoc: "June 2026 · Springfield, IL",
    situation: "Clinical providers and public health educators across Illinois needed evidence-based, culturally grounded frameworks to reach historically underserved communities and bridge clinical screening protocols with frontline trust.",
    action: "Tiffany delivered an intensive master breakout session on multicultural outreach strategy, actionable touchpoint architecture, and operationalizing the GEAR Method™ in clinical and community settings.",
    outcome: "Equipped statewide prevention leaders with practical engagement playbooks and NODS-CLiP brief intervention protocols implemented across regional healthcare and ROSC networks.",
    quote: "One of the most practical, human-centered sessions at our conference. Tiffany bridges frontline reality with professional rigor in a way that stays with you long after the event.",
    thumb: thumb2,
    color: "#D9A23A"
  }
];

const stories = (collections.outcome_stories && collections.outcome_stories.length > 0)
  ? collections.outcome_stories.map((c, idx) => ({
      tag: c.badge || "VERIFIED CASE STUDY",
      badge: c.badge || "CASE STUDY",
      title: c.title,
      partner: c.subtitle || "Partner Organization",
      reach: c.image_url || "Verified Reach",
      dateLoc: c.subtitle || "Illinois",
      situation: (c.content_html || "").split('<br/><br/>')[0] || "Community context and challenge.",
      action: (c.content_html || "").split('<br/><br/>')[1] || "Tiffany's strategic intervention and keynote activation.",
      outcome: (c.content_html || "").split('<br/><br/>')[2] || "Documented community outcome.",
      quote: "Tiffany bridges frontline reality with professional rigor in a way that stays with you long after the event.",
      thumb: idx === 0 ? thumb1 : thumb2,
      color: idx === 0 ? "#0E6B54" : "#D9A23A"
    }))
  : fallbackStories;
---

<section class="outcome-stories theme-ink relative overflow-hidden" id="impact-stories">
  <Waveform opacity={0.05} variant="C" />

  <div class="container relative z-10" style="max-width: 1200px; margin: 0 auto; padding: 6rem 1.5rem;">
    
    <!-- Section Header -->
    <div class="reveal-up text-center mb-16 outcome-header" style="max-width: 840px; margin-left: auto; margin-right: auto; text-align: center; display: flex; flex-direction: column; align-items: center;">
      <Eyebrow className="justify-center text-center">FEATURED IMPACT STORIES</Eyebrow>
      <h2 class="section-title mt-4 text-center" style="color: var(--color-ivory);" set:html={`Documented change <span class="italic-accent">in the field.</span>`}></h2>
      <p class="subtitle mt-4 text-center" style="font-size: 1.15rem; color: rgba(251, 246, 234, 0.85); line-height: 1.6; text-align: center; margin: 0 auto;">
        Real engagements, verified reach, and concrete community outcomes across Illinois.
      </p>
    </div>

    <!-- Stories Grid -->
    <div class="stories-grid stagger-group">
      {stories.map((story, i) => (
        <div class="story-card ultra-glass-card stagger-item">
          <div class="story-inner">
            
            <!-- Header Meta -->
            <div class="story-meta-header">
              <span class="story-badge" style={`color: ${story.color}; border-color: ${story.color}55; background: ${story.color}18;`}>
                {story.badge}
              </span>
              <span class="story-reach">{story.reach}</span>
            </div>

            <h3 class="story-title">{story.title}</h3>
            <p class="story-partner">{story.partner} &bull; {story.dateLoc}</p>

            <!-- 3-Part Deep Breakdown -->
            <div class="story-breakdown">
              <div class="breakdown-block">
                <span class="block-label">THE CHALLENGE</span>
                <p class="block-text">{story.situation}</p>
              </div>

              <div class="breakdown-block">
                <span class="block-label">THE INTERVENTION</span>
                <p class="block-text">{story.action}</p>
              </div>

              <div class="breakdown-block outcome-block">
                <span class="block-label">DOCUMENTED OUTCOME</span>
                <p class="block-text font-semibold">{story.outcome}</p>
              </div>
            </div>

            <!-- Authentic Attendee Quote -->
            <div class="story-quote-box">
              <p class="quote-text">"{story.quote}"</p>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .outcome-stories {
    padding: 2rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .outcome-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    margin-right: auto;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 900px) {
    .stories-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .story-card {
    background: rgba(20, 18, 14, 0.7);
    border: 1px solid rgba(217, 162, 58, 0.22);
    border-radius: 24px;
    padding: 2.5rem 2rem;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.4);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .story-meta-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .story-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    border: 1px solid;
  }

  .story-reach {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-gold, #D9A23A);
    font-weight: 600;
  }

  .story-title {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    line-height: 1.25;
    color: var(--color-ivory, #FBF6EA);
    margin: 0 0 0.5rem 0;
  }

  .story-partner {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(251, 246, 234, 0.65);
    margin: 0 0 2rem 0;
    letter-spacing: 0.05em;
  }

  .story-breakdown {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .breakdown-block {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    padding: 1.25rem;
  }

  .outcome-block {
    background: rgba(217, 162, 58, 0.06);
    border-color: rgba(217, 162, 58, 0.25);
  }

  .block-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold, #D9A23A);
    margin-bottom: 0.4rem;
  }

  .block-text {
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(251, 246, 234, 0.85);
    margin: 0;
  }

  .story-quote-box {
    border-left: 2px solid var(--color-gold, #D9A23A);
    padding-left: 1.25rem;
    margin-top: auto;
  }

  .quote-text {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--color-ivory, #FBF6EA);
    font-style: italic;
    margin: 0;
  }
</style>
