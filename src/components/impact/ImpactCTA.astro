---
import Eyebrow from '../Eyebrow.astro';
import Button from '../Button.astro';
import Waveform from '../Waveform.astro';

const { content = {} } = Astro.props;
const eyebrow = content.eyebrow || "BRING TIFFANY IN";
let headline = content.headline || 'Bring documented impact to <br/>your <span class="italic-accent">organization.</span>';
const subtitle = content.subtitle || "Check availability and request a custom keynote, training session, or strategic community engagement tailored to your specific goals.";
const btnText = content.button_text || "START A CONVERSATION \u2192";
const btnUrl = content.button_url || "/work-with-tiffany";
---

<section class="impact-cta-section theme-ink relative overflow-hidden">
  <Waveform opacity={0.06} variant="B" />
  
  <div class="container relative z-10 text-center" style="max-width: 900px; margin: 0 auto; padding: 0 1.5rem;">
    <div class="section-header-block reveal-up text-center">
      <Eyebrow className="justify-center text-center">{eyebrow}</Eyebrow>
      <h2 class="cta-headline text-center" set:html={headline}></h2>
      <p class="cta-subtitle text-center">
        {subtitle}
      </p>
      <div class="cta-action">
        <Button href={btnUrl} variant="primary" className="magnetic-btn">
          {btnText}
        </Button>
      </div>
    </div>
  </div>
</section>

<style>
  .impact-cta-section {
    padding: 8rem 0;
    background: radial-gradient(circle at 50% 50%, rgba(217, 162, 58, 0.12) 0%, rgba(13, 12, 8, 1) 80%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
  }

  .section-header-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin: 0 auto;
    gap: 1.75rem;
    max-width: 840px;
  }

  .cta-headline {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 4.5vw, 3.8rem);
    color: var(--color-ivory, #FBF6EA);
    line-height: 1.25;
    margin: 0.25rem 0;
    text-align: center;
  }

  .cta-subtitle {
    font-size: 1.18rem;
    line-height: 1.7;
    color: rgba(251, 246, 234, 0.85);
    max-width: 680px;
    text-align: center;
    margin: 0 auto;
  }

  .cta-action {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: 0.75rem;
  }
</style>
