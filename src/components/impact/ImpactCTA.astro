<section class="impact-cta section-pad theme-ink text-center">
  <div class="container stagger-group">
    <div class="text-center mx-auto stagger-item" style="max-width: 800px;">
      <h2 class="cta-title text-center">Ready to bring this impact to your community?</h2>
    </div>
    <p class="cta-sub stagger-item mt-6 mx-auto" style="max-width: 600px;">
      Check availability and request a custom proposal for your next event, training, or clinical intensive.
    </p>
    <div class="stagger-item mt-8">
      <a href="/book" class="btn btn-primary">Request Booking</a>
    </div>
  </div>
</section>

<style>
  .impact-cta {
    background: var(--ink);
    padding: var(--sp-24) 0;
  }

  .cta-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-family: var(--font-serif);
    color: var(--color-ivory);
    line-height: 1.2;
  }

  .cta-sub {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
  }
</style>
