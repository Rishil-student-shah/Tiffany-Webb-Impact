---
import Eyebrow from '../Eyebrow.astro';
import Waveform from '../Waveform.astro';
import Button from '../Button.astro';
---

<section class="upcoming-section theme-ink relative overflow-hidden" id="upcoming-engagements">
  <Waveform opacity={0.04} variant="B" flipX={true} />
  
  <div class="container relative z-10" style="max-width: 1000px; margin: 0 auto; padding: 5rem 1.5rem;">
    
    <div class="upcoming-status-card ultra-glass-card text-center reveal-up">
      <div class="badge-wrap mb-6">
        <span class="status-badge">ANNOUNCING SOON</span>
      </div>

      <Eyebrow className="justify-center">UPCOMING SCHEDULE</Eyebrow>
      
      <h2 class="status-headline mt-4">
        New engagement dates will be announced <br/>
        <span class="italic-accent">as they are confirmed.</span>
      </h2>
      
      <p class="status-subtext mx-auto mt-6">
        Tiffany is currently accepting invitations for keynotes, workshops, and coalition engagements for 2026 / 2027.
      </p>

      <div class="status-action mt-8">
        <Button href="/work-with-tiffany" variant="primary" className="magnetic-btn">
          Inquire for Your Event Date &rarr;
        </Button>
      </div>
    </div>

  </div>
</section>

<style>
  .upcoming-section {
    padding: 2rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .upcoming-status-card {
    background: radial-gradient(circle at 50% 0%, rgba(217, 162, 58, 0.1) 0%, rgba(20, 18, 14, 0.85) 80%);
    border: 1px solid rgba(217, 162, 58, 0.25);
    border-radius: 24px;
    padding: 4rem 2.5rem;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold, #D9A23A);
    background: rgba(217, 162, 58, 0.12);
    border: 1px solid rgba(217, 162, 58, 0.35);
    padding: 0.4rem 1rem;
    border-radius: 100px;
    display: inline-block;
  }

  .status-headline {
    font-family: var(--font-serif);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    color: var(--color-ivory, #FBF6EA);
    line-height: 1.25;
    margin: 0;
  }

  .status-subtext {
    font-size: 1.15rem;
    line-height: 1.6;
    color: rgba(251, 246, 234, 0.8);
    max-width: 680px;
  }
</style>
