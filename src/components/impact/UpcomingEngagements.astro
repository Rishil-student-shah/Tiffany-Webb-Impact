---
import Eyebrow from '../Eyebrow.astro';
import Waveform from '../Waveform.astro';
import Button from '../Button.astro';

const upcomingEvents = [
  {
    date: "AUG 2026",
    name: "Youth Creative Arts Prevention & Resource Fair",
    location: "Chicago, IL",
    type: "Community Expo",
    desc: "Interactive youth creative arts showcase, resource distribution, and community-wide problem gambling prevention screening.",
    bgStart: "#5A4614",
    bgEnd: "#1E190A",
    border: "rgba(200, 162, 76, 0.45)"
  },
  {
    date: "FALL 2026",
    name: "Statewide Behavioral Health & Public Health Tour",
    location: "Springfield & Chicago, IL",
    type: "Keynote & Advisory",
    desc: "Multi-city executive keynote and frontline healthcare clinical training on screening integration and community health equity.",
    bgStart: "#0A2B1A",
    bgEnd: "#050F0A",
    border: "rgba(14, 107, 84, 0.45)"
  }
];
---

<section class="upcoming section-pad theme-ink relative overflow-hidden" id="upcoming-stages">
  <Waveform opacity={0.05} variant="B" flipX={true} />
  
  <div class="container stagger-group relative z-10" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
    <div class="upcoming-header stagger-item">
      <Eyebrow className="text-center justify-center">Upcoming</Eyebrow>
      <h2 class="section-title text-center">Confirmed <span class="italic-accent">Engagements</span></h2>
      <p class="upcoming-desc">Where Tiffany is bringing keynotes, trainings, and community prevention initiatives next.</p>
    </div>
    
    <div class="upcoming-grid stagger-item">
      {upcomingEvents.map((ev) => (
        <div class="upcoming-card" style={`--bg-start: ${ev.bgStart}; --bg-end: ${ev.bgEnd}; --card-border: ${ev.border};`}>
          <div class="card-inner">
            <div class="card-top">
              <span class="card-date">{ev.date}</span>
              <span class="card-type">{ev.type}</span>
            </div>
            <h3 class="card-name">{ev.name}</h3>
            <p class="card-desc">{ev.desc}</p>
            <div class="card-bottom">
              <div class="card-location">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>{ev.location}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
    
    <div class="upcoming-cta stagger-item">
      <Button href="/work-with-tiffany" variant="primary" className="magnetic-btn">BRING TIFFANY TO YOUR EVENT &rarr;</Button>
    </div>
  </div>
</section>

<style>
  .upcoming {
    padding: var(--sp-24) 0;
    position: relative;
    overflow: hidden;
  }

  .upcoming-header {
    max-width: 700px;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .upcoming-desc {
    font-size: 1.1rem;
    color: rgba(251, 246, 234, 0.85);
    line-height: 1.6;
    margin-top: 1rem;
  }

  .upcoming-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
    margin-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .upcoming-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .upcoming-card {
    border-radius: 20px;
    background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);
    border: 1px solid var(--card-border);
    padding: 2.25rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 10px 30px rgba(0,0,0,0.3);
  }

  .upcoming-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(0,0,0,0.5), 0 0 20px rgba(217, 162, 58, 0.1);
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .card-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-gold, #D9A23A);
    letter-spacing: 0.1em;
  }

  .card-type {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    color: rgba(251, 246, 234, 0.9);
    text-transform: uppercase;
  }

  .card-name {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    line-height: 1.25;
    color: var(--color-ivory, #FBF6EA);
    margin: 0 0 0.75rem 0;
  }

  .card-desc {
    font-size: 0.92rem;
    line-height: 1.55;
    color: rgba(251, 246, 234, 0.85);
    margin: 0 0 1.5rem 0;
  }

  .card-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1rem;
    margin-top: auto;
  }

  .card-location {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-gold, #D9A23A);
    font-family: var(--font-mono);
  }

  .upcoming-cta {
    text-align: center;
  }
</style>
