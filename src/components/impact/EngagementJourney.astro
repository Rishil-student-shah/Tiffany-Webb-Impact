---
import Eyebrow from '../Eyebrow.astro';
import Waveform from '../Waveform.astro';

const steps = [
  {
    num: "01",
    title: "Understand the Audience",
    desc: "Pre-engagement discovery call to assess community context, demographic realities, and organizational goals before designing the session."
  },
  {
    num: "02",
    title: "Customize the Experience",
    desc: "Tailoring data points, discussion prompts, and interactive elements specifically for the clinicians, youth, or leaders in your room."
  },
  {
    num: "03",
    title: "Deliver the Engagement",
    desc: "Keynotes, workshops, and panel sessions delivered with frontline authenticity, cultural fluency, and high-energy crowd connection."
  },
  {
    num: "04",
    title: "Leave Practical Resources",
    desc: "Distributing actionable Monday-morning screening protocols, prevention passports, and follow-up clinical linkage guides."
  },
  {
    num: "05",
    title: "Follow Up on Impact",
    desc: "Reviewing event outcomes, post-session feedback, and structuring ongoing coalition or organizational capacity building."
  }
];
---

<section class="engagement-journey-section theme-ink relative overflow-hidden" id="engagement-journey">
  <Waveform opacity={0.05} variant="A" flipY={true} />

  <div class="container relative z-10" style="max-width: 1240px; margin: 0 auto; padding: 6rem 1.5rem;">
    
    <div class="reveal-up text-center mb-16" style="max-width: 800px; margin-left: auto; margin-right: auto;">
      <Eyebrow className="justify-center">OUR PROCESS</Eyebrow>
      <h2 class="section-title mt-4" style="color: var(--color-ivory);">
        The engagement <span class="italic-accent">journey.</span>
      </h2>
      <p class="subtitle mt-4" style="font-size: 1.15rem; color: rgba(251, 246, 234, 0.85); line-height: 1.6;">
        From initial discovery to long-term community follow-through, every step is built for lasting impact.
      </p>
    </div>

    <!-- 5-Step Process Timeline -->
    <div class="journey-steps-grid stagger-group">
      {steps.map((step) => (
        <div class="journey-step-card ultra-glass-card stagger-item">
          <div class="step-num-pill">{step.num}</div>
          <h3 class="step-card-title">{step.title}</h3>
          <p class="step-card-desc">{step.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .engagement-journey-section {
    padding: 2rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .journey-steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .journey-steps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .journey-steps-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }

  .journey-step-card {
    background: rgba(20, 18, 14, 0.7);
    border: 1px solid rgba(217, 162, 58, 0.22);
    border-radius: 18px;
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    transition: all 0.3s ease;
  }

  .journey-step-card:hover {
    transform: translateY(-3px);
    border-color: rgba(217, 162, 58, 0.5);
  }

  .step-num-pill {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-gold, #D9A23A);
    background: rgba(217, 162, 58, 0.12);
    border: 1px solid rgba(217, 162, 58, 0.3);
    width: fit-content;
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
    margin-bottom: 1.25rem;
  }

  .step-card-title {
    font-family: var(--font-serif);
    font-size: 1.18rem;
    line-height: 1.3;
    color: var(--color-ivory, #FBF6EA);
    margin: 0 0 0.75rem 0;
  }

  .step-card-desc {
    font-size: 0.85rem;
    line-height: 1.55;
    color: rgba(251, 246, 234, 0.8);
    margin: 0;
  }
</style>
