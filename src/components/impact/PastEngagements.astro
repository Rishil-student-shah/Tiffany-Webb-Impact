---
import Eyebrow from '../Eyebrow.astro';
import Waveform from '../Waveform.astro';

const pastEngagements = [
  {
    year: "2026",
    format: "Keynote",
    audience: "Statewide Prevention Professionals",
    name: "ICPG Conference: Outreach Best Practices",
    host: "Illinois Council on Problem Gambling",
    city: "Springfield, IL",
    size: "350+ Attendees",
    substance: "Keynote and session delivery on grassroots engagement, health equity in problem gambling prevention, and cross-system linkage.",
    bgStart: "#5A4614",
    bgEnd: "#1E190A",
    border: "rgba(200, 162, 76, 0.45)"
  },
  {
    year: "2026",
    format: "Workshop",
    audience: "Community Activation",
    name: "Women Connection Summit",
    host: "Women Connection Network",
    city: "Chicago, IL",
    size: "600+ Attendees",
    substance: "Empowering women leaders and families to break the silence surrounding hidden behavioral addictions and build emotional wellness.",
    bgStart: "#5A2C18",
    bgEnd: "#1E0F0A",
    border: "rgba(193, 84, 39, 0.45)"
  },
  {
    year: "2026",
    format: "Facilitation",
    audience: "ROSC & Care Linkage",
    name: "TEEH Foundation ROSC Council",
    host: "TEEH Foundation",
    city: "South Suburban Chicago, IL",
    size: "250+ Attendees",
    substance: "Strategic council facilitation integrating problem gambling prevention directly into local Recovery Oriented Systems of Care.",
    bgStart: "#0A2B1A",
    bgEnd: "#050F0A",
    border: "rgba(14, 107, 84, 0.45)"
  },
  {
    year: "2026",
    format: "Community Expo",
    audience: "Youth & Families",
    name: "Youth Creative Arts Prevention & Resource Fair",
    host: "Community Arts & Health Collaborative",
    city: "Chicago, IL",
    size: "67 Direct Reach",
    substance: "Youth creative arts exhibition and interactive community prevention resource fair connecting youth and families with vital screening tools.",
    bgStart: "#4A1E31",
    bgEnd: "#190A0F",
    border: "rgba(108, 45, 90, 0.45)"
  }
];
---

<section class="past-engagements section-pad theme-ink relative overflow-hidden" id="engagements-directory">
  <Waveform opacity={0.05} variant="A" flipY={true} />
  
  <div class="container stagger-group relative z-10">
    <div class="past-header stagger-item">
      <Eyebrow className="text-center justify-center">Directory</Eyebrow>
      <h2 class="section-title text-center">Documented <span class="italic-accent">Engagements</span></h2>
      <p class="past-desc">Real stages, summits, and community coalition forums from Tiffany's master impact record.</p>
    </div>
    
    <div class="filters-wrapper stagger-item">
      <div class="filter-pills" id="engagement-filters">
        <button class="pill active" data-filter="All">All</button>
        <button class="pill" data-filter="Keynote">Keynotes</button>
        <button class="pill" data-filter="Workshop">Workshops</button>
        <button class="pill" data-filter="Facilitation">Facilitation</button>
        <button class="pill" data-filter="Community Expo">Community Expo</button>
      </div>
    </div>

    <div class="bento-grid stagger-item" id="engagement-grid">
      {pastEngagements.map((event) => (
        <div class="bento-card" data-format={event.format} style={`--bg-start: ${event.bgStart}; --bg-end: ${event.bgEnd}; --card-border: ${event.border};`}>
          <div class="card-inner">
            <div class="card-header">
              <span class="event-year">{event.year}</span>
              <span class="event-badge">{event.format}</span>
            </div>
            
            <div class="card-body">
              <h3 class="event-name">{event.name}</h3>
              <p class="event-host">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="host-icon"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                {event.host} <span class="city-dot">•</span> {event.city}
              </p>
            </div>
            
            <div class="card-footer">
              <p class="event-substance">{event.substance}</p>
              <div class="card-meta">
                <span class="meta-tag audience-tag">{event.audience}</span>
                <span class="meta-tag size-tag">{event.size}</span>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const pills = document.querySelectorAll('#engagement-filters .pill');
    const cards = document.querySelectorAll('#engagement-grid .bento-card');

    pills.forEach(pill => {
      pill.addEventListener('click', () => {
        pills.forEach(p => p.classList.remove('active'));
        pill.classList.add('active');

        const filter = pill.getAttribute('data-filter');

        cards.forEach(card => {
          if (filter === 'All' || card.getAttribute('data-format') === filter) {
            card.style.display = 'block';
            card.style.opacity = '1';
            card.style.transform = 'translateY(0)';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .past-engagements {
    padding: var(--sp-24) 0;
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .past-header {
    max-width: 700px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .past-desc {
    font-size: 1.1rem;
    color: rgba(251, 246, 234, 0.85);
    line-height: 1.6;
    margin-top: 1rem;
  }

  .filters-wrapper {
    display: flex;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
    padding: 0.5rem;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .pill {
    background: transparent;
    border: none;
    color: rgba(251, 246, 234, 0.7);
    padding: 0.5rem 1.25rem;
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .pill:hover {
    color: var(--color-gold, #D9A23A);
    background: rgba(255, 255, 255, 0.05);
  }

  .pill.active {
    background: var(--color-gold, #D9A23A);
    color: #0D0C08;
    box-shadow: 0 2px 10px rgba(217, 162, 58, 0.35);
  }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .bento-card {
    border-radius: 20px;
    background: linear-gradient(135deg, var(--bg-start) 0%, var(--bg-end) 100%);
    border: 1px solid var(--card-border);
    padding: 2rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }

  .bento-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5), 0 0 20px rgba(217, 162, 58, 0.1);
  }

  .card-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    justify-content: space-between;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .event-year {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-gold, #D9A23A);
  }

  .event-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    color: rgba(251, 246, 234, 0.9);
  }

  .event-name {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--color-ivory, #FBF6EA);
    margin: 0 0 0.5rem 0;
  }

  .event-host {
    font-size: 0.88rem;
    color: rgba(251, 246, 234, 0.75);
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 1.25rem;
  }

  .host-icon {
    color: var(--color-gold, #D9A23A);
  }

  .city-dot {
    color: var(--color-gold, #D9A23A);
  }

  .card-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1rem;
    margin-top: auto;
  }

  .event-substance {
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(251, 246, 234, 0.85);
    margin: 0 0 1rem 0;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .meta-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.25rem 0.55rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.06);
    color: rgba(251, 246, 234, 0.8);
  }
</style>
