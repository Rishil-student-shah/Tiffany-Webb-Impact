---
import Eyebrow from '../Eyebrow.astro';
import Waveform from '../Waveform.astro';

const { collections = {} } = Astro.props;

const fallbackEngagements = [
  {
    year: "2026",
    date: "August 18, 2026",
    format: "Community Expo",
    audience: "Youth & Families",
    name: "Youth Creative Arts Prevention & Resource Fair",
    host: "Blocks 2 Cities + GambleFreeGear",
    city: "Chicago, IL",
    reach: "67 Total Reach",
    substance: "Youth creative arts exhibition, vision board activation, and signature Prevention Passport screening journey connecting youth and parents with care partners.",
    color: "#6C2D5A",
    borderColor: "rgba(108, 45, 90, 0.45)"
  },
  {
    year: "2026",
    date: "June 05, 2026",
    format: "Conference Breakout",
    audience: "Statewide Prevention Professionals",
    name: "ICPG Statewide Conference: Outreach Best Practices",
    host: "Illinois Council on Problem Gambling",
    city: "Springfield, IL",
    reach: "350+ Attendees",
    substance: "Master breakout session on grassroots outreach strategy, health equity frameworks in problem gambling prevention, and cross-system linkage.",
    color: "#D9A23A",
    borderColor: "rgba(217, 162, 58, 0.45)"
  },
  {
    year: "2026",
    date: "July 02, 2026",
    format: "Community Activation",
    audience: "Community Leaders & Families",
    name: "Women Connection Summit",
    host: "Women Connection Network",
    city: "Chicago, IL",
    reach: "600+ Attendees",
    substance: "Empowering women leaders, educators, and families to address hidden behavioral addictions and build resilient community support structures.",
    color: "#C15427",
    borderColor: "rgba(193, 84, 39, 0.45)"
  },
  {
    year: "2026",
    date: "2026",
    format: "Coalition Facilitation",
    audience: "ROSC & Care Linkage",
    name: "TEEH Foundation ROSC Council",
    host: "TEEH Foundation",
    city: "South Suburban Chicago, IL",
    reach: "250+ Attendees",
    substance: "Strategic council facilitation embedding problem gambling prevention and screening workflows directly into local Recovery Oriented Systems of Care.",
    color: "#0E6B54",
    borderColor: "rgba(14, 107, 84, 0.45)"
  }
];

const colors = [
  { color: "#6C2D5A", borderColor: "rgba(108, 45, 90, 0.45)" },
  { color: "#D9A23A", borderColor: "rgba(217, 162, 58, 0.45)" },
  { color: "#C15427", borderColor: "rgba(193, 84, 39, 0.45)" },
  { color: "#0E6B54", borderColor: "rgba(14, 107, 84, 0.45)" }
];

const pastEngagements = (collections.past_engagements && collections.past_engagements.length > 0)
  ? collections.past_engagements.map((c, idx) => ({
      year: "2026",
      date: c.subtitle && c.subtitle.includes('·') ? c.subtitle.split('·')[1]?.trim() || "2026" : "2026",
      format: c.badge || "Engagement",
      audience: c.badge || "Community Stakeholders",
      name: c.title,
      host: c.subtitle && c.subtitle.includes('·') ? c.subtitle.split('·')[0]?.trim() || c.subtitle : (c.subtitle || "Host Organization"),
      city: "Illinois",
      reach: c.image_url || "Verified Reach",
      substance: c.content_html || c.description || c.content_value || "",
      ...colors[idx % colors.length]
    }))
  : fallbackEngagements;
---

<section class="past-engagements theme-ink relative overflow-hidden" id="past-engagements">
  <Waveform opacity={0.04} variant="A" flipY={true} />
  
  <div class="container relative z-10" style="max-width: 1200px; margin: 0 auto; padding: 6rem 1.5rem;">
    
    <!-- Section Header -->
    <div class="reveal-up text-center mb-16" style="max-width: 800px; margin-left: auto; margin-right: auto;">
      <Eyebrow className="justify-center">ENGAGEMENT ARCHIVE</Eyebrow>
      <h2 class="section-title mt-4" style="color: var(--color-ivory);">
        Verified event <span class="italic-accent">track record.</span>
      </h2>
      <p class="subtitle mt-4" style="font-size: 1.15rem; color: rgba(251, 246, 234, 0.85); line-height: 1.6;">
        Real stages, summits, and community coalition forums from Tiffany's master impact tracker.
      </p>
    </div>

    <!-- 4 Verified Event Cards Grid -->
    <div class="engagements-grid stagger-group">
      {pastEngagements.map((event) => (
        <div class="event-card ultra-glass-card stagger-item" style={`border-color: ${event.borderColor};`}>
          <div class="event-card-inner">
            
            <div class="event-card-top">
              <span class="event-date-pill">{event.date}</span>
              <span class="event-format-badge" style={`color: ${event.color}; border: 1px solid ${event.color}66; background: ${event.color}15;`}>
                {event.format}
              </span>
            </div>

            <div class="event-card-body">
              <h3 class="event-title">{event.name}</h3>
              <p class="event-host-loc">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-gold);"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                <span>{event.host}</span> &bull; <span>{event.city}</span>
              </p>
              <p class="event-substance">{event.substance}</p>
            </div>

            <div class="event-card-footer">
              <div class="reach-metric">
                <span class="reach-label">DOCUMENTED REACH</span>
                <span class="reach-value">{event.reach}</span>
              </div>
              <div class="audience-badge">
                <span>{event.audience}</span>
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .past-engagements {
    padding: 2rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .engagements-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .engagements-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .event-card {
    background: rgba(20, 18, 14, 0.7);
    border: 1px solid;
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .event-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .event-date-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-gold, #D9A23A);
    letter-spacing: 0.08em;
  }

  .event-format-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.25rem 0.65rem;
    border-radius: 100px;
  }

  .event-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.3;
    color: var(--color-ivory, #FBF6EA);
    margin: 0 0 0.5rem 0;
  }

  .event-host-loc {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(251, 246, 234, 0.7);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .event-substance {
    font-size: 0.88rem;
    line-height: 1.55;
    color: rgba(251, 246, 234, 0.85);
    margin: 0 0 1.5rem 0;
  }

  .event-card-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 1rem;
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .reach-metric {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .reach-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: rgba(251, 246, 234, 0.5);
  }

  .reach-value {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-gold, #D9A23A);
  }

  .audience-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(251, 246, 234, 0.75);
    background: rgba(255, 255, 255, 0.05);
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
</style>
