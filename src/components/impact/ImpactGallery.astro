---
import Eyebrow from '../Eyebrow.astro';
import Waveform from '../Waveform.astro';
import { Image } from 'astro:assets';
import heroImg from '../../assets/tiffany_hero_new.jpg';
import thumb1 from '../../assets/thumb_1.jpg';
import thumb2 from '../../assets/thumb_2.jpg';
import thumb3 from '../../assets/thumb_3.jpg';
---

<section class="field-work-videos section-pad theme-ink relative overflow-hidden">
  <Waveform opacity={0.06} variant="D" flipX={true} />

  <div class="container stagger-group relative z-10">
    <div style="max-width: 800px; margin: 0 auto; margin-bottom: 4rem; display: flex; flex-direction: column; align-items: center; text-align: center;">
      <Eyebrow className="text-center justify-center">In The Room</Eyebrow>
      <h2 class="section-title text-center" style="text-align: center; margin-left: auto; margin-right: auto;">Field <span class="italic-accent">Work</span></h2>
      <p class="section-desc mt-6 mx-auto" style="margin-top: 1.5rem;">
        See Tiffany in action. From massive corporate auditoriums to intimate clinical workshops, watch how she commands a room and drives transformation.
      </p>
    </div>

    <!-- Inline Video Grid -->
    <div class="inline-videos-grid stagger-item">
      
      <!-- Video 1 -->
      <div class="inline-video-card">
        <div class="inline-video-inner">
          <Image src={heroImg} alt="Tiffany Webb Main Speaking Reel" class="inline-video-poster" />
          <div class="video-overlay"></div>
          <button class="play-btn-inline" aria-label="Play Featured Video">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="play-icon-inline"><path d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347c-.75.412-1.667-.13-1.667-.986V5.653Z" /></svg>
          </button>
          <div class="duration-badge">03:45</div>
        </div>
        <div class="inline-video-meta">
          <h4 class="inline-video-title">Main Speaking Reel</h4>
        </div>
      </div>

      <!-- Video 2 -->
      <div class="inline-video-card">
        <div class="inline-video-inner">
          <Image src={thumb1} alt="Corporate Keynotes" class="inline-video-poster" />
          <div class="video-overlay"></div>
          <button class="play-btn-inline" aria-label="Play Corporate Keynotes">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="play-icon-inline"><path d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347c-.75.412-1.667-.13-1.667-.986V5.653Z" /></svg>
          </button>
          <div class="duration-badge">01:20</div>
        </div>
        <div class="inline-video-meta">
          <h4 class="inline-video-title">Corporate Keynotes</h4>
        </div>
      </div>

      <!-- Video 3 -->
      <div class="inline-video-card">
        <div class="inline-video-inner">
          <Image src={thumb2} alt="Youth & School Assemblies" class="inline-video-poster" />
          <div class="video-overlay"></div>
          <button class="play-btn-inline" aria-label="Play Assemblies">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="play-icon-inline"><path d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347c-.75.412-1.667-.13-1.667-.986V5.653Z" /></svg>
          </button>
          <div class="duration-badge">02:15</div>
        </div>
        <div class="inline-video-meta">
          <h4 class="inline-video-title">Youth Assemblies</h4>
        </div>
      </div>

      <!-- Video 4 -->
      <div class="inline-video-card">
        <div class="inline-video-inner">
          <Image src={thumb3} alt="Clinical & Staff Training" class="inline-video-poster" />
          <div class="video-overlay"></div>
          <button class="play-btn-inline" aria-label="Play Clinical Training">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="play-icon-inline"><path d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347c-.75.412-1.667-.13-1.667-.986V5.653Z" /></svg>
          </button>
          <div class="duration-badge">01:50</div>
        </div>
        <div class="inline-video-meta">
          <h4 class="inline-video-title">Clinical Training</h4>
        </div>
      </div>

    </div>
  </div>
</section>

<style is:global>
  .field-work-videos {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: var(--ink);
    padding: 8rem 0; /* Explicitly added large padding to fix section spacing */
  }

  .inline-videos-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .inline-videos-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .inline-videos-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .inline-video-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    cursor: pointer;
    position: relative;
  }

  .inline-video-inner {
    position: relative;
    border-radius: 16px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 10px 20px rgba(0,0,0,0.4);
    background: #000;
  }

  .inline-video-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .inline-video-card:hover .inline-video-poster {
    transform: scale(1.05);
  }

  .video-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(10,8,7,0.8) 0%, rgba(10,8,7,0.2) 40%, rgba(10,8,7,0.1) 100%);
    z-index: 1;
    pointer-events: none;
  }

  .inline-video-card:hover .inline-video-inner {
    border-color: rgba(217, 162, 58, 0.4);
  }

  .play-btn-inline {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: rgba(10,8,7,0.7);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    border: 1px solid rgba(217, 162, 58, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: all 0.3s ease;
  }

  .inline-video-card:hover .play-btn-inline {
    background: var(--color-gold);
    transform: translate(-50%, -50%) scale(1.1);
  }

  .play-icon-inline {
    width: 22px;
    height: 22px;
    color: var(--color-gold);
    margin-left: 2px;
    transition: color 0.3s ease;
  }

  .inline-video-card:hover .play-icon-inline {
    color: var(--ink);
  }

  .duration-badge {
    position: absolute;
    bottom: 12px;
    right: 12px;
    background: rgba(0,0,0,0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--color-ivory);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 2px 8px;
    border-radius: 4px;
    z-index: 2;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .inline-video-meta {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .inline-video-title {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    color: var(--color-ivory);
    text-align: center;
    margin: 0;
    transition: color 0.3s ease;
  }

  .inline-video-card:hover .inline-video-title {
    color: var(--color-gold);
  }
</style>
