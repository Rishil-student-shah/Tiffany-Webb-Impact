---
import Waveform from './Waveform.astro';
import Eyebrow from './Eyebrow.astro';

const { content = {}, collections = {} } = Astro.props;
const eyebrow = content.eyebrow ?? "SPEAKING TRACKS";
let headline = content.headline ?? 'What she <span class="italic-accent">speaks about.</span>';
const subtext = content.subtext ?? "Twenty topics across four tracks — practical enough to use on Monday, human enough that the room stays with her.";

// 4 Tracks Definition with Organizer Booking Matrix and Direct Track Links
const tracks = [
  {
    num: "01",
    id: "prevention-risk",
    trackParam: "prevention",
    name: "Prevention, Gambling & Emerging Risk",
    color: "#0E6B54",
    borderColor: "rgba(14, 107, 84, 0.45)",
    bgGlow: "rgba(14, 107, 84, 0.15)",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>`,
    tag: "5 Topics · Prevention",
    desc: "Community awareness, youth focus, sports-betting apps, and engaging civic leadership with culturally rooted models.",
    matrixAudience: "Healthcare Systems",
    matrixFormat: "Keynote / Breakout",
    matrixTopic: "#2 From Fun to Crisis: Gambling Prevention & Education",
    catalogLink: "/services/speaking-topics?track=prevention",
    ctaLink: "/work-with-tiffany?topic=From+Fun+to+Crisis&track=Prevention%2C+Gambling+%26+Emerging+Risk&audience=Healthcare+Systems"
  },
  {
    num: "02",
    id: "community-outreach",
    trackParam: "outreach",
    name: "Community Engagement & Outreach",
    color: "#D9A23A",
    borderColor: "rgba(217, 162, 58, 0.45)",
    bgGlow: "rgba(217, 162, 58, 0.15)",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>`,
    tag: "5 Topics · Outreach",
    desc: "Activating hard-to-reach populations, building grassroots coalition trust, and translating community voice into action.",
    matrixAudience: "ROSC & Coalitions",
    matrixFormat: "Strategy Workshop",
    matrixTopic: "#6 The 8 Touchpoints to Engagement",
    catalogLink: "/services/speaking-topics?track=outreach",
    ctaLink: "/work-with-tiffany?topic=The+8+Touchpoints+to+Engagement&track=Community+Engagement+%26+Outreach&audience=ROSC+%26+Coalitions"
  },
  {
    num: "03",
    id: "human-systems",
    trackParam: "systems",
    name: "Human-Centered Systems & Services",
    color: "#C15427",
    borderColor: "rgba(193, 84, 39, 0.45)",
    bgGlow: "rgba(193, 84, 39, 0.15)",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>`,
    tag: "6 Topics · Systems",
    desc: "Screening workflows, co-occurring SUD, harm reduction protocols, and operationalizing the GEAR Method™.",
    matrixAudience: "System Architects",
    matrixFormat: "Advisory",
    matrixTopic: "#12 The G.E.A.R. Model: From Awareness to Referral",
    catalogLink: "/services/speaking-topics?track=systems",
    ctaLink: "/work-with-tiffany?topic=The+GEAR+Model&track=Human-Centered+Systems+%26+Services&audience=System+Architects"
  },
  {
    num: "04",
    id: "youth-leadership",
    trackParam: "youth",
    name: "Purpose, Leadership & Youth Impact",
    color: "#6C2D5A",
    borderColor: "rgba(108, 45, 90, 0.5)",
    bgGlow: "rgba(108, 45, 90, 0.18)",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>`,
    tag: "5 Topics · Youth & Purpose",
    desc: "Youth digital safeguards, motivational interviewing, family systems, and wearable advocacy campaigns.",
    matrixAudience: "Schools & Youth Organizations",
    matrixFormat: "Youth Program / Workshop",
    matrixTopic: "Healthy Gaming & Sports",
    catalogLink: "/services/speaking-topics?track=youth",
    ctaLink: "/work-with-tiffany?topic=healthy-gaming-sports&track=Purpose%2C+Leadership+%26+Youth+Impact&audience=Schools+%26+Youth+Organizations"
  }
];
---

<section class="speaking-section theme-ink relative overflow-hidden" id="speaking-tracks">
  <Waveform opacity={0.04} flipY={true} />
  
  <div class="container relative z-10" style="max-width: 1240px; margin: 0 auto;">
    
    <!-- Section Header -->
    <div class="speaking-header reveal-up">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      {headline && <h2 class="section-title" set:html={headline}></h2>}
      {subtext && <p class="speaking-sub">{subtext}</p>}
    </div>

    <!-- Interactive 3D Flip Cards Grid (Organizer Booking Matrix) -->
    <div class="tracks-grid stagger-group">
      {tracks.map((track) => (
        <div class="flip-card-wrapper stagger-item" data-track-id={track.id}>
          <div class="flip-card" onclick="this.classList.toggle('is-flipped')">
            <div class="flip-card-inner">
              
              <!-- Front Face -->
              <div class="flip-card-face flip-card-front" style={`border-color: ${track.borderColor};`}>
                <div class="card-glow" style={`background: ${track.bgGlow};`}></div>
                <div class="card-top">
                  <span class="track-num">{track.num}</span>
                  <div class="track-icon" style={`color: ${track.color};`} set:html={track.icon}></div>
                </div>
                <div class="card-body">
                  <span class="track-tag">{track.tag}</span>
                  <h3 class="track-name">{track.name}</h3>
                  <p class="track-desc">{track.desc}</p>
                </div>
                <div class="card-footer">
                  <a href={track.catalogLink} class="explore-track-btn" onclick="event.stopPropagation();">
                    Explore Track Topics &rarr;
                  </a>
                </div>
              </div>

              <!-- Back Face: Organizer Booking Matrix Layout -->
              <div class="flip-card-face flip-card-back" style={`border-color: ${track.borderColor};`}>
                <div class="card-glow" style={`background: ${track.bgGlow};`}></div>
                <div class="back-header">
                  <span class="back-eyebrow">ORGANIZER BOOKING MATRIX</span>
                  <h4 class="back-track-name">{track.name}</h4>
                </div>
                
                <div class="matrix-content">
                  <div class="matrix-item">
                    <span class="matrix-label">AUDIENCE</span>
                    <span class="matrix-value">{track.matrixAudience}</span>
                  </div>

                  <div class="matrix-item">
                    <span class="matrix-label">FORMAT</span>
                    <span class="matrix-badge">{track.matrixFormat}</span>
                  </div>

                  <div class="matrix-item">
                    <span class="matrix-label">FEATURED SESSION</span>
                    <span class="matrix-topic-title">{track.matrixTopic}</span>
                  </div>
                </div>

                <div class="back-footer">
                  <a href={track.ctaLink} class="btn-start-conv" onclick="event.stopPropagation();">
                    Start a Conversation &rarr;
                  </a>
                </div>
              </div>

            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Footer Action -->
    <div class="speaking-footer reveal-up mt-14 text-center">
      <a href="/services/speaking-topics" class="explore-all-link">
        VIEW ALL 20 SIGNATURE SPEAKING TOPICS &rarr;
      </a>
    </div>

  </div>
</section>

<style>
  .speaking-section {
    padding: 7rem 1.5rem;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .speaking-header {
    text-align: center;
    max-width: 840px;
    margin: 0 auto 3.5rem auto;
  }

  .speaking-sub {
    font-size: 1.15rem;
    color: rgba(251, 246, 234, 0.85);
    line-height: 1.6;
    margin-top: 1rem;
  }

  /* 3D Flip Card Grid */
  .tracks-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .tracks-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .tracks-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .flip-card-wrapper {
    perspective: 1200px;
    height: 440px;
  }

  .flip-card {
    width: 100%;
    height: 100%;
    cursor: pointer;
    position: relative;
  }

  .flip-card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  .flip-card.is-flipped .flip-card-inner,
  .flip-card-wrapper:hover .flip-card-inner {
    transform: rotateY(180deg);
  }

  .flip-card-face {
    position: absolute;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 20px;
    background: rgba(20, 18, 14, 0.75);
    backdrop-filter: blur(16px);
    border: 1px solid;
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.4);
    box-sizing: border-box;
  }

  .card-glow {
    position: absolute;
    top: -30%;
    right: -30%;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    filter: blur(40px);
    pointer-events: none;
    z-index: 0;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .track-num {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-gold, #D9A23A);
  }

  .card-body {
    position: relative;
    z-index: 1;
    margin: 1rem 0;
  }

  .track-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-gold, #D9A23A);
    display: block;
    margin-bottom: 0.4rem;
  }

  .track-name {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.25;
    color: var(--color-ivory, #FBF6EA);
    margin: 0 0 0.6rem 0;
  }

  .track-desc {
    font-size: 0.86rem;
    line-height: 1.5;
    color: rgba(251, 246, 234, 0.8);
    margin: 0;
  }

  .card-footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 0.85rem;
  }

  .explore-track-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-gold, #D9A23A);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .explore-track-btn:hover {
    opacity: 0.85;
    transform: translateX(3px);
  }

  /* Back Face (Organizer Matrix) */
  .flip-card-back {
    transform: rotateY(180deg);
  }

  .back-header {
    position: relative;
    z-index: 1;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 0.6rem;
  }

  .back-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--color-gold, #D9A23A);
    display: block;
  }

  .back-track-name {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: #ffffff;
    margin: 0.2rem 0 0 0;
    line-height: 1.2;
  }

  .matrix-content {
    position: relative;
    z-index: 1;
    margin: 0.8rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .matrix-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .matrix-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--color-gold, #D9A23A);
    text-transform: uppercase;
  }

  .matrix-value {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ivory, #FBF6EA);
  }

  .matrix-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(251, 246, 234, 0.85);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    display: inline-block;
    width: fit-content;
  }

  .matrix-topic-title {
    font-size: 0.85rem;
    line-height: 1.35;
    color: #ffffff;
    font-family: var(--font-serif);
    font-style: italic;
  }

  .back-footer {
    position: relative;
    z-index: 1;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .btn-start-conv {
    display: block;
    width: 100%;
    text-align: center;
    background: var(--color-gold, #D9A23A);
    color: #0D0C08 !important;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.65rem 0.85rem;
    border-radius: 100px;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .btn-start-conv:hover {
    background: #e5b045;
    transform: translateY(-2px);
    box-shadow: 0 6px 15px rgba(217, 162, 58, 0.35);
  }

  .speaking-footer {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    width: 100%;
    margin-top: 3.5rem;
  }

  .explore-all-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--color-gold, #D9A23A);
    text-decoration: none;
    border-bottom: 2px solid var(--color-gold, #D9A23A);
    padding-bottom: 4px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .explore-all-link:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }
</style>
