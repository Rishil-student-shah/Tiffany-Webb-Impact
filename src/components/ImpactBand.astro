---
const { collections = {} } = Astro.props;

const fallbackItems = [
  { title: "PEOPLE AT THE CENTER", icon_svg: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>` },
  { title: "FAMILIES STRENGTHENED", icon_svg: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>` },
  { title: "COMMUNITIES EMPOWERED", icon_svg: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>` },
  { title: "IMPACT THAT LASTS", icon_svg: `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>` }
];

const items = (collections.impact_band && collections.impact_band.length > 0)
  ? collections.impact_band
  : fallbackItems;
---

<section class="impact-band theme-ink" aria-label="Impact Core Focus Areas">
  <div class="band-container">
    {items.map((item) => (
      <div class="band-item">
        {item.icon_svg && <div class="band-icon" set:html={item.icon_svg}></div>}
        <div class="band-title">{item.title}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .impact-band {
    width: 100%;
    background: #181712;
    border-top: 1px solid rgba(217, 162, 58, 0.2);
    border-bottom: 1px solid rgba(217, 162, 58, 0.2);
    padding: 2.25rem 1.5rem;
    position: relative;
    z-index: 10;
  }

  .band-container {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-6) var(--sp-2);
  }

  .band-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
  }

  /* Desktop layout: 4 columns with vertical hairline dividers */
  @media (min-width: 1024px) {
    .impact-band {
      padding: 2.25rem 1.5rem;
    }
    
    .band-container {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }

    .band-item {
      flex-direction: row;
      gap: 0.75rem;
      border-right: 1px solid rgba(217, 162, 58, 0.25);
      padding: 0 var(--sp-4);
    }

    .band-item:last-child {
      border-right: none;
    }
  }

  .band-icon {
    color: var(--color-gold, #D9A23A);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: 0.25rem;
    opacity: 0.95;
  }
  
  .band-icon :global(svg) {
    width: 22px;
    height: 22px;
    display: block;
  }

  .band-title {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    color: #F3C56E;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.4;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }
</style>
