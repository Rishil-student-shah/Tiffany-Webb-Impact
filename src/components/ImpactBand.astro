---
const { collections = {} } = Astro.props;
const items = collections.impact_band || [];
---

{items.length > 0 && (
<section class="impact-band theme-ink" aria-label="Impact Core Focus Areas">
  <div class="band-container">
    {items.map((item, index) => (
      <div class="band-item">
        <div class="band-icon" set:html={item.icon_svg}></div>
        <div class="band-title">{item.title}</div>
      </div>
    ))}
  </div>
</section>
)}

<style>
  .impact-band {
    width: 100%;
    padding: var(--sp-8) var(--sp-4);
    position: relative;
    z-index: 10;
  }

  .band-container {
    max-width: 1440px;
    margin: 0 auto;
    display: grid;
    /* Stack two-by-two on mobile */
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-6) var(--sp-2);
  }

  .band-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
  }

  /* Desktop layout: 4 columns with vertical hairline dividers */
  @media (min-width: 1024px) {
    .impact-band {
      padding: var(--sp-6) var(--sp-4);
    }
    
    .band-container {
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
    }

    .band-item {
      flex-direction: row;
      gap: 0.75rem;
      border-right: 1px solid rgba(217, 162, 58, 0.25);
      padding: 0 var(--sp-4);
    }

    .band-item:last-child {
      border-right: none;
    }
  }

  .band-icon {
    color: var(--color-gold, #D9A23A);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    margin-right: 0.25rem;
    opacity: 0.95;
  }
  
  .band-icon :global(svg) {
    width: 22px;
    height: 22px;
    display: block;
  }

  .band-title {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    color: #F3C56E;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    line-height: 1.4;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }
</style>
