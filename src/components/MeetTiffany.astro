---
import Waveform from './Waveform.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import { Image } from 'astro:assets';
import aboutImg from '../assets/tiffany_about_new.jpg';

const { content = {}, collections = {} } = Astro.props;
const meet_tiffany_cards = collections.meet_tiffany || [];

// Fallbacks
const eyebrow = content.eyebrow || "Meet Tiffany";
const title1 = content.title_line_1 || "Chicago soul,";
const title2 = content.title_line_2 || "Louisiana heart.";
const p1 = content.paragraph_1 || "Chicago-born and raised...";
const p2 = content.paragraph_2 || "She brings a rare combination...";
const p3 = content.paragraph_3 || "Her approach bridges...";
const btn = content.button_text || "READ HER FULL STORY →";
---

<section class="meet-tiffany theme-ink reveal-up">
  <Waveform opacity={0.06} flipX={true} variant="B" />
  <div class="meet-container">
    <div class="meet-grid">
      <div class="meet-content meet-glass-card">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2 class="section-title">{title1} <br/><span class="italic-accent">{title2}</span></h2>
        
        <div class="meet-prose">
          <p>{p1}</p>
          <p>{p2}</p>
          <p>{p3}</p>
        </div>
        
        <div class="meet-cta">
          <Button href="/about" variant="secondary" className="magnetic-btn">{btn}</Button>
        </div>
      </div>
      
      <div class="meet-image-col">
        <div class="meet-image-glass-offset"></div>
        <div class="meet-image-wrap">
          {content.image ? (
            <img src={content.image} alt="Tiffany Webb editorial portrait" class="meet-img" />
          ) : (
            <Image src={aboutImg} alt="Tiffany Webb editorial portrait" class="meet-img" />
          )}
        </div>
      </div>
    </div>

    <!-- The Three Vignettes -->
    {meet_tiffany_cards.length > 0 && (
    <div class="meet-vignettes mt-40">
      <div class="vignettes-grid">
        {meet_tiffany_cards.map((card, index) => (
          <div class="vignette-card ultra-glass-card stagger-item" style={`transition-delay: ${index * 0.1}s;`}>
            <div class="ultra-padding-wrapper">
              <div class="card-icon">{card.subtitle || `0${index + 1}`}</div>
              <h3 class="card-title">{card.title}</h3>
              <p class="card-text">{card.content_html}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
    )}
  </div>
</section>

<style>
  .meet-tiffany {
    padding-top: var(--sp-16);
    padding-bottom: 5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
  }

  .meet-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  .meet-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .meet-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-24);
    }
  }
  
  /* Text Glass Card */
  .meet-glass-card {
    background: rgba(20, 18, 14, 0.45);
    backdrop-filter: blur(16px) saturate(120%);
    -webkit-backdrop-filter: blur(16px) saturate(120%);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    padding: var(--sp-12);
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    position: relative;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
    transform-style: preserve-3d;
    transform: translateZ(0);
    backface-visibility: hidden;
    will-change: transform, backdrop-filter;
  }
  
  .meet-glass-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 0 30px 60px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.2);
    border: 1px solid rgba(255,255,255,0.2);
  }

  .meet-prose {
    margin-bottom: var(--sp-8);
  }
  /* Matching Hero Typography */
  .meet-prose p {
    font-size: 1.125rem;
    color: #e7e0cf;
    font-weight: 400;
    line-height: 1.66;
  }
  
  .meet-cta {
    margin-top: var(--sp-8);
  }

  /* Unique Asymmetrical Photo Treatment */
  .meet-image-col {
    position: relative;
    padding: 20px; 
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 1000px;
  }
  
  .meet-image-wrap {
    width: 100%;
    max-width: 440px;
    aspect-ratio: 4/5;
    border-radius: 200px 16px 200px 16px; /* Asymmetrical Leaf Shape */
    overflow: hidden;
    position: relative;
    border: 1px solid var(--color-gold);
    z-index: 2;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }
  
  .meet-image-glass-offset {
    position: absolute;
    top: 40px;
    left: calc(50% - 200px); /* rough centering offset */
    width: 100%;
    max-width: 440px;
    aspect-ratio: 4/5;
    background: rgba(20, 18, 14, 0.3);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 200px 16px 200px 16px; /* Echoes the shape */
    z-index: 1;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.8s ease;
  }

  @media (min-width: 1024px) {
    .meet-image-glass-offset {
      left: 10%; /* Adjust for desktop grid */
    }
  }

  .meet-image-col:hover .meet-image-wrap {
    transform: translate(-15px, -15px) rotate(-1.5deg);
  }
  
  .meet-image-col:hover .meet-image-glass-offset {
    transform: translate(15px, 15px) rotate(2deg);
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  }
  
  .meet-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  
  .meet-image-col:hover .meet-img {
    transform: scale(1.08);
  }

  .mt-40 {
    margin-top: 10rem;
  }

  .vignettes-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }

  @media (min-width: 768px) {
    .vignettes-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .vignette-card {
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .card-icon {
    font-family: var(--font-mono);
    color: var(--color-gold);
    font-size: 1.125rem;
    margin-bottom: var(--sp-6);
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--color-ivory);
    margin-bottom: var(--sp-4);
  }

  .card-text {
    color: rgba(231, 224, 207, 0.85);
    font-size: 1.05rem;
    line-height: 1.6;
  }
</style>
