---
import Waveform from './Waveform.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';
import aboutImg from '../assets/tiffany_about_new.jpg';

const { content = {} } = Astro.props;

// Fallbacks
const eyebrow = content.eyebrow ?? "MEET TIFFANY";
const title1 = content.title_line_1 ?? "Chicago Heart ,";
const title2 = content.title_line_2 ?? "Louisiana Soul";

let displayTitle1 = title1;
let displayTitle2 = title2;
if ((!displayTitle1 || displayTitle1 === "") && displayTitle2) {
  if (displayTitle2.includes(',')) {
    const parts = displayTitle2.split(',');
    displayTitle1 = parts[0] + ' ,';
    displayTitle2 = parts.slice(1).join(',').trim();
  } else if (displayTitle2.includes('×') || displayTitle2.includes('\u00D7') || displayTitle2.includes('&')) {
    const parts = displayTitle2.split(/[×\u00D7&]/);
    displayTitle1 = parts[0].trim() + ' ,';
    displayTitle2 = parts.slice(1).join(' ').trim();
  } else {
    const words = displayTitle2.split(' ');
    if (words.length > 1) {
      const mid = Math.ceil(words.length / 2);
      displayTitle1 = words.slice(0, mid).join(' ') + ' ';
      displayTitle2 = words.slice(mid).join(' ');
    }
  }
}

const p1 = content.paragraph_1 ?? "I came to this work through behavioral health, but I stayed because I kept meeting families who had never been given language for what was happening to them.";
const p2 = content.paragraph_2 ?? "A father who couldn't explain where the money went. A student who thought a betting app was just a game. A wife who assumed she was the only one.";
const p3 = content.paragraph_3 ?? "Today, my work extends beyond prevention into how organizations reach people at all.";
const btn = content.button_text ?? "More about me \u2192";
const frameStyle = content.image_frame_style || 'shape-meet-arch';
---

<section class="meet-tiffany theme-ink reveal-up">
  <Waveform opacity={0.06} flipX={true} variant="B" />
  <div class="meet-container">
    <div class="meet-grid">
      <div class="meet-content meet-glass-card">
        {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
        <h2 class="section-title meet-title">
          <span style="color: var(--color-ivory);">{displayTitle1}</span> <span class="italic-accent">{displayTitle2}</span>
        </h2>
        
        <div class="meet-prose">
          {p1 && <p>{p1}</p>}
          {p2 && <p>{p2}</p>}
          {p3 && <p>{p3}</p>}
        </div>
        
        {btn && <div class="meet-cta"><Button href="/about" variant="secondary" className="magnetic-btn">{btn}</Button></div>}
      </div>
      
      <div class="meet-image-col">
        <div class={`meet-image-glass-offset ${frameStyle}`}></div>
        <div class={`meet-image-wrap ${frameStyle}`}>
          {content.image ? (
            <img src={content.image} alt="Tiffany Webb editorial portrait" class="meet-img" />
          ) : (
            <img src={aboutImg.src} alt="Tiffany Webb editorial portrait" class="meet-img" />
          )}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .meet-tiffany {
    padding: var(--sp-24) 0;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .meet-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  .meet-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .meet-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: var(--sp-16);
    }
  }
  

  /* Text Glass Card */
  .meet-glass-card {
    background: rgba(255, 255, 255, 0.04); /* Light frosted background so it pops */
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 24px;
    padding: var(--sp-12);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
    position: relative;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease, border-color 0.6s ease;
    transform-style: preserve-3d;
    transform: translateZ(0);
    backface-visibility: hidden;
    will-change: transform, backdrop-filter;
  }
  
  .meet-glass-card:hover {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 32px 70px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.2);
    border-color: rgba(217, 162, 58, 0.4); /* Subtle gold rim on hover */
  }

  .meet-title {
    font-size: clamp(3rem, 5vw, 4.5rem); 
    line-height: 1.1; 
    margin-bottom: var(--sp-8);
  }

  .meet-prose {
    margin-bottom: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  
  .meet-prose p {
    font-size: 1.15rem;
    color: #e7e0cf;
    font-weight: 400;
    line-height: 1.66;
    max-width: 52ch;
  }
  
  .meet-cta {
    margin-top: var(--sp-8);
  }

  /* Soft-cornered arch frame */
  .meet-image-col {
    position: relative;
    padding: 20px; 
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 1000px;
  }
  
  .meet-image-wrap {
    width: 100%;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--color-gold);
    z-index: 2;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), border-radius 0.5s ease;
  }
  
  .meet-image-glass-offset {
    position: absolute;
    top: 40px;
    left: calc(50% - 200px); 
    width: 100%;
    background: rgba(20, 18, 14, 0.3);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255,255,255,0.15);
    z-index: 1;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.8s ease, border-radius 0.5s ease;
  }

  /* 1. Cathedral Arch */
  .meet-image-wrap.shape-hero-arch, .meet-image-glass-offset.shape-hero-arch {
    border-radius: 999px 999px 16px 16px;
    aspect-ratio: 4 / 5;
    max-width: 440px;
  }

  /* 2. Soft Editorial Arch (Meet Tiffany Default) */
  .meet-image-wrap.shape-meet-arch, .meet-image-glass-offset.shape-meet-arch {
    border-radius: 300px 300px 16px 16px;
    aspect-ratio: 3.5 / 5;
    max-width: 440px;
  }

  /* 3. Modern Wide Landscape */
  .meet-image-wrap.shape-landscape, .meet-image-glass-offset.shape-landscape {
    border-radius: 20px;
    aspect-ratio: 16 / 9;
    max-width: 580px;
  }

  /* 4. Classic Portrait */
  .meet-image-wrap.shape-portrait, .meet-image-glass-offset.shape-portrait {
    border-radius: 20px;
    aspect-ratio: 3 / 4;
    max-width: 440px;
  }

  /* 5. Luxury Square */
  .meet-image-wrap.shape-square, .meet-image-glass-offset.shape-square {
    border-radius: 20px;
    aspect-ratio: 1 / 1;
    max-width: 460px;
  }

  /* 6. Adaptive */
  .meet-image-wrap.shape-adaptive, .meet-image-glass-offset.shape-adaptive {
    border-radius: 20px;
    aspect-ratio: auto;
    max-width: 540px;
  }

  @media (min-width: 1024px) {
    .meet-image-glass-offset {
      left: 10%; 
    }
  }

  .meet-image-col:hover .meet-image-wrap {
    transform: translate(-15px, -15px) rotate(-1.5deg);
  }
  
  .meet-image-col:hover .meet-image-glass-offset {
    transform: translate(15px, 15px) rotate(2deg);
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
  }
  
  .meet-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  
  .meet-image-col:hover .meet-img {
    transform: scale(1.08);
  }
</style>
