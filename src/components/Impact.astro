---
import Waveform from './Waveform.astro';
import Eyebrow from './Eyebrow.astro';
---

<section id="impact" class="impact section-pad theme-ink">
  <Waveform opacity={0.06} />
  <div class="container stagger-group">
    <div class="impact-content stagger-item">
      <Eyebrow>Where she works</Eyebrow>
      <h2 class="section-title">Prevention that <span class="italic-accent">reaches people.</span></h2>
      <p class="impact-prose">The communities most affected by gambling harm are often the ones prevention reaches last. Tiffany's work is built to close that gap — with cultural fluency, frontline experience, and evidence behind every session.</p>
    </div>
    
    <div class="impact-list-wrap">
      <ul class="impact-list">
        <li class="impact-item stagger-item">
          <span class="impact-num">01 //</span>
          <span class="impact-name">Conferences</span>
        </li>
        <li class="impact-item stagger-item">
          <span class="impact-num">02 //</span>
          <span class="impact-name">Schools & Universities</span>
        </li>
        <li class="impact-item stagger-item">
          <span class="impact-num">03 //</span>
          <span class="impact-name">Healthcare Systems</span>
        </li>
        <li class="impact-item stagger-item">
          <span class="impact-num">04 //</span>
          <span class="impact-name">Government & Public Health</span>
        </li>
        <li class="impact-item stagger-item">
          <span class="impact-num">05 //</span>
          <span class="impact-name">Community Organizations</span>
        </li>
        <li class="impact-item stagger-item">
          <span class="impact-num">06 //</span>
          <span class="impact-name">Nonprofits</span>
        </li>
        <li class="impact-item stagger-item">
          <span class="impact-num">07 //</span>
          <span class="impact-name">Behavioral Health Providers</span>
        </li>
        <li class="impact-item stagger-item">
          <span class="impact-num">08 //</span>
          <span class="impact-name">Recovery Networks</span>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .impact {
    position: relative;
    z-index: 2;
    background: var(--glow-gradient);
  }
  
  .section-pad {
    padding: var(--sp-24) 0;
  }
  
  .container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
  }

  @media (min-width: 1024px) {
    .container {
      grid-template-columns: 1fr 1.2fr;
      align-items: start;
    }
  }

  .impact-title {
    margin-bottom: var(--sp-6);
  }

  .impact-prose {
    font-size: 1.125rem;
    color: #e7e0cf; /* Warmer ivory from hero */
    font-weight: 400;
    line-height: 1.66;
  }

  /* Editorial List Styles */
  .impact-list-wrap {
    width: 100%;
  }

  .impact-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 768px) {
    .impact-list {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--sp-12);
      border-top: none;
    }
  }

  .impact-item {
    position: relative;
    padding: var(--sp-6) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    transition: padding-left 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease;
  }
  
  @media (min-width: 768px) {
    .impact-item:nth-child(1), .impact-item:nth-child(2) {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  .impact-num {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-gold);
    opacity: 0.6;
    transition: opacity 0.4s ease;
    white-space: nowrap;
  }

  .impact-name {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--color-ivory);
    transition: all 0.4s ease;
    position: relative;
    z-index: 2;
    line-height: 1.2;
  }

  /* Hover Effects */
  .impact-item:hover {
    padding-left: var(--sp-3);
    border-bottom-color: rgba(255, 255, 255, 0.3);
  }

  .impact-item:hover .impact-num {
    opacity: 1;
  }

  .impact-item:hover .impact-name {
    background: linear-gradient(92deg, var(--color-mustard), var(--color-coral), var(--color-berry));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    transform: scale(1.02);
    transform-origin: left center;
  }
</style>
