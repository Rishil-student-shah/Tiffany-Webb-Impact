---
import Waveform from './Waveform.astro';
import Eyebrow from './Eyebrow.astro';

const { content = {}, collections = {} } = Astro.props;

const fallbackAudiences = [
  { 
    num: "01", 
    title: "Conferences & Professional Associations", 
    desc: "Keynotes, breakout sessions, and expert panels for national summits, annual conferences, and professional associations.",
    badge: "01 // CONFERENCES",
    link: "/work-with-tiffany?ref_section=Homepage+-+Audience+Groups&ref_card=Conferences+%26+Professional+Associations&audience=Conferences+%26+Professional+Associations"
  },
  { 
    num: "02", 
    title: "Schools & Youth Organizations", 
    desc: "Age-appropriate youth prevention, interactive workshops, and family engagement around digital risk and healthy choices.",
    badge: "02 // YOUTH & SCHOOLS",
    link: "/work-with-tiffany?ref_section=Homepage+-+Audience+Groups&ref_card=Schools+%26+Youth+Organizations&audience=Schools+%26+Youth+Organizations"
  },
  { 
    num: "03", 
    title: "Colleges & Universities", 
    desc: "Campus-wide wellness activations, athletic department sessions, student affairs programming, and Greek life dialogues.",
    badge: "03 // HIGHER ED",
    link: "/work-with-tiffany?ref_section=Homepage+-+Audience+Groups&ref_card=Colleges+%26+Universities&audience=Colleges+%26+Universities"
  },
  { 
    num: "04", 
    title: "Healthcare & Hospital Systems", 
    desc: "Hospitals, primary care networks, clinical teams, and health systems integrating validated gambling screening protocols.",
    badge: "04 // HEALTHCARE",
    link: "/work-with-tiffany?ref_section=Homepage+-+Audience+Groups&ref_card=Healthcare+%26+Hospital+Systems&audience=Healthcare+%26+Hospital+Systems"
  },
  { 
    num: "05", 
    title: "Government & Public Health", 
    desc: "Municipal health agencies, public health departments, county boards, and prevention policy task forces.",
    badge: "05 // PUBLIC HEALTH",
    link: "/work-with-tiffany?ref_section=Homepage+-+Audience+Groups&ref_card=Government+%26+Public+Health&audience=Government+%26+Public+Health"
  },
  { 
    num: "06", 
    title: "Behavioral Health Providers", 
    desc: "Clinicians, addiction counselors, social workers, and mental health frontline teams managing co-occurring risks.",
    badge: "06 // CLINICIANS",
    link: "/work-with-tiffany?ref_section=Homepage+-+Audience+Groups&ref_card=Behavioral+Health+Providers&audience=Behavioral+Health+Providers"
  },
  { 
    num: "07", 
    title: "Recovery Networks", 
    desc: "Peer-support organizations, recovery community organizations (RCOs), and grassroots harm-reduction initiatives.",
    badge: "07 // RECOVERY",
    link: "/work-with-tiffany?ref_section=Homepage+-+Audience+Groups&ref_card=Recovery+Networks&audience=Recovery+Networks"
  },
  { 
    num: "08", 
    title: "Community Coalitions & ROSC Councils", 
    desc: "Recovery Oriented Systems of Care (ROSC) councils, prevention coalitions, and regional cross-sector partnerships.",
    badge: "08 // COALITIONS",
    link: "/work-with-tiffany?ref_section=Homepage+-+Audience+Groups&ref_card=Community+Coalitions+%26+ROSC+Councils&audience=Community+Coalitions+%26+ROSC+Councils"
  },
  { 
    num: "09", 
    title: "Community Organizations & Nonprofits", 
    desc: "Mission-driven neighborhood groups, civic organizations, and community health centers serving local families.",
    badge: "09 // NONPROFITS",
    link: "/work-with-tiffany?ref_section=Homepage+-+Audience+Groups&ref_card=Community+Organizations+%26+Nonprofits&audience=Community+Organizations+%26+Nonprofits"
  },
  { 
    num: "10", 
    title: "Faith Communities", 
    desc: "Churches, ministries, faith networks, and faith-based community outreach programs offering compassionate support.",
    badge: "10 // FAITH",
    link: "/work-with-tiffany?ref_section=Homepage+-+Audience+Groups&ref_card=Faith+Communities&audience=Faith+Communities"
  }
];

const rawAudiences = (collections.who_can_benefit && collections.who_can_benefit.length > 0)
  ? collections.who_can_benefit
  : (collections.where_she_works && collections.where_she_works.length > 0)
    ? collections.where_she_works
    : fallbackAudiences;

const audiences = rawAudiences.map((c) => ({
  ...c,
  link: c.link_url || `/work-with-tiffany?ref_section=Homepage+-+Audience+Groups&ref_card=${encodeURIComponent(c.title)}&audience=${encodeURIComponent(c.title)}`
}));

const eyebrow = content.eyebrow ?? "WHO CAN BENEFIT FROM TIFFANY'S WORK?";
let headline = content.headline ?? "For leaders ready to <span class=\"italic-accent\">rethink what's possible.</span>";
if (headline && !headline.includes('<span')) {
  if (headline.includes("rethink")) {
    headline = headline.replace("rethink what's possible", "<span class=\"italic-accent\">rethink what's possible.</span>").replace("rethink what's possible.", "<span class=\"italic-accent\">rethink what's possible.</span>").replace('..', '.');
  } else {
    const words = headline.split(' ');
    if (words.length > 2) {
      const mid = Math.ceil(words.length / 2);
      headline = words.slice(0, mid).join(' ') + ' <span class="italic-accent">' + words.slice(mid).join(' ') + '</span>';
    }
  }
}
const p1 = content.body_1 ?? "Communities most affected by gambling harm can also be among the hardest for traditional prevention efforts to reach. Tiffany's work is built to help close that gap — with cultural fluency, frontline experience, creativity, and evidence-informed strategies that make prevention easier to understand, access, and act on.";
const p2 = content.body_2 ?? "";
---

<section id="where-she-works" class="where-works section-pad theme-ink relative" style="padding-top: 7rem; padding-bottom: 7rem; overflow: hidden;">
  <!-- Waveform placed softly behind -->
  <Waveform opacity={0.03} variant="B" flipY={true} />
  
  <div class="container relative z-10" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
    
    <!-- Centered Header Section -->
    <div class="works-header reveal-up text-center">
      <Eyebrow className="justify-center text-center">{eyebrow}</Eyebrow>
      
      <h2 class="section-title works-title text-center" set:html={headline}></h2>
      
      <p class="works-subtitle text-center mx-auto">
        {p1}
      </p>
      {p2 && <p class="works-subtitle text-center mx-auto mt-3">{p2}</p>}
    </div>
    
    <!-- 10 Audiences 2-Column Balanced Grid -->
    <div class="works-audiences reveal-up" style="transition-delay: 0.1s; margin-top: 4rem;">
      <div class="audience-list">
        {audiences.map((aud, index) => {
          const num = (index + 1).toString().padStart(2, '0');
          return (
            <a href={aud.link} class="audience-item" style="text-decoration: none;">
              <div class="audience-num">{num} <span class="num-slash">//</span></div>
              <div class="audience-title">{aud.title}</div>
            </a>
          );
        })}
      </div>
      
      <div class="works-bottom-action text-center">
        <a href="/services" class="how-i-help-link">How I help &rarr;</a>
      </div>
    </div>
    
  </div>
</section>

<style>
  .works-header {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .works-title {
    font-size: clamp(2.4rem, 4vw, 3.8rem);
    line-height: 1.15;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    color: var(--color-ivory, #FBF6EA);
    text-align: center;
  }

  .works-subtitle {
    font-size: 1.15rem;
    color: rgba(251, 246, 234, 0.85);
    line-height: 1.65;
    max-width: 780px;
    text-align: center;
    margin: 0 auto;
  }

  /* Audiences Grid */
  .audience-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 3.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .audience-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .audience-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: border-color 0.25s ease;
  }

  .audience-num {
    color: #F3C56E;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }
  
  .num-slash {
    color: var(--color-gold);
    font-size: 0.82rem;
    font-weight: 700;
    opacity: 0.7;
  }

  .audience-title {
    color: var(--color-ivory);
    font-size: 1.35rem;
    font-family: var(--font-serif);
    line-height: 1.3;
    font-weight: 400;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .audience-item:hover .audience-title {
    color: var(--color-gold);
    transform: translateX(4px);
  }

  .works-bottom-action {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 3.5rem;
  }

  .how-i-help-link {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #F3C56E;
    text-decoration: none;
    border-bottom: 2px solid #F3C56E;
    padding-bottom: 6px;
    transition: opacity 0.2s, transform 0.2s;
    text-shadow: 0 1px 2px rgba(0,0,0,0.6);
    display: inline-flex;
    align-items: center;
  }

  .how-i-help-link:hover {
    opacity: 0.8;
    transform: translateY(-1px);
  }
</style>
