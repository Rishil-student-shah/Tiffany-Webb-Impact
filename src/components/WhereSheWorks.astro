---
import Waveform from './Waveform.astro';
import Eyebrow from './Eyebrow.astro';

const { content = {}, collections = {} } = Astro.props;
const audiences = collections.who_can_benefit || [];

const eyebrow = content.eyebrow || "WHO CAN BENEFIT FROM TIFFANY'S WORK?";
const headline = content.headline || "For leaders ready to rethink what's possible.";
const p1 = content.body_1 || "Tiffany works with leaders and organizations navigating growth, change, engagement, and community impact. She brings a human-centered perspective to complex challenges—helping organizations understand the people they serve, rethink familiar approaches, and build strategies designed for meaningful, sustainable impact.";
const p2 = content.body_2 || "";

const formattedHeadline = "For leaders ready<br/>to <span class=\"italic-accent\">rethink what's</span><br/><span class=\"italic-accent\">possible.</span>";
---

<section id="where-she-works" class="where-works section-pad theme-ink relative" style="padding-top: 8rem; padding-bottom: 8rem;">
  <Waveform opacity={0.05} variant="B" flipY={true} />
  
  <div class="container relative z-10">
    <div class="works-grid">
      
      <!-- Left Column: Copy -->
      <div class="works-content reveal-up">
        <div style="margin-bottom: 2rem;"><Eyebrow>{eyebrow}</Eyebrow></div>
        <h2 class="section-title" style="font-size: clamp(3.5rem, 5.5vw, 5.5rem); line-height: 1.05; margin-bottom: 3rem; letter-spacing: -0.01em;" set:html={formattedHeadline}></h2>
        
        <div class="works-prose">
          {p1 && <p>{p1}</p>}
          {p2 && <p>{p2}</p>}
        </div>
      </div>
      
      <!-- Right Column: Audiences -->
      <div class="works-audiences reveal-up" style="transition-delay: 0.1s;">
        <div class="audience-list">
          {audiences.map((aud, index) => {
            const num = (index + 1).toString().padStart(2, '0');
            return (
              <div class="audience-item" style="padding: 2.5rem 0;">
                <div class="audience-num">{num} <span class="num-slash">//</span></div>
                <div class="audience-title" style="font-size: 1.8rem; font-family: var(--font-serif); line-height: 1.25;">{aud.title}</div>
              </div>
            );
          })}
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  .works-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
  }

  @media (min-width: 1024px) {
    .works-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 6rem;
      align-items: center; /* Vertically centers the left text with the right list */
    }
  }

  /* Left Column Spacing Fixes */
  .works-content {
    display: flex;
    flex-direction: column;
    padding-right: 2rem; /* Extra breathing room horizontally */
  }



  .works-prose {
    max-width: 42ch;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .works-prose p {
    font-size: 1.125rem;
    color: rgba(251, 246, 234, 0.7); /* Ivory dimmed */
    line-height: 1.7;
    font-weight: 400;
  }

  /* Right Column (Audiences) */
  .works-audiences {
    display: flex;
    flex-direction: column;
  }

  .audience-list {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 4rem;
  }

  @media (min-width: 640px) {
    .audience-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .audience-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 2.5rem 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  /* Remove bottom border from the last two items to match the old design */
  @media (min-width: 640px) {
    .audience-item:nth-last-child(-n+2) {
      border-bottom: none;
    }
  }

  .audience-num {
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    width: 3.5rem;
    margin-top: 0.4rem; /* Align with the first line of the serif text */
  }
  
  .num-slash {
    color: rgba(217, 162, 58, 0.4);
    font-size: 0.75rem;
  }

  .audience-title {
    color: var(--color-ivory);
    font-size: 1.8rem;
    font-family: var(--font-serif);
    line-height: 1.25;
    font-weight: 400;
  }
</style>
