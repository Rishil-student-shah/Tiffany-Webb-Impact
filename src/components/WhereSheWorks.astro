---
import Waveform from './Waveform.astro';
import Eyebrow from './Eyebrow.astro';
import Button from './Button.astro';

const { content = {}, collections = {} } = Astro.props;
const audiences = collections.where_she_works || [];

const eyebrow = content.eyebrow || "WHO CAN BENEFIT FROM TIFFANY'S WORK?";
const headline = content.headline || "For leaders ready to rethink what's possible.";
const p1 = content.body_1 || "Tiffany works with leaders and organizations navigating growth, change, engagement, and community impact. She brings a human-centered perspective to complex challenges—helping organizations understand the people they serve, rethink familiar approaches, and build strategies designed for meaningful, sustainable impact.";
const p2 = content.body_2 || "";
const btn = content.button_text || "How I help →";

// Process headline to make "rethink what's possible." italic with gradient
const formattedHeadline = "For leaders ready<br/>to <span class=\"italic-accent\">rethink what's</span><br/><span class=\"italic-accent\">possible.</span>";
---

<section id="where-she-works" class="where-works section-pad theme-ink relative">
  <Waveform opacity={0.05} variant="B" flipY={true} />
  
  <div class="container relative z-10">
    <div class="works-grid">
      
      <!-- Left Column: Copy -->
      <div class="works-content reveal-up">
        <Eyebrow>{eyebrow}</Eyebrow>
        <h2 class="section-title meet-title" set:html={formattedHeadline}></h2>
        
        <div class="works-prose">
          {p1 && <p>{p1}</p>}
          {p2 && <p>{p2}</p>}
        </div>
      </div>
      
      <!-- Right Column: Audiences -->
      <div class="works-audiences reveal-up" style="transition-delay: 0.1s;">
        <div class="audience-list">
          {audiences.map((aud, index) => {
            const num = (index + 1).toString().padStart(2, '0');
            return (
              <div class="audience-item">
                <span class="audience-num">{num} <span class="num-slash">//</span></span>
                <span class="audience-title">{aud.title}</span>
              </div>
            );
          })}
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  .works-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
  }

  @media (min-width: 1024px) {
    .works-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-16);
      align-items: flex-start;
    }
  }

  /* Left Column */
  .meet-title {
    font-size: clamp(3rem, 5vw, 4.5rem); 
    line-height: 1.1; 
    margin-bottom: var(--sp-8);
  }

  .works-prose {
    max-width: 46ch;
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .works-prose p {
    font-size: 1.15rem;
    color: var(--color-ivory);
    line-height: 1.6;
    opacity: 0.9;
  }

  /* Right Column (Audiences) */
  .works-audiences {
    display: flex;
    flex-direction: column;
    padding-top: var(--sp-6);
  }

  .audience-list {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: var(--sp-8);
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  @media (min-width: 640px) {
    .audience-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .audience-item {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-5) 0;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .audience-num {
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    letter-spacing: 0.05em;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  
  .num-slash {
    color: rgba(217, 162, 58, 0.5); /* Dimmer gold for the slashes */
    font-size: 0.8rem;
  }

  .audience-title {
    color: var(--color-ivory);
    font-size: 1rem;
    font-weight: 500;
  }
</style>
