---
import Waveform from './Waveform.astro';
import Eyebrow from './Eyebrow.astro';

const { content = {}, collections = {} } = Astro.props;

const fallbackAudiences = [
  { title: "Healthcare Leaders & Clinical Networks" },
  { title: "Municipal Agencies & Public Health Departments" },
  { title: "ROSC Councils & Recovery Coalitions" },
  { title: "Colleges, Universities & Athletic Programs" },
  { title: "Faith-Based Networks & Community Nonprofits" },
  { title: "Corporate HR & Employee Assistance Programs (EAPs)" },
  { title: "Youth Organizations, Schools & District Leadership" },
  { title: "Policy Makers & Prevention Coalitions" }
];

const audiences = (collections.who_can_benefit && collections.who_can_benefit.length > 0)
  ? collections.who_can_benefit
  : (collections.where_she_works && collections.where_she_works.length > 0)
    ? collections.where_she_works
    : fallbackAudiences;

const eyebrow = content.eyebrow ?? "WHO CAN BENEFIT FROM TIFFANY'S WORK?";
let headline = content.headline ?? "For leaders ready to <span class=\"italic-accent\">rethink what's possible.</span>";
if (headline && !headline.includes('<span')) {
  if (headline.includes("rethink")) {
    headline = headline.replace("rethink what's possible", "<span class=\"italic-accent\">rethink what's possible.</span>").replace("rethink what's possible.", "<span class=\"italic-accent\">rethink what's possible.</span>").replace('..', '.');
  } else {
    const words = headline.split(' ');
    if (words.length > 2) {
      const mid = Math.ceil(words.length / 2);
      headline = words.slice(0, mid).join(' ') + ' <span class="italic-accent">' + words.slice(mid).join(' ') + '</span>';
    }
  }
}
const p1 = content.body_1 ?? "Tiffany works with leaders and organizations navigating growth, change, engagement, and community impact. She brings a human-centered perspective to complex challenges—helping organizations understand the people they serve, rethink familiar approaches, and build strategies designed for meaningful, sustainable impact.";
const p2 = content.body_2 ?? "";
---

<section id="where-she-works" class="where-works section-pad theme-ink relative" style="padding-top: 7rem; padding-bottom: 7rem; overflow: hidden;">
  <!-- Waveform placed softly behind -->
  <Waveform opacity={0.03} variant="B" flipY={true} />
  
  <div class="container relative z-10" style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">
    
    <!-- Centered Header Section -->
    <div class="works-header reveal-up text-center">
      <Eyebrow className="justify-center text-center">{eyebrow}</Eyebrow>
      
      <h2 class="section-title works-title text-center" set:html={headline}></h2>
      
      <p class="works-subtitle text-center mx-auto">
        {p1}
      </p>
      {p2 && <p class="works-subtitle text-center mx-auto mt-3">{p2}</p>}
    </div>
    
    <!-- 8 Audiences 2-Column Balanced Grid -->
    <div class="works-audiences reveal-up" style="transition-delay: 0.1s; margin-top: 4rem;">
      <div class="audience-list">
        {audiences.map((aud, index) => {
          const num = (index + 1).toString().padStart(2, '0');
          return (
            <div class="audience-item">
              <div class="audience-num">{num} <span class="num-slash">//</span></div>
              <div class="audience-title">{aud.title}</div>
            </div>
          );
        })}
      </div>
      
      <div class="works-bottom-action text-center">
        <a href="/services" class="how-i-help-link">How I help &rarr;</a>
      </div>
    </div>
    
  </div>
</section>

<style>
  .works-header {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .works-title {
    font-size: clamp(2.4rem, 4vw, 3.8rem);
    line-height: 1.15;
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    color: var(--color-ivory, #FBF6EA);
    text-align: center;
  }

  .works-subtitle {
    font-size: 1.15rem;
    color: rgba(251, 246, 234, 0.85);
    line-height: 1.65;
    max-width: 780px;
    text-align: center;
    margin: 0 auto;
  }

  /* Audiences Grid */
  .audience-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 3.5rem;
    max-width: 1100px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .audience-list {
      grid-template-columns: 1fr 1fr;
    }
  }

  .audience-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: border-color 0.25s ease;
  }

  .audience-num {
    color: #F3C56E;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }
  
  .num-slash {
    color: var(--color-gold);
    font-size: 0.82rem;
    font-weight: 700;
    opacity: 0.7;
  }

  .audience-title {
    color: var(--color-ivory);
    font-size: 1.35rem;
    font-family: var(--font-serif);
    line-height: 1.3;
    font-weight: 400;
    transition: color 0.25s ease, transform 0.25s ease;
  }

  .audience-item:hover .audience-title {
    color: var(--color-gold);
    transform: translateX(4px);
  }

  .works-bottom-action {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-top: 3.5rem;
  }

  .how-i-help-link {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: #F3C56E;
    text-decoration: none;
    border-bottom: 2px solid #F3C56E;
    padding-bottom: 6px;
    transition: opacity 0.2s, transform 0.2s;
    text-shadow: 0 1px 2px rgba(0,0,0,0.6);
    display: inline-flex;
    align-items: center;
  }

  .how-i-help-link:hover {
    opacity: 0.8;
    transform: translateY(-1px);
  }
</style>
