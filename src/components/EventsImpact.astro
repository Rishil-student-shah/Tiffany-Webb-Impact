---
import Eyebrow from './Eyebrow.astro';
import Waveform from './Waveform.astro';

const { content = {}, collections = {} } = Astro.props;
const allEvents = collections.events || [];
// Limit strictly to maximum 3 cards on the showcase
const events = allEvents.slice(0, 3);

const eyebrow = content.eyebrow ?? "STAGES & IMPACT";
let rawHeadline = content.headline || "Where the work has taken me.";
let headline = rawHeadline.includes('<span')
  ? rawHeadline
  : rawHeadline.replace(/has taken me\.?/i, '<span class="italic-accent">has taken me.</span>');
const btnText = content.btn_text ?? "START A CONVERSATION";
const btnLink = content.btn_link ?? "/work-with-tiffany";
const emptyText = content.empty_text ?? "Next dates announced soon.";
const emptyBtn = content.empty_btn ?? "Book Tiffany";
const linkText = content.link_text ?? "See the full picture";

const gridClass = events.length === 1 ? 'grid-1' : events.length === 2 ? 'grid-2' : 'grid-3';
---

<section id="impact-preview" class="events-impact section-pad theme-ink relative" style="padding-top: 6rem; padding-bottom: 6rem; overflow: hidden;">
  <Waveform opacity={0.03} variant="B" flipY={true} />
  
  <div class="container relative z-10" style="max-width: 1240px; margin: 0 auto; padding-left: 1.5rem; padding-right: 1.5rem; box-sizing: border-box;">
    <div class="events-header">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      {headline && <h2 class="section-title" style="color: var(--color-ivory);" set:html={headline}></h2>}
    </div>

    {events.length === 0 ? (
      /* EMPTY STATE */
      <div class="events-empty-state reveal-up">
        {emptyText && <p class="empty-text">{emptyText}</p>}
        <a href="/work-with-tiffany" class="btn btn-outline-ivory mt-4" id="empty-state-btn">{emptyBtn}</a>
      </div>
    ) : (
      /* POPULATED RESPONSIVE GRID (1, 2, or 3 cards perfectly centered and symmetrical) */
      <div class="events-grid-wrapper reveal-up">
        <div class={`events-grid ${gridClass}`}>
          {events.map((evt) => {
            const status = evt.icon_svg || "Past";
            const format = evt.subtitle || "Keynote";
            const name = evt.title;
            const city = evt.content_html || "City, State";
            const audience = evt.image_url || "500+";
            const link = evt.link_url || "/impact";

            return (
              <div class="event-card ultra-glass-card">
                <div class="event-card-top">
                  <div class="event-meta">
                    <span class={`status-tag ${status.toLowerCase() === 'past' ? 'past' : 'upcoming'}`}>{status}</span>
                    <span class="format-tag">{format}</span>
                  </div>
                  <h3 class="event-name">{name}</h3>
                </div>

                <div class="event-card-bottom">
                  <div class="event-details">
                    <div class="detail-item">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      {city}
                    </div>
                    <div class="detail-item">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                      </svg>
                      {audience} Attendees
                    </div>
                  </div>
                  <a href={link} class="event-link">
                    Event details <span class="arrow">&rarr;</span>
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    )}

    <div class="events-footer reveal-up">
      <a href="/impact" class="text-link">
        {linkText} <span class="arrow">&rarr;</span>
      </a>
      <a href={btnLink} id="populated-book-btn" class="btn-gold-action">
        {btnText}
      </a>
    </div>
  </div>
</section>

<style>
  .events-header {
    text-align: center;
    margin-bottom: 3.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Empty State */
  .events-empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px dashed rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
  }

  .empty-text {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--color-ivory);
    font-weight: 300;
  }

  /* Responsive Grid System for 1, 2, or 3 Cards in ONE HORIZONTAL LINE */
  .events-grid-wrapper {
    width: 100%;
    margin-bottom: 3.5rem;
  }

  .events-grid {
    display: grid;
    gap: 2rem;
    width: 100%;
    margin: 0 auto;
    align-items: stretch;
    box-sizing: border-box;
  }

  .events-grid.grid-3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 1240px;
  }

  .events-grid.grid-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 840px;
  }

  .events-grid.grid-1 {
    grid-template-columns: minmax(0, 1fr);
    max-width: 440px;
  }

  @media (max-width: 860px) {
    .events-grid.grid-3 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .events-grid.grid-3,
    .events-grid.grid-2 {
      grid-template-columns: 1fr;
    }
  }

  /* Unified Card Sizing & Appearance */
  .event-card {
    width: 100%;
    height: 100%;
    min-height: 330px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 24px;
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease, background 0.4s ease;
    box-sizing: border-box;
  }

  .event-card:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(217, 162, 58, 0.4);
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), 0 0 30px rgba(217, 162, 58, 0.06);
  }

  .event-card-top {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .event-meta {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .status-tag {
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    font-weight: 700;
  }

  .status-tag.upcoming {
    background: rgba(217, 162, 58, 0.18);
    color: var(--color-gold, #D9A23A);
    border: 1px solid rgba(217, 162, 58, 0.3);
  }

  .status-tag.past {
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-ivory, #FBF6EA);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .format-tag {
    color: rgba(251, 246, 234, 0.7);
    font-weight: 500;
  }

  .event-name {
    font-family: var(--font-serif);
    font-size: 1.55rem;
    color: var(--color-ivory, #FBF6EA);
    line-height: 1.3;
    font-weight: 400;
    margin: 0;
  }

  .event-card-bottom {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .event-details {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .detail-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: rgba(251, 246, 234, 0.75);
    font-size: 0.92rem;
    font-family: var(--font-sans);
  }

  .detail-item svg {
    width: 16px;
    height: 16px;
    color: var(--color-gold, #D9A23A);
    flex-shrink: 0;
  }

  .event-link {
    color: var(--color-gold, #D9A23A);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 600;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .event-link:hover {
    opacity: 0.8;
    transform: translateX(3px);
  }

  /* Symmetrical Footer Controls */
  .events-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 3rem;
    margin-top: 1rem;
  }

  .text-link {
    color: var(--color-ivory);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    transition: opacity 0.2s;
  }

  .text-link:hover {
    opacity: 0.7;
  }

  .btn-gold-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95rem 2.2rem;
    background: var(--color-gold, #D9A23A);
    color: var(--color-ink, #0D0C08);
    border: 1.5px solid var(--color-gold, #D9A23A);
    border-radius: 100px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 10px 25px rgba(217, 162, 58, 0.25);
  }

  .btn-gold-action:hover {
    background: #e5b045;
    transform: translateY(-2px);
    box-shadow: 0 15px 35px rgba(217, 162, 58, 0.35);
  }
</style>
