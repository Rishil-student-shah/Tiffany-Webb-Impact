---
import Waveform from './Waveform.astro';
import Newsletter from './Newsletter.astro';
import Button from './Button.astro';
import { navLinks, navCta } from '../config/navigation.js';

const year = new Date().getFullYear();
---

<Newsletter />

<footer class="footer theme-ink" style="position: relative;">
  <Waveform opacity={0.06} />
  
  <!-- Values Strip -->
  <div class="values-strip" style="position: relative; z-index: 10; padding: 1.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); background: rgba(0,0,0,0.2); display: flex; justify-content: center; align-items: center; width: 100%;">
    <p style="color: var(--color-gold); font-family: var(--font-mono); font-size: 1.1rem; letter-spacing: 0.15em; text-transform: uppercase; text-align: center; margin: 0;">FAITH &middot; FAMILY &middot; COMMUNITY &middot; PURPOSE &middot; IMPACT</p>
  </div>

  <div class="footer-container" style="position: relative; z-index: 10;">
    <div class="footer-top">
      <div class="footer-brand">
        <h2 class="footer-logo">Tiffany Webb</h2>
        <p class="italic-accent" style="font-family: var(--font-serif); font-size: 1.15rem; margin-top: 0.25rem; white-space: nowrap;">Community Impact Strategist</p>
        <p style="margin-top: 1rem; color: rgba(255,255,255,0.6); font-size: 0.9rem;">
          Chicago, IL<br/>
          Speaking globally.
        </p>
        
        <!-- GambleFreeGear Endorsement -->
        <div style="margin-top: 2rem; padding: 1rem; border-left: 2px solid var(--color-gold); background: rgba(255,255,255,0.03);">
          <p style="font-family: var(--font-sans); font-size: 0.85rem; color: rgba(255,255,255,0.8); line-height: 1.4;">Founder of <strong style="color: var(--color-ivory);">GambleFreeGear</strong>. Reclaiming spaces from gambling harm.</p>
        </div>
      </div>
      
      <div class="footer-navs">
        <div class="footer-col">
          <h3 class="text-micro footer-heading">Explore</h3>
          <ul class="footer-links">
            {navLinks.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </div>
        
        <div class="footer-col">
          <h3 class="text-micro footer-heading">Connect</h3>
          <ul class="footer-links">
            <li><a href="https://linkedin.com/in/tiffanywebb" target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
            <li><a href="https://instagram.com/tiffanywebb" target="_blank" rel="noopener noreferrer">Instagram</a></li>
            <li><a href="https://youtube.com/@tiffanywebb" target="_blank" rel="noopener noreferrer">YouTube</a></li>
            <li><a href="https://tiktok.com/@tiffanywebb" target="_blank" rel="noopener noreferrer">TikTok</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h3 class="text-micro footer-heading">Contact</h3>
          <ul class="footer-links">
            <li>Booking enquiries</li>
            <li><a href="/work-with-tiffany">booking@tiffanywebb.com</a></li>
            <li>Media enquiries welcome.</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="text-micro">&copy; {year} Tiffany Webb. All rights reserved.</p>
      <div class="footer-legal">
        <a href="/privacy" class="text-micro">Privacy Policy</a>
        <a href="/terms" class="text-micro">Terms of Use</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    background: var(--glow-gradient);
    z-index: 10;
  }

  .footer-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--sp-16) var(--sp-6) var(--sp-8);
  }

  .footer-top {
    display: flex;
    flex-direction: column;
    gap: var(--sp-12);
    margin-bottom: var(--sp-16);
  }

  @media (min-width: 1024px) {
    .footer-top {
      flex-direction: row;
      justify-content: space-between;
      gap: var(--sp-24);
    }
  }

  .footer-brand {
    flex: 0 0 auto;
    max-width: 300px;
  }

  .footer-logo {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--color-ivory);
    margin-bottom: var(--sp-2);
  }

  .footer-tagline {
    color: var(--color-gold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer-navs {
    flex: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-12);
    justify-content: space-between;
  }

  .footer-col {
    min-width: 120px;
  }

  .footer-heading {
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: var(--sp-6);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .footer-links li {
    font-size: 0.95rem;
    color: rgba(231, 224, 207, 0.7);
  }

  .footer-links a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--color-gold);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    align-items: center;
    padding-top: var(--sp-8);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.4);
  }

  @media (min-width: 768px) {
    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  .footer-legal {
    display: flex;
    gap: var(--sp-6);
  }

  .footer-legal a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-legal a:hover {
    color: var(--color-parchment);
  }
</style>
