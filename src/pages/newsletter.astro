---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Waveform from '../components/Waveform.astro';
import mysql from 'mysql2/promise';

let dbContent = {};
try {
  const pool = mysql.createPool({ host: 'localhost', user: 'root', password: '@rishil8124shah', database: 'tiffany_crm' });
  const [rows] = await pool.query("SELECT section, key_name, content_value FROM website_content JOIN website_pages ON website_content.page_id = website_pages.id WHERE website_pages.slug = 'newsletter'");
  rows.forEach(row => {
    if (!dbContent[row.section]) dbContent[row.section] = {};
    dbContent[row.section][row.key_name] = row.content_value;
  });
  await pool.end();
} catch (e) {
  console.error("DB Error in newsletter:", e);
}

const hero = dbContent.hero || {};
const form = dbContent.form || {};
let headline = hero.headline || 'Stay in <span class="italic-accent">the loop.</span>';
if (headline && !headline.includes('<span')) {
  const words = headline.split(' ');
  if (words.length > 1) {
    const mid = Math.ceil(words.length / 2);
    headline = words.slice(0, mid).join(' ') + ' <span class="italic-accent">' + words.slice(mid).join(' ') + '</span>';
  }
}
---

<Layout title="Newsletter | Tiffany Webb" theme="dark">
  <main class="page-content bg-ink">
    
    <section class="spk-hero-v2 relative overflow-hidden" style="padding: 10rem 0 4rem 0; position: relative; min-height: 80vh; display: flex; align-items: center; justify-content: center;">
      <Waveform opacity={0.05} variant="D" />
      <div class="spk-container" style="position: relative; z-index: 10;">
        <div class="text-center" style="max-width: 700px; margin: 0 auto;">
          {hero.eyebrow && <Eyebrow className="justify-center">{hero.eyebrow}</Eyebrow>}
          <h1 class="spk-h1" set:html={headline}></h1>
          {hero.subtitle && <p class="spk-subtitle">{hero.subtitle}</p>}
          
          <form class="newsletter-form mt-8">
            <input type="email" placeholder={form.placeholder || "Email address"} required />
            <button type="submit" class="btn-primary">{form.btn_text || "Subscribe Now"}</button>
          </form>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .bg-ink { background: var(--color-ink); color: var(--color-ivory); min-height: 100vh; }
  .spk-container { width: 90%; max-width: 1200px; margin: 0 auto; }
  .text-center { text-align: center; }
  .justify-center { justify-content: center; }
  
  .spk-h1 {
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 1.1;
    margin: 1rem 0 1.5rem;
    letter-spacing: -0.02em;
    font-family: var(--font-serif);
    color: var(--color-ivory);
  }
  
  .spk-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.6;
    color: rgba(251, 246, 234, 0.7);
    margin: 0 auto 2rem;
    font-weight: 400;
  }
  
  .newsletter-form {
    display: flex;
    gap: 1rem;
    background: rgba(255,255,255,0.05);
    padding: 0.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(255,255,255,0.1);
  }
  
  .newsletter-form input {
    flex-grow: 1;
    background: transparent;
    border: none;
    color: var(--color-ivory);
    padding: 1rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    outline: none;
  }
  
  .newsletter-form input::placeholder {
    color: rgba(251, 246, 234, 0.4);
  }
  
  .btn-primary {
    background: var(--color-gold);
    color: var(--color-ink);
    border: none;
    padding: 1rem 2rem;
    border-radius: 9999px;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .btn-primary:hover {
    background: #e3b64c;
    transform: translateY(-2px);
  }
  
  @media (max-width: 600px) {
    .newsletter-form {
      flex-direction: column;
      border-radius: 20px;
      padding: 1rem;
    }
    .btn-primary {
      width: 100%;
    }
  }
</style>
