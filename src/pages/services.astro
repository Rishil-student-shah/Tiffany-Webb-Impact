---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Button from '../components/Button.astro';
import Waveform from '../components/Waveform.astro';
import PartnershipFramework from '../components/PartnershipFramework.astro';
import PageNavigation from '../components/PageNavigation.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/tiffany_hero_new.jpg';
import mysql from 'mysql2/promise';

let dbContent = {};
let dbCollections = {};
try {
  const pool = mysql.createPool({
    host: 'localhost',
    user: 'root',
    password: '@rishil8124shah',
    database: 'tiffany_crm',
    waitForConnections: true,
    connectionLimit: 10,
    queueLimit: 0
  });
  
  // Fetch KV content for services page
  const [rows] = await pool.query(`
    SELECT section, key_name, content_value 
    FROM website_content 
    JOIN website_pages ON website_content.page_id = website_pages.id 
    WHERE website_pages.slug = 'services'
  `);
  
  rows.forEach(row => {
    if (!dbContent[row.section]) dbContent[row.section] = {};
    dbContent[row.section][row.key_name] = row.content_value;
  });

  // Fetch Collections for services page
  const [colRows] = await pool.query(`
    SELECT section_name, title, sort_order, subtitle, content_html, image_url, icon_svg 
    FROM website_collections 
    JOIN website_pages ON website_collections.page_id = website_pages.id 
    WHERE website_pages.slug = 'services'
    ORDER BY section_name, sort_order ASC
  `);
  
  colRows.forEach(row => {
    if (!dbCollections[row.section_name]) dbCollections[row.section_name] = [];
    dbCollections[row.section_name].push(row);
  });
  await pool.end();
} catch (e) {
  console.error("Database connection failed for SSG, using fallbacks:", e);
}
---

<Layout title="Speaking & Training | Tiffany Webb" theme="dark">
  <main class="page-content bg-ink">
    
    <!-- 1. Cinematic Hero -->
    <section class="spk-hero-v2 relative overflow-hidden">
      <Waveform opacity={0.05} variant="B" flipX={true} />
      
      <div class="spk-container relative z-10">
        <div class="spk-hero-content text-center">
          <Eyebrow className="justify-center">Speaking & Training</Eyebrow>
          <h1 class="spk-h1">Bring Tiffany <br/><span class="italic-accent">to your stage.</span></h1>
          <p class="spk-subtitle">
            Keynotes, conference sessions, panels, workshops, and school programs on gambling prevention, public health, and community impact.
          </p>
          <div class="spk-btn-row">
            <Button href="/work-with-tiffany" variant="primary" className="magnetic-btn btn-glow">Start a Conversation &rarr;</Button>
          </div>
        </div>

        <div class="spk-hero-visual">
          <div class="spk-hero-video-card">
            <Image src={heroImg} alt="Tiffany Webb Speaking" class="spk-video-poster" />
            <div class="spk-video-overlay"></div>
            <button class="spk-play-btn" aria-label="Play Reel">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="spk-play-icon"><path d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.347a1.125 1.125 0 0 1 0 1.972l-11.54 6.347c-.75.412-1.667-.13-1.667-.986V5.653Z" /></svg>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. Why Tiffany (Premium Bento) -->
    <section class="spk-section relative overflow-hidden">
      <Waveform opacity={0.03} />
      
      <div class="spk-container relative z-10">
        <div class="spk-section-header text-center">
          <h2 class="spk-h2">Why <span class="italic-accent">Tiffany.</span></h2>
        </div>
        
        <div class="spk-bento-grid">
          <div class="spk-bento-card span-2">
            <h3 class="spk-card-title">Frontline credibility</h3>
            <p class="spk-card-desc">Four thousand hours of actual outreach. She has had these conversations in real rooms, with real families, for fifteen years.</p>
          </div>
          <div class="spk-bento-card">
            <h3 class="spk-card-title">Cultural fluency</h3>
            <p class="spk-card-desc">She reaches communities that standard prevention programming consistently misses — because she knows how to enter them respectfully.</p>
          </div>
          <div class="spk-bento-card">
            <h3 class="spk-card-title">Evidence-based</h3>
            <p class="spk-card-desc">Screening, early intervention, motivational interviewing, harm reduction. The methods are real and current.</p>
          </div>
          <div class="spk-bento-card span-2">
            <h3 class="spk-card-title">Practical takeaways</h3>
            <p class="spk-card-desc">Audiences leave with something they can use on Monday, not a feeling that fades by Friday.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. How Tiffany Helps -->
    {(!dbContent.how_tiffany_helps || dbContent.how_tiffany_helps.section_is_active !== "0") && (() => {
      const hthContent = dbContent.how_tiffany_helps || {};
      const hthCards = dbCollections.how_tiffany_helps || [
        { title: 'Strategic Advisor', subtitle: '01 // THINK', content_html: 'I challenge familiar thinking, uncover opportunities, and help leaders make clearer decisions around growth, engagement, innovation, and impact.', image_url: '/services#strategic-advisor' },
        { title: 'Program Architect', subtitle: '02 // BUILD', content_html: 'I turn ideas and community needs into structured programs, initiatives, experiences, partnerships, and implementation pathways.', image_url: '/services#program-architect' },
        { title: 'Community Impact Strategist', subtitle: '03 // CONNECT', content_html: 'Connects organizational goals with community realities, strengths, needs, and voices to create people-centered, outcome-focused strategies.', image_url: '/services#community-impact-strategist' },
        { title: 'Speaker & Facilitator', subtitle: '04 // MOVE', content_html: 'I create conversations and learning experiences that challenge assumptions, elevate thinking, encourage dialogue, and move audiences toward action.', image_url: '/services#speaker-facilitator' }
      ];
      
      const eyebrow = hthContent.eyebrow ?? "HOW TIFFANY HELPS";
      let rawHeadline = hthContent.headline || "Strategy with people at the center.";
      let headlineRaw = rawHeadline.includes('<span')
        ? rawHeadline
        : rawHeadline.replace(/at the center\.?/i, '<span class="italic-accent">at the center.</span>');
      const intro = hthContent.intro ?? "From early ideas to real-world implementation, I help leaders see opportunities differently, structure what comes next, and connect strategy with the people and communities it is meant to serve.";
      const quote1 = hthContent.quote_1 ?? "I don't just tell you what to do next.";
      const quote2 = hthContent.quote_2 ?? "I help you build how you get there.";

      return (
        <section class="spk-section relative overflow-hidden">
          <Waveform opacity={0.03} variant="B" flipX={true} />
          
          <div class="spk-container relative z-10">
            <div class="spk-section-header text-center">
              {eyebrow && <Eyebrow className="justify-center">{eyebrow}</Eyebrow>}
              {headlineRaw && <h2 class="spk-h2" set:html={headlineRaw}></h2>}
              {intro && (
                <p class="spk-subtitle" style="max-width: 62ch; margin: 0 auto 4rem auto;">
                  {intro}
                </p>
              )}
            </div>
            
            {hthCards.length > 0 && (
              <div class="helps-grid">
                {hthCards.map((card) => (
                  <a href={card.image_url || "#"} class="helps-card glass-card">
                    {card.subtitle && <div class="helps-eyebrow">{card.subtitle}</div>}
                    <h3 class="helps-title">{card.title}</h3>
                    {card.content_html && <p class="helps-desc" set:html={card.content_html}></p>}
                  </a>
                ))}
              </div>
            )}
            
            {(quote1 || quote2) && (
              <div class="helps-quote text-center">
                <p class="quote-text">
                  {quote1 && `"${quote1}`}<br/>
                  {quote2 && <span class="text-gold">{quote2}"</span>}
                </p>
              </div>
            )}
          </div>
        </section>
      );
    })()}

    <!-- GEAR Method -->
    {(!dbContent.gear_method || dbContent.gear_method.section_is_active !== "0") && (() => {
      const gearContent = dbContent.gear_method || {};
      const gearCards = dbCollections.gear_method || [
        { title: 'Generate', subtitle: 'G', content_html: 'Build awareness and understanding. Clarify the challenge, understand the audience, and make the issue visible and relevant.' },
        { title: 'Engage', subtitle: 'E', content_html: 'Build trust and connection. Listen, strengthen relationships, and create opportunities for meaningful participation.' },
        { title: 'Activate', subtitle: 'A', content_html: 'Move ideas into action. Turn insight into strategies, programs, experiences, partnerships, and practical next steps.' },
        { title: 'Resource', subtitle: 'R', content_html: 'Build the path forward. Connect people and organizations with information, relationships, services, tools, and opportunities.' }
      ];
      
      const eyebrow = gearContent.eyebrow ?? "SIGNATURE METHODOLOGY";
      let rawGearHeadline = gearContent.headline || "The GEAR Method™";
      let headline = rawGearHeadline.includes('<span')
        ? rawGearHeadline
        : `<span class="title-white">The GEAR</span> <span class="italic-accent">Method™</span>`;
      const standfirst = gearContent.standfirst ?? "From awareness to action. From ideas to impact.";
      const description = gearContent.description ?? "The GEAR Method™ is my human-centered approach to helping organizations create strategies that connect with people, activate participation, and build meaningful pathways forward.";
      const footer = gearContent.footer ?? "AWARENESS &rarr; CONNECTION &rarr; ACTION &rarr; IMPACT";

      return (
        <section id="gear" class="spk-section relative overflow-hidden" style="padding-top: 2rem;">
          <Waveform opacity={0.05} variant="A" />
          <div class="spk-container relative z-10">
            
            <div class="gear-top-row">
              <div class="gear-left">
                {eyebrow && <Eyebrow className="gear-eyebrow justify-start">{eyebrow}</Eyebrow>}
                {headline && <h2 class="gear-h2" set:html={headline}></h2>}
              </div>
              <div class="gear-right">
                {standfirst && <h3 class="gear-standfirst">{standfirst}</h3>}
                {description && <p class="gear-desc">{description}</p>}
              </div>
            </div>
            
            <div class="gear-panel">
              
              {gearCards.length > 0 && (
                <div class="gear-grid">
                  {gearCards.map((card, idx) => {
                    const cardTheme = (idx % 2 === 0) ? 'card-burnt-orange' : 'card-emerald-green';
                    return (
                      <div class={`gear-card ${cardTheme}`}>
                        {card.subtitle && <div class="gear-letter">{card.subtitle}</div>}
                        {card.title && <h4 class="gear-title">{card.title}</h4>}
                        {card.content_html && <p class="gear-body">{card.content_html}</p>}
                      </div>
                    );
                  })}
                </div>
              )}
              
              {footer && (
                <div class="gear-footer-row text-center">
                  <div class="gear-divider-bottom"></div>
                  <p class="gear-footer-text" set:html={footer}></p>
                </div>
              )}
            </div>
          </div>
        </section>
      );
    })()}

    <!-- 0.7 Partnership Framework -->
    <PartnershipFramework 
      eyebrow={dbContent.partnership_framework?.eyebrow}
      headline={dbContent.partnership_framework?.headline}
      subtitle={dbContent.partnership_framework?.subtitle}
      collections={dbCollections} 
    />

    <!-- 5. Timeline -->
    <section class="spk-section relative overflow-hidden timeline-bg">
      <Waveform opacity={0.04} variant="B" flipY={true} />
      <div class="spk-container relative z-10">
        <div class="spk-timeline-layout">
          <div class="timeline-left">
            <h2 class="spk-h2">What working <br/><span class="italic-accent">looks like.</span></h2>
            <p class="spk-subtitle" style="text-align: left; margin: 0;">She builds the session you actually need, not the one she gave yesterday.</p>
          </div>
          
          <div class="timeline-right">
            <div class="spk-timeline">
              <div class="spk-time-node">
                <h4 class="node-title">Pre-event consultation</h4>
                <p class="node-desc">She learns your audience, your goals, and your constraints before writing a word.</p>
              </div>
              <div class="spk-time-node">
                <h4 class="node-title">Content built for your room</h4>
                <p class="node-desc">Sessions are tailored specifically to your community's current challenges.</p>
              </div>
              <div class="spk-time-node">
                <h4 class="node-title">Promotional assets</h4>
                <p class="node-desc">Headshot, bio, session description, and social graphics, supplied ready to use.</p>
              </div>
              <div class="spk-time-node last">
                <h4 class="node-title">Post-event resources</h4>
                <p class="node-desc">Actionable takeaways your attendees can implement the following Monday.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Speaking Catalog Gateway Card -->
    <section class="spk-section relative overflow-hidden" style="padding: 6rem 0; background: radial-gradient(circle at 50% 0%, rgba(217, 162, 58, 0.08) 0%, rgba(13, 12, 8, 0.95) 75%);">
      <div class="spk-container relative z-10 text-center">
        <div class="reveal-up" style="max-width: 800px; margin: 0 auto;">
          <Eyebrow className="justify-center">SPEAKING PORTFOLIO</Eyebrow>
          <h2 class="spk-h2 mt-4">Explore all 20 <span class="italic-accent">signature topics.</span></h2>
          <p class="spk-subtitle mx-auto mt-4" style="margin-bottom: 2.5rem;">
            Keynotes, clinical workshops, and youth prevention sessions organized by track and audience.
          </p>
          <div>
            <Button href="/services/speaking-topics" variant="primary" className="magnetic-btn">
              VIEW 20-TOPIC SPEAKING CATALOG &rarr;
            </Button>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer Navigation Loop -->
    <PageNavigation 
      prevLink="/about" 
      prevLabel="Read Tiffany's Story & Heritage" 
      nextLink="/impact" 
      nextLabel="See Real-World Engagements & Impact" 
    />

  </main>
</Layout>

<style is:global>
  /* Base Architecture */
  .bg-ink { background: var(--ink); }
  .spk-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
    position: relative;
    z-index: 10;
  }
  .spk-section {
    padding: 8rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
  }
  .text-center { text-align: center; }

  /* Typography */
  .spk-h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 5rem);
    color: var(--color-ivory);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .spk-h2 {
    font-family: var(--font-serif);
    font-size: clamp(2.5rem, 5vw, 4rem);
    color: var(--color-ivory);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .spk-subtitle {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: rgba(251, 246, 234, 0.75);
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto 3rem auto;
  }
  .text-gold {
    background: none;
    -webkit-text-fill-color: var(--color-gold);
    color: var(--color-gold);
  }

  /* 1. Hero */
  .spk-hero-v2 {
    padding: 12rem 0 6rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .spk-hero-content {
    margin-bottom: 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .spk-btn-row {
    display: flex;
    justify-content: center;
  }
  .spk-hero-visual {
    max-width: 900px;
    margin: 0 auto;
  }
  .spk-hero-video-card {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 24px;
    overflow: hidden;
    background: #000;
    box-shadow: 0 40px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(217, 162, 58, 0.3);
    cursor: pointer;
  }
  .spk-video-poster {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  .spk-hero-video-card:hover .spk-video-poster {
    transform: scale(1.03);
  }
  .spk-video-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.3);
    z-index: 1;
  }
  .spk-play-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: rgba(217, 162, 58, 0.9);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 2;
    transition: transform 0.3s ease, background 0.3s ease;
  }
  .spk-hero-video-card:hover .spk-play-btn {
    transform: translate(-50%, -50%) scale(1.1);
    background: var(--color-gold);
  }
  .spk-play-icon {
    width: 32px;
    height: 32px;
    color: var(--ink);
    margin-left: 4px;
  }

  /* 2. Why Tiffany Bento */
  .spk-section-header {
    margin-bottom: 4rem;
  }
  .spk-bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .spk-bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .span-2 {
      grid-column: span 2;
    }
  }
  .spk-bento-card {
    background: rgba(20, 20, 20, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 24px;
    padding: 3rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .spk-bento-card:hover {
    transform: translateY(-5px);
    border-color: rgba(217, 162, 58, 0.3);
  }
  .spk-card-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--color-gold);
    margin-bottom: 1rem;
  }
  .spk-card-desc {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    color: rgba(251, 246, 234, 0.8);
    line-height: 1.6;
    margin: 0;
  }

  /* 3. Flagship Keynote */
  .spk-flagship-card {
    position: relative;
    background: radial-gradient(circle at top right, rgba(217,162,58,0.1) 0%, transparent 50%),
                radial-gradient(circle at bottom left, rgba(217,162,58,0.05) 0%, transparent 50%),
                rgba(15, 15, 15, 0.95);
    border-radius: 32px;
    padding: 6rem 2rem;
    border: 1px solid rgba(217, 162, 58, 0.2);
    box-shadow: 0 30px 80px rgba(0,0,0,0.8);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
  }
  .spk-flagship-card:hover {
    transform: translateY(-10px);
    border-color: rgba(217, 162, 58, 0.6);
    box-shadow: 0 40px 100px rgba(0,0,0,0.9), 0 0 60px rgba(217, 162, 58, 0.15);
  }
  .ambient-gold-glow {
    position: absolute;
    bottom: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 50%;
    background: radial-gradient(circle, rgba(217,162,58,0.2) 0%, transparent 60%);
    pointer-events: none;
    z-index: 0;
  }
  .spk-book-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-gold);
    color: var(--ink);
    padding: 1rem 2.5rem;
    border-radius: 8px;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .spk-book-btn:hover {
    background: #FFC95C;
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(217, 162, 58, 0.3);
  }

  /* 3. How Tiffany Helps */
  .helps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 5rem;
  }
  @media (min-width: 768px) {
    .helps-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }
  .helps-card {
    display: block;
    text-decoration: none;
    padding: 3rem;
    border-radius: 24px;
    background: rgba(20, 20, 20, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease, background 0.4s ease;
  }
  .helps-card:hover {
    transform: translateY(-8px);
    border-color: rgba(217, 162, 58, 0.4);
    background: rgba(30, 28, 25, 0.6);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5), 0 0 40px rgba(217, 162, 58, 0.05);
  }
  .helps-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold, #D9A23A) !important;
    margin-bottom: 1.5rem;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }
  .helps-title {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--color-ivory);
    margin-bottom: 1rem;
    transition: color 0.3s ease;
  }
  .helps-desc {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.6;
    color: rgba(251, 246, 234, 0.75);
    margin: 0;
  }
  
  .helps-quote {
    padding-top: 2rem;
  }
  .quote-text {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.3;
    color: var(--color-ivory);
    margin: 0 auto;
    max-width: 800px;
    opacity: 0.9;
  }

  /* GEAR Method */
  .gear-panel {
    background: radial-gradient(circle at 50% 0%, rgba(35, 30, 22, 0.95), rgba(13, 12, 8, 0.98)), linear-gradient(135deg, rgba(217, 162, 58, 0.08) 0%, rgba(225, 115, 86, 0.08) 50%, rgba(108, 45, 90, 0.08) 100%);
    border: 1px solid rgba(217, 162, 58, 0.3);
    border-radius: 32px;
    padding: 4rem 2rem;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    margin-bottom: 2rem;
    position: relative;
    overflow: hidden;
  }
  @media (min-width: 992px) {
    .gear-panel {
      padding: 5rem 4rem;
    }
  }
  .gear-top-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    margin-bottom: 4rem;
  }
  @media (min-width: 992px) {
    .gear-top-row {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
  }
  .gear-eyebrow {
    margin-bottom: 1rem;
  }
  .gear-h2 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 1.1;
    margin: 0;
    color: var(--color-ivory, #FBF6EA);
  }
  .title-white {
