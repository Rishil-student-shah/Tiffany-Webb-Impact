---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Waveform from '../components/Waveform.astro';
import Button from '../components/Button.astro';
import PageNavigation from '../components/PageNavigation.astro';
import { Image } from 'astro:assets';
import aboutImg from '../assets/tiffany_about_new.jpg';
---

<Layout title="About | Tiffany Webb" description="Meet Tiffany Webb. Discover her journey from Chicago to frontline behavioral health prevention." theme="ink">
  <main class="page-content">
    
    <!-- 1. Hero Section -->
    <section class="inner-hero theme-ink">
      <Waveform opacity={0.06} flipX={true} variant="B" />
      <div class="container hero-grid reveal-up">
        <div class="hero-content">
          <Eyebrow>About Tiffany</Eyebrow>
          <h1 class="inner-hero-title">Personal Perspective. <br><span class="italic-accent">Professional Experience.</span></h1>
          <p class="inner-hero-sub text-micro">TIFFANY WEBB, BBA, MHP &middot; 15+ Years in Behavioral Health &middot; 4,000+ Hours Frontline Outreach</p>
        </div>
        <div class="hero-image-wrap blob-shape reveal-in" style="transition-delay: 0.3s;">
           <Image src={aboutImg} alt="Tiffany Webb Portrait" class="about-hero-img" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </section>

    <!-- 2. The Story (Roots) -->
    <section class="roots section-pad theme-ink relative">
      <Waveform opacity={0.05} />
      
      <!-- Glowing Background Orb for effect -->
      <div class="ambient-glow" style="top: 30%; left: 50%; transform: translate(-50%, -50%); width: 60vw; height: 60vw; background: radial-gradient(circle, rgba(217, 162, 58, 0.08) 0%, transparent 70%);"></div>

      <div class="container relative z-10">
        
        <div class="text-center mb-32 reveal-up">
          <Eyebrow>The Origin</Eyebrow>
          <h2 class="massive-quote mx-auto">"When we rise,<br/><span class="italic-accent text-gold">we rise together.</span>"</h2>
          <div class="story-divider mx-auto mt-8"></div>
        </div>
        
        <!-- 3-Column Card Grid -->
        <div class="story-grid stagger-group">
          
          <div class="story-card ultra-glass-card stagger-item">
            <div class="ultra-padding-wrapper">
              <div class="card-icon">01</div>
              <h3 class="card-title">The Upbringing & Roots</h3>
              <p class="card-text">I was raised by my grandmother and a whole village of aunties and uncles who taught me about family, caring for people, and showing up for others. I’m Chicago-born with deep Louisiana family roots, and my understanding of people began long before this became my professional work.</p>
            </div>
          </div>
          
          <div class="story-card ultra-glass-card stagger-item" style="transition-delay: 0.1s;">
            <div class="ultra-padding-wrapper">
              <div class="card-icon">02</div>
              <h3 class="card-title">Frontline Experience</h3>
              <p class="card-text">Over 15+ years in behavioral health & public health and 4,000+ hours of frontline community outreach, she has delivered prevention where it actually happens: in clinics, school gyms, church basements, and coalition halls across the nation.</p>
            </div>
          </div>
          
          <div class="story-card ultra-glass-card stagger-item" style="transition-delay: 0.2s;">
            <div class="ultra-padding-wrapper">
              <div class="card-icon">03</div>
              <h3 class="card-title">Cultural Enterprise</h3>
              <p class="card-text">Her work bridges public health education and social enterprise — including founding GambleFreeGear Awareness Apparel, turning prevention into wearable advocacy that breaks the silence before crisis strikes.</p>
            </div>
          </div>
          
        </div>

        <!-- The heavy quote moved to a standalone cinematic banner below the cards -->
        <div class="cinematic-quote ultra-glass-card reveal-up">
           <div class="ultra-padding-wrapper text-center">
             <h3 class="quote-text">"Gambling harm hides. It doesn't smell like alcohol or show up on a drug test. It shows up as a missing paycheck... <span class="italic-accent">By the time most families name it, they have been carrying it alone for years.</span>"</h3>
           </div>
        </div>

      </div>
    </section>

    <!-- 3. Professional Journey (Alternating Vertical Timeline) -->
    <section class="journey section-pad theme-ink relative">
      <Waveform opacity={0.03} />
      <div class="container reveal-up">
        <div class="text-center mb-16">
          <Eyebrow>The Path Here</Eyebrow>
          <h2 class="section-title">Where all <span class="italic-accent">paths meet.</span></h2>
          <p class="subtitle mx-auto">Behavioral health taught her how harm works. Community outreach taught her how trust works. Public health education taught her how to scale a message. Prevention is where all three meet.</p>
        </div>
        
        <div class="vertical-timeline">
          <div class="timeline-center-line"></div>
          
          <div class="v-timeline-item left reveal-in">
            <div class="v-timeline-content ultra-glass-card glass-emerald">
              <span class="timeline-num">Phase 01</span>
              <h3>Behavioral Health</h3>
              <div class="v-timeline-divider"></div>
              <p class="v-timeline-desc">Understanding the root causes of harm and the psychological drivers behind addiction to build effective interventions.</p>
            </div>
          </div>
          
          <div class="v-timeline-item right reveal-in" style="transition-delay: 0.1s;">
            <div class="v-timeline-content ultra-glass-card glass-burnt-orange">
              <span class="timeline-num">Phase 02</span>
              <h3>Community Outreach</h3>
              <div class="v-timeline-divider"></div>
              <p class="v-timeline-desc">Building trust and creating safe spaces for families to share their hidden struggles and find their voice.</p>
            </div>
          </div>
          
          <div class="v-timeline-item left reveal-in">
            <div class="v-timeline-content ultra-glass-card glass-emerald">
              <span class="timeline-num">Phase 03</span>
              <h3>Gambling Prevention</h3>
              <div class="v-timeline-divider"></div>
              <p class="v-timeline-desc">Designing targeted programs to stop harm before it reaches the crisis point and destroys livelihoods.</p>
            </div>
          </div>
          
          <div class="v-timeline-item right reveal-in" style="transition-delay: 0.1s;">
            <div class="v-timeline-content ultra-glass-card glass-burnt-orange">
              <span class="timeline-num">Phase 04</span>
              <h3>Public Health Education</h3>
              <div class="v-timeline-divider"></div>
              <p class="v-timeline-desc">Scaling the message to equip communities with the language, education, and resources they need to thrive.</p>
            </div>
          </div>
          
          <div class="v-timeline-item left reveal-in">
            <div class="v-timeline-content ultra-glass-card glass-emerald">
              <span class="timeline-num">Phase 05</span>
              <h3>Partnership Building</h3>
              <div class="v-timeline-divider"></div>
              <p class="v-timeline-desc">Collaborating with local organizations to create a unified, sustainable support network that lasts.</p>
            </div>
          </div>
          
          <div class="v-timeline-item right reveal-in" style="transition-delay: 0.1s;">
            <div class="v-timeline-content ultra-glass-card glass-burnt-orange">
              <span class="timeline-num">Phase 06</span>
              <h3>Impact Strategist</h3>
              <div class="v-timeline-divider"></div>
              <p class="v-timeline-desc">Bringing it all together to create systemic change that empowers families and transforms entire communities.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Core (Mission, Vision, Values - Pure Glass Masonry Grid) -->
    <section class="core section-pad theme-ink relative">
      <Waveform opacity={0.06} variant="B" />
      
      <div class="container relative">
        
        <!-- Ambient Background Glow -->
        <div class="ambient-glow" style="top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80vw; height: 80vw; background: radial-gradient(circle, rgba(217, 162, 58, 0.05) 0%, transparent 60%);"></div>

        <div class="masonry-grid stagger-group relative z-10">
          
          <!-- Mission: Full Width Panoramic (Obsidian) -->
          <div class="masonry-item mission ultra-glass-card glass-obsidian stagger-item animated-card">
            <div class="ultra-padding-wrapper">
              <Eyebrow className="eyebrow-padded">Mission</Eyebrow>
              <p class="mission-statement">So that no individual, family, or community faces gambling harm in silence, shame, or isolation — because prevention begins with a <span class="italic-accent text-gold">conversation.</span></p>
            </div>
          </div>
          
          <!-- Vision: Left Column (Emerald) -->
          <div class="masonry-item vision ultra-glass-card glass-emerald stagger-item animated-card" style="animation-delay: -2s;">
            <div class="ultra-padding-wrapper">
              <Eyebrow className="eyebrow-padded">Vision</Eyebrow>
              <h2 class="mb-6 text-2xl font-serif text-ivory">Where this is <span class="italic-accent">going.</span></h2>
              <ul class="vision-list">
                <li><strong>National speaking:</strong> Bringing prevention conversations to stages, campuses, and conferences across the country.</li>
                <li><strong>Training & education:</strong> Equipping clinicians, educators, and frontline teams with tools that survive contact with real life.</li>
                <li><strong>Community:</strong> Building something people can join, wear, and carry into their own conversations.</li>
              </ul>
            </div>
          </div>
          
          <!-- Values: Right Column (Amethyst) -->
          <div class="masonry-item values ultra-glass-card glass-amethyst stagger-item animated-card" style="animation-delay: -4s;">
            <div class="ultra-padding-wrapper">
              <Eyebrow className="eyebrow-padded">Values</Eyebrow>
              <h2 class="mb-6 text-2xl font-serif text-ivory">What she <span class="italic-accent">works from.</span></h2>
              <ul class="values-list interactive-list">
                <li><strong>Faith</strong> — the belief that people can change, including the ones everyone else gave up on.</li>
                <li><strong>Family</strong> — where prevention starts, and where harm is felt first and longest.</li>
                <li><strong>Community</strong> — nobody recovers alone, and nobody prevents alone either.</li>
                <li><strong>Purpose</strong> — turning lived understanding into practical service.</li>
                <li><strong>Impact</strong> — measured in conversations started, not talks delivered.</li>
              </ul>
            </div>
          </div>

        </div>

        <div class="gear-reference reveal-up" style="margin-top: 3rem; text-align: center;">
          <p class="text-ivory/80 font-sans text-lg">
            Built on <a href="/services#gear" class="text-gold" style="text-decoration: underline; text-underline-offset: 4px; font-weight: 500;">The GEAR Method™</a> — her human-centered approach to creating strategies that connect with people.
          </p>
        </div>
      </div>
    </section>

    <!-- Section: Awards, Recognition & Milestones (Folder 2.4 Standard) -->
    <section class="milestones-section theme-ink relative overflow-hidden" style="padding: 7rem 0; border-top: 1px solid rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
      <Waveform opacity={0.04} variant="A" />
      
      <div class="container relative z-10" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
        
        <!-- Header -->
        <div class="section-header-block reveal-up" style="text-align: center; margin-bottom: 3.5rem;">
          <Eyebrow className="justify-center text-center">INITIATIVE & IMPACT</Eyebrow>
          <h2 class="font-serif text-3xl md:text-5xl text-ivory mb-4" style="font-family: var(--font-serif); font-size: clamp(2.2rem, 4vw, 3.4rem); color: var(--color-ivory); margin: 0.5rem 0 1rem 0;">
            Awards, recognition & <span class="italic-accent">milestones.</span>
          </h2>
          <p style="font-size: 1.15rem; color: rgba(251, 246, 234, 0.85); max-width: 720px; margin: 0 auto; line-height: 1.65;">
            Founder of GambleFreeGear, a pioneering gambling-awareness clothing brand using fashion, creativity, and community engagement to make prevention more visible and approachable.
          </p>
        </div>

        <!-- 6-Milestone Glass Cards Grid -->
        <div class="milestones-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.75rem;">
          
          <div class="milestone-card" style="background: rgba(20, 18, 14, 0.85); border: 1px solid rgba(217, 162, 58, 0.3); border-radius: 16px; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: #D9A23A; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;">INNOVATION & YOUTH</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.35rem; color: #FBF6EA; margin: 0.5rem 0 0.75rem 0;">Creator of GambleFree Friends Universe™</h3>
            <p style="font-size: 0.95rem; line-height: 1.6; color: rgba(251, 246, 234, 0.8); margin: 0;">A youth-centered prevention universe using characters, storytelling, music, and healthy decision-making to make risk conversations accessible to young people and families.</p>
          </div>

          <div class="milestone-card" style="background: rgba(20, 18, 14, 0.85); border: 1px solid rgba(217, 162, 58, 0.3); border-radius: 16px; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: #D9A23A; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;">FELLOWSHIP & LEADERSHIP</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.35rem; color: #FBF6EA; margin: 0.5rem 0 0.75rem 0;">NCPG Conference Scholarship Recipient</h3>
            <p style="font-size: 0.95rem; line-height: 1.6; color: rgba(251, 246, 234, 0.8); margin: 0;">Awarded by the National Council on Problem Gambling, supporting specialized professional development and participation across the national problem-gambling field.</p>
          </div>

          <div class="milestone-card" style="background: rgba(20, 18, 14, 0.85); border: 1px solid rgba(217, 162, 58, 0.3); border-radius: 16px; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: #D9A23A; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;">ENTREPRENEURSHIP</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.35rem; color: #FBF6EA; margin: 0.5rem 0 0.75rem 0;">Amazon Black Business Accelerator (2022)</h3>
            <p style="font-size: 0.95rem; line-height: 1.6; color: rgba(251, 246, 234, 0.8); margin: 0;">Completed Amazon’s rigorous Black Business Accelerator program as part of scaling mission-driven entrepreneurial advocacy through GambleFreeGear.</p>
          </div>

          <div class="milestone-card" style="background: rgba(20, 18, 14, 0.85); border: 1px solid rgba(217, 162, 58, 0.3); border-radius: 16px; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: #D9A23A; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;">SYSTEMS ARCHITECTURE</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.35rem; color: #FBF6EA; margin: 0.5rem 0 0.75rem 0;">Annual Problem Gambling Outreach</h3>
            <p style="font-size: 0.95rem; line-height: 1.6; color: rgba(251, 246, 234, 0.8); margin: 0;">Developed and implemented year-round problem-gambling prevention and early-intervention outreach programming embedded in nonprofit community health settings.</p>
          </div>

          <div class="milestone-card" style="background: rgba(20, 18, 14, 0.85); border: 1px solid rgba(217, 162, 58, 0.3); border-radius: 16px; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: #D9A23A; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;">CIVIC CONVENING</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.35rem; color: #FBF6EA; margin: 0.5rem 0 0.75rem 0;">Two Problem Gambling Resource Fairs</h3>
            <p style="font-size: 0.95rem; line-height: 1.6; color: rgba(251, 246, 234, 0.8); margin: 0;">Planned and executed two consecutive annual community fairs bringing municipal agencies, clinical resources, screenings, and prevention dialogues together.</p>
          </div>

          <div class="milestone-card" style="background: rgba(20, 18, 14, 0.85); border: 1px solid rgba(217, 162, 58, 0.3); border-radius: 16px; padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.4);">
            <span style="font-family: var(--font-mono); font-size: 0.75rem; color: #D9A23A; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;">COMMUNITY ACTIVATION</span>
            <h3 style="font-family: var(--font-serif); font-size: 1.35rem; color: #FBF6EA; margin: 0.5rem 0 0.75rem 0;">"Screen & Scream" Activation</h3>
            <p style="font-size: 0.95rem; line-height: 1.6; color: rgba(251, 246, 234, 0.8); margin: 0;">Created a collaborative, high-engagement community activation bringing regional partners together around stigma-free screening, education, and early prevention.</p>
          </div>

        </div>

      </div>
    </section>
    
    <!-- 5. Gamble Free Gear (Exclusive Fashion Drop Layout) -->
    <section class="gfg-immersive theme-ink relative" id="gamblefreegear">
      <Waveform opacity={0.08} flipX={true} variant="C" />

      <div class="container relative z-10">
        <div class="gfg-exclusive-card reveal-up mx-auto">
          <div class="gfg-glow-ring"></div>
          <div class="gfg-inner-content">
            <Eyebrow className="gfg-eyebrow text-center justify-center">A VENTURE BY TIFFANY WEBB</Eyebrow>
            <h2 class="gfg-title text-center">GambleFree<span class="italic-accent">Gear</span></h2>
            <div class="gfg-divider"></div>
            <p class="gfg-subtitle text-center">I’m also the founder of GambleFreeGear, a pioneering gambling-awareness clothing brand created to make prevention, awareness, and conversation more visible through apparel, creativity, and community engagement.</p>
            <div class="gfg-btn-wrapper">
              <a href="https://gamblefreegear.com" target="_blank" rel="noopener noreferrer" class="gfg-premium-btn">
                <span>Explore the Collection</span> <span class="arrow text-xl leading-none">&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. Let's Talk CTA -->
    <section class="section-pad theme-ink relative">
      <Waveform opacity={0.06} flipY={true} />
      <div class="container relative z-10">
        
        <div class="cta-card ultra-glass-card glass-topaz animated-card mx-auto max-w-5xl reveal-up">
          <div class="ultra-padding-wrapper text-center relative overflow-hidden">
            <!-- Inner Glow -->
            <div class="cta-inner-glow"></div>
            
            <h2 class="font-serif text-5xl md:text-7xl mb-8 text-ivory relative z-10">Let's start a <span class="italic-accent text-gold">conversation.</span></h2>
            <p class="text-xl text-ivory/80 mb-12 max-w-2xl mx-auto font-light leading-relaxed relative z-10">
              Whether you're planning a conference, building a prevention program, or trying to reach a community that hasn't responded to anything yet — that's the work.
            </p>
            <div class="relative z-10">
              <Button href="/book" variant="secondary" className="magnetic-btn px-12 py-5 text-lg cta-btn">Invite Tiffany to Speak &rarr;</Button>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- Footer Navigation Loop -->
    <PageNavigation 
      prevLink="/" 
      prevLabel="Return to Home" 
      nextLink="/services" 
      nextLabel="Explore Services & GEAR Method™" 
    />

  </main>
</Layout>

<style>
  .page-content {
    background: var(--color-ink);
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  .section-pad {
    padding: var(--sp-24) 0;
  }

  /* Typography Utilities */
  .subtitle {
    font-size: 1.125rem;
    color: rgba(231, 224, 207, 0.8);
    max-width: 800px;
    line-height: 1.6;
  }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .text-center { text-align: center; }
  .mb-4 { margin-bottom: var(--sp-4); }
  .mb-6 { margin-bottom: var(--sp-6); }
  .mb-8 { margin-bottom: var(--sp-8); }
  .mb-16 { margin-bottom: var(--sp-16); }
  .mt-4 { margin-top: var(--sp-4); }
  .mt-8 { margin-top: var(--sp-8); }
  .relative { position: relative; }
  .z-10 { z-index: 10; }
  .text-2xl { font-size: 1.5rem; }
  .font-serif { font-family: var(--font-serif); }
  .text-ivory { color: var(--color-ivory); }
  
  .italic-accent {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(92deg, var(--color-mustard), var(--color-coral), var(--color-berry));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* 1. Hero */
  .inner-hero {
    position: relative;
    padding: calc(var(--sp-24) + 80px) 0 var(--sp-12);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 992px) {
    .hero-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .inner-hero-title {
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1.1;
    margin-bottom: var(--sp-6);
    color: var(--color-ivory);
  }

  .inner-hero-sub {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 700;
    color: #F3C56E;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.6);
  }

  .hero-image-wrap {
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
    aspect-ratio: 3/4;
    border-radius: 200px 24px 200px 24px;
    overflow: hidden;
    border: 1px solid rgba(217, 162, 58, 0.4);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    position: relative;
  }

  .about-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  /* Morphing Blob Animation for Hero Image */
  .blob-shape {
    animation: blob-morph 12s ease-in-out infinite alternate;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
  }
  .blob-shape:hover {
    transform: scale(1.03) rotate(-2deg);
    box-shadow: 0 30px 60px rgba(0,0,0,0.7);
    animation-play-state: paused;
  }

  @keyframes blob-morph {
    0% { border-radius: 200px 24px 200px 24px; }
    33% { border-radius: 120px 200px 24px 180px; }
    66% { border-radius: 24px 150px 200px 100px; }
    100% { border-radius: 200px 100px 24px 200px; }
  }

  /* Pure Apple-Style Glassmorphism */
  .ultra-glass-card {
    background: rgba(255, 255, 255, 0.02); /* Extremely faint frost, absolutely no tint */
    backdrop-filter: blur(32px) saturate(120%);
    -webkit-backdrop-filter: blur(32px) saturate(120%);
    border: 1px solid rgba(255, 255, 255, 0.08); /* Delicate, elegant glowing edge */
    border-radius: 32px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    position: relative;
    overflow: hidden; /* Cleanly clips the corners */
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease, border-color 0.6s ease, background 0.6s ease;
  }

  .ultra-glass-card:hover {
    transform: translateY(-8px) rotate(0.5deg);
    box-shadow: 0 30px 60px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Premium Jewel-Toned Colors */
  .glass-sapphire {
    background: rgba(15, 45, 90, 0.15);
    border-color: rgba(100, 150, 255, 0.1);
  }
  .glass-sapphire:hover {
