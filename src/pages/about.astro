---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Waveform from '../components/Waveform.astro';
import Button from '../components/Button.astro';
import { Image } from 'astro:assets';
import aboutImg from '../assets/tiffany_about_new.jpg';
---

<Layout title="About | Tiffany Webb" description="Meet Tiffany Webb. Discover her journey from Chicago to frontline behavioral health prevention." theme="ink">
  <main class="page-content">
    
    <!-- 1. Hero Section -->
    <section class="inner-hero theme-ink">
      <Waveform opacity={0.06} flipX={true} variant="B" />
      <div class="container hero-grid reveal-up">
        <div class="hero-content">
          <Eyebrow>About</Eyebrow>
          <h1 class="inner-hero-title">Chicago soul, <br><span class="italic-accent">Louisiana heart.</span></h1>
          <p class="inner-hero-sub text-micro">Community Impact Strategist &middot; Public Health Educator</p>
        </div>
        <div class="hero-image-wrap blob-shape reveal-in" style="transition-delay: 0.3s;">
           <Image src={aboutImg} alt="Tiffany Webb Portrait" class="about-hero-img" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </section>

    <!-- 2. The Story (Roots) -->
    <section class="roots section-pad theme-ink relative">
      <Waveform opacity={0.05} />
      
      <!-- Glowing Background Orb for effect -->
      <div class="ambient-glow" style="top: 30%; left: 50%; transform: translate(-50%, -50%); width: 60vw; height: 60vw; background: radial-gradient(circle, rgba(217, 162, 58, 0.08) 0%, transparent 70%);"></div>

      <div class="container relative z-10">
        
        <div class="text-center mb-20 reveal-up">
          <Eyebrow>The Origin</Eyebrow>
          <h2 class="massive-quote mx-auto">"When we rise,<br/><span class="italic-accent text-gold">we rise together.</span>"</h2>
          <div class="story-divider mx-auto mt-8"></div>
        </div>
        
        <!-- 3-Column Card Grid -->
        <div class="story-grid stagger-group">
          
          <div class="story-card ultra-glass-card stagger-item">
            <div class="ultra-padding-wrapper">
              <div class="card-icon">01</div>
              <h3 class="card-title">The Foundation</h3>
              <p class="card-text">Chicago-born with deep Louisiana roots. She learned resilience from the city and true hospitality from her family—always meet people exactly where they are.</p>
            </div>
          </div>
          
          <div class="story-card ultra-glass-card stagger-item" style="transition-delay: 0.1s;">
            <div class="ultra-padding-wrapper">
              <div class="card-icon">02</div>
              <h3 class="card-title">The Work</h3>
              <p class="card-text">Over 15 years and 4,000+ hours of outreach. She operates in clinics, schools, and community centers, reaching the rooms most prevention programs never find.</p>
            </div>
          </div>
          
          <div class="story-card ultra-glass-card stagger-item" style="transition-delay: 0.2s;">
            <div class="ultra-padding-wrapper">
              <div class="card-icon">03</div>
              <h3 class="card-title">The Mission</h3>
              <p class="card-text">Blending behavioral health expertise with grassroots outreach. She exists to give families language for their pain, turning that pain into power for the overlooked.</p>
            </div>
          </div>
          
        </div>

        <!-- The heavy quote moved to a standalone cinematic banner below the cards -->
        <div class="cinematic-quote ultra-glass-card reveal-up mt-16">
           <div class="ultra-padding-wrapper text-center">
             <h3 class="quote-text">"Gambling harm hides. It doesn't smell like alcohol or show up on a drug test. It shows up as a missing paycheck... By the time most families name it, they have been carrying it alone for years."</h3>
           </div>
        </div>

      </div>
    </section>

    <!-- 3. Professional Journey (Alternating Vertical Timeline) -->
    <section class="journey section-pad theme-ink relative">
      <Waveform opacity={0.03} />
      <div class="container reveal-up">
        <div class="text-center mb-16">
          <Eyebrow>The Path Here</Eyebrow>
          <h2 class="section-title">Where all <span class="italic-accent">paths meet.</span></h2>
          <p class="subtitle mx-auto">Behavioral health taught her how harm works. Community outreach taught her how trust works. Public health education taught her how to scale a message. Prevention is where all three meet.</p>
        </div>
        
        <div class="vertical-timeline">
          <div class="timeline-center-line"></div>
          
          <div class="v-timeline-item left reveal-in">
            <div class="v-timeline-content ultra-glass-card glass-sapphire">
              <span class="timeline-num">01</span>
              <h3>Behavioral Health</h3>
            </div>
          </div>
          
          <div class="v-timeline-item right reveal-in" style="transition-delay: 0.1s;">
            <div class="v-timeline-content ultra-glass-card glass-emerald">
              <span class="timeline-num">02</span>
              <h3>Community Outreach</h3>
            </div>
          </div>
          
          <div class="v-timeline-item left reveal-in">
            <div class="v-timeline-content ultra-glass-card glass-amethyst">
              <span class="timeline-num">03</span>
              <h3>Gambling Prevention</h3>
            </div>
          </div>
          
          <div class="v-timeline-item right reveal-in" style="transition-delay: 0.1s;">
            <div class="v-timeline-content ultra-glass-card glass-ruby">
              <span class="timeline-num">04</span>
              <h3>Public Health Education</h3>
            </div>
          </div>
          
          <div class="v-timeline-item left reveal-in">
            <div class="v-timeline-content ultra-glass-card glass-topaz">
              <span class="timeline-num">05</span>
              <h3>Partnership Building</h3>
            </div>
          </div>
          
          <div class="v-timeline-item right reveal-in" style="transition-delay: 0.1s;">
            <div class="v-timeline-content ultra-glass-card glass-obsidian">
              <span class="timeline-num">06</span>
              <h3>Community Impact Strategist</h3>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. Core (Mission, Vision, Values - Pure Glass Masonry Grid) -->
    <section class="core section-pad theme-ink relative">
      <div class="container">
        <div class="masonry-grid stagger-group">
          
          <!-- Mission: Full Width Panoramic -->
          <div class="masonry-item mission ultra-glass-card stagger-item">
            <div class="ultra-padding-wrapper">
              <Eyebrow className="eyebrow-padded">Mission</Eyebrow>
              <p class="mission-statement">So that no individual, family, or community faces gambling harm in silence, shame, or isolation — because prevention begins with a <span class="italic-accent">conversation.</span></p>
            </div>
          </div>
          
          <!-- Vision: Left Column -->
          <div class="masonry-item vision ultra-glass-card stagger-item">
            <div class="ultra-padding-wrapper">
              <Eyebrow className="eyebrow-padded">Vision</Eyebrow>
              <h2 class="mb-6 text-2xl font-serif text-ivory">Where this is going.</h2>
              <ul class="vision-list">
                <li><strong>National speaking:</strong> Bringing prevention conversations to stages, campuses, and conferences across the country.</li>
                <li><strong>Training & education:</strong> Equipping clinicians, educators, and frontline teams with tools that survive contact with real life.</li>
                <li><strong>Community:</strong> Building something people can join, wear, and carry into their own conversations.</li>
              </ul>
            </div>
          </div>
          
          <!-- Values: Right Column -->
          <div class="masonry-item values ultra-glass-card stagger-item">
            <div class="ultra-padding-wrapper">
              <Eyebrow className="eyebrow-padded">Values</Eyebrow>
              <h2 class="mb-6 text-2xl font-serif text-ivory">What she works from.</h2>
              <ul class="values-list interactive-list">
                <li><strong>Faith</strong> — the belief that people can change, including the ones everyone else gave up on.</li>
                <li><strong>Family</strong> — where prevention starts, and where harm is felt first and longest.</li>
                <li><strong>Community</strong> — nobody recovers alone, and nobody prevents alone either.</li>
                <li><strong>Purpose</strong> — turning lived understanding into practical service.</li>
                <li><strong>Impact</strong> — measured in conversations started, not talks delivered.</li>
              </ul>
            </div>
          </div>

        </div>
      </div>
    </section>
    
    <!-- 5. GambleFreeGear (Edge-to-Edge Immersive) -->
    <section class="gfg-immersive theme-ink relative" id="gamblefreegear">
      <Waveform opacity={0.08} flipX={true} variant="C" />
      <div class="gfg-bg-text">GFG</div>
      <div class="gfg-overlay"></div>
      
      <div class="container relative z-10 gfg-content reveal-up">
        <Eyebrow className="gfg-eyebrow">A Venture by Tiffany Webb</Eyebrow>
        <h2 class="gfg-title">GambleFreeGear</h2>
        <p class="gfg-subtitle">
          Prevention you can wear. An apparel brand designed to break the silence on gambling addiction and start conversations in the communities that need them most.
        </p>
        <div class="mt-8">
          <Button href="https://inpowerimports.com" variant="secondary" className="magnetic-btn gfg-btn" target="_blank">Visit GambleFreeGear &rarr;</Button>
        </div>
      </div>
    </section>

    <!-- 6. Closing CTA -->
    <section class="closing section-pad theme-ink text-center reveal-up">
      <div class="container">
        <h2>Let's start a conversation.</h2>
        <p class="subtitle mx-auto mb-8 mt-4">Whether you're planning a conference, building a prevention program, or trying to reach a community that hasn't responded to anything yet — that's the work.</p>
        <Button href="/book" variant="primary" className="magnetic-btn">Invite Tiffany to Speak &rarr;</Button>
      </div>
    </section>

  </main>
</Layout>

<style>
  .page-content {
    background: var(--color-ink);
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  .section-pad {
    padding: var(--sp-24) 0;
  }

  /* Typography Utilities */
  .subtitle {
    font-size: 1.125rem;
    color: rgba(231, 224, 207, 0.8);
    max-width: 800px;
    line-height: 1.6;
  }
  .mx-auto { margin-left: auto; margin-right: auto; }
  .text-center { text-align: center; }
  .mb-4 { margin-bottom: var(--sp-4); }
  .mb-6 { margin-bottom: var(--sp-6); }
  .mb-8 { margin-bottom: var(--sp-8); }
  .mb-16 { margin-bottom: var(--sp-16); }
  .mt-4 { margin-top: var(--sp-4); }
  .mt-8 { margin-top: var(--sp-8); }
  .relative { position: relative; }
  .z-10 { z-index: 10; }
  .text-2xl { font-size: 1.5rem; }
  .font-serif { font-family: var(--font-serif); }
  .text-ivory { color: var(--color-ivory); }
  
  .italic-accent {
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(92deg, var(--color-mustard), var(--color-coral), var(--color-berry));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* 1. Hero */
  .inner-hero {
    position: relative;
    padding: calc(var(--sp-24) + 80px) 0 var(--sp-12);
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
    align-items: center;
    position: relative;
    z-index: 2;
  }

  @media (min-width: 992px) {
    .hero-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .inner-hero-title {
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1.1;
    margin-bottom: var(--sp-6);
    color: var(--color-ivory);
  }

  .inner-hero-sub {
    color: var(--color-gold);
    letter-spacing: 0.1em;
  }

  .hero-image-wrap {
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
    aspect-ratio: 3/4;
    border-radius: 200px 24px 200px 24px;
    overflow: hidden;
    border: 1px solid rgba(217, 162, 58, 0.4);
    box-shadow: 0 20px 50px rgba(0,0,0,0.5);
    position: relative;
  }

  .about-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  /* Morphing Blob Animation for Hero Image */
  .blob-shape {
    animation: blob-morph 12s ease-in-out infinite alternate;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
  }
  .blob-shape:hover {
    transform: scale(1.03) rotate(-2deg);
    box-shadow: 0 30px 60px rgba(0,0,0,0.7);
    animation-play-state: paused;
  }

  @keyframes blob-morph {
    0% { border-radius: 200px 24px 200px 24px; }
    33% { border-radius: 120px 200px 24px 180px; }
    66% { border-radius: 24px 150px 200px 100px; }
    100% { border-radius: 200px 100px 24px 200px; }
  }

  /* Pure Apple-Style Glassmorphism */
  .ultra-glass-card {
    background: rgba(255, 255, 255, 0.02); /* Extremely faint frost, absolutely no tint */
    backdrop-filter: blur(32px) saturate(120%);
    -webkit-backdrop-filter: blur(32px) saturate(120%);
    border: 1px solid rgba(255, 255, 255, 0.08); /* Delicate, elegant glowing edge */
    border-radius: 32px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    position: relative;
    overflow: hidden; /* Cleanly clips the corners */
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease, border-color 0.6s ease, background 0.6s ease;
  }

  .ultra-glass-card:hover {
    transform: translateY(-8px) rotate(0.5deg);
    box-shadow: 0 30px 60px rgba(0,0,0,0.6), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Premium Jewel-Toned Colors */
  .glass-sapphire {
    background: rgba(15, 45, 90, 0.15);
    border-color: rgba(100, 150, 255, 0.1);
  }
  .glass-sapphire:hover {
    background: rgba(15, 45, 90, 0.25);
    border-color: rgba(100, 150, 255, 0.2);
  }

  .glass-emerald {
    background: rgba(15, 60, 40, 0.15);
    border-color: rgba(100, 255, 150, 0.1);
  }
  .glass-emerald:hover {
    background: rgba(15, 60, 40, 0.25);
    border-color: rgba(100, 255, 150, 0.2);
  }

  .glass-amethyst {
    background: rgba(50, 20, 60, 0.15);
    border-color: rgba(200, 100, 255, 0.1);
  }
  .glass-amethyst:hover {
    background: rgba(50, 20, 60, 0.25);
    border-color: rgba(200, 100, 255, 0.2);
  }

  .glass-ruby {
    background: rgba(70, 20, 25, 0.15);
    border-color: rgba(255, 100, 100, 0.1);
  }
  .glass-ruby:hover {
    background: rgba(70, 20, 25, 0.25);
    border-color: rgba(255, 100, 100, 0.2);
  }

  .glass-topaz {
    background: rgba(80, 50, 10, 0.15);
    border-color: rgba(255, 200, 100, 0.1);
  }
  .glass-topaz:hover {
    background: rgba(80, 50, 10, 0.25);
    border-color: rgba(255, 200, 100, 0.2);
  }

  .glass-obsidian {
    background: rgba(30, 30, 35, 0.3);
    border-color: rgba(217, 162, 58, 0.15); /* Gold border for final card */
  }
  .glass-obsidian:hover {
    background: rgba(30, 30, 35, 0.4);
    border-color: rgba(217, 162, 58, 0.3);
  }

  /* Massive Padding Wrapper to prevent clipping */
  .ultra-padding-wrapper {
    padding: 3.5rem;
    position: relative;
    z-index: 2;
  }

  /* Ensure Eyebrow text never bleeds into border */
  .eyebrow-padded {
    display: block; /* Force block to prevent inline clipping */
    line-height: 1.5;
    margin-bottom: var(--sp-6) !important;
  }
  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    filter: blur(40px);
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }
  
  @media (min-width: 1024px) {
    .story-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .story-card {
    height: 100%;
    /* Add a continuous floating animation */
    animation: float-slow 6s ease-in-out infinite;
  }
  
  /* Stagger the floating animations */
  .story-card:nth-child(1) { animation-delay: 0s; }
  .story-card:nth-child(2) { animation-delay: -2s; }
  .story-card:nth-child(3) { animation-delay: -4s; }

  @keyframes float-slow {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* Suspend float animation on hover and use standard glass hover */
  .story-card:hover {
    animation-play-state: paused;
    transform: translateY(-15px) scale(1.02);
  }

  .card-icon {
    font-family: var(--font-mono);
    color: var(--color-gold);
    font-size: 1.5rem;
    margin-bottom: var(--sp-6);
    opacity: 0.8;
  }

  .card-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--color-ivory);
    margin-bottom: var(--sp-4);
  }

  .card-text {
    font-size: 1.1rem;
    line-height: 1.7;
    color: rgba(231, 224, 207, 0.85);
  }

  .cinematic-quote {
    background: rgba(217, 162, 58, 0.03); /* slight gold tint */
    border-color: rgba(217, 162, 58, 0.15);
  }
  
  .quote-text {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2.2rem);
    line-height: 1.4;
    color: var(--color-gold);
    font-style: italic;
  }

  .massive-quote {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 1.05;
    color: var(--color-ivory);
    margin-bottom: var(--sp-8);
  }

  .story-divider {
    width: 80px;
    height: 2px;
    background: var(--color-gold);
    margin-bottom: var(--sp-6);
  }

  /* 3. Vertical Timeline */
  .vertical-timeline {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
    padding: var(--sp-8) 0;
  }

  .timeline-center-line {
    position: absolute;
    left: 24px;
    top: 0;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, rgba(217, 162, 58, 0.5), transparent);
  }

  @media (min-width: 768px) {
    .timeline-center-line {
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .v-timeline-item {
    position: relative;
    width: calc(100% - 48px);
    margin-left: 48px;
    margin-bottom: var(--sp-8);
  }

  @media (min-width: 768px) {
    .v-timeline-item {
      width: 45%;
      margin-bottom: var(--sp-4); /* Negative margin/overlap can be used if desired, keeping standard for now */
    }
    
    .v-timeline-item.left {
      margin-left: 0;
      margin-right: auto;
      text-align: right;
    }
    
    .v-timeline-item.right {
      margin-left: auto;
      margin-right: 0;
      text-align: left;
    }
    
    /* Center Node Dots */
    .v-timeline-item::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 12px;
      height: 12px;
      background: var(--color-ink);
      border: 2px solid var(--color-gold);
      border-radius: 50%;
      transform: translateY(-50%);
      z-index: 2;
      transition: background 0.3s ease, box-shadow 0.3s ease;
    }
    
    .v-timeline-item.left::after {
      right: -24px; /* Move past edge to center line (5% gap + half line width) */
      /* Precise math is tricky with %, using fixed offset approach */
      right: calc(-11.11% - 6px); /* Roughly centers on the 50% line */
    }
    .v-timeline-item.right::after {
      left: calc(-11.11% - 6px);
    }
    
    .v-timeline-item:hover::after {
      background: var(--color-gold);
      box-shadow: 0 0 15px rgba(217, 162, 58, 0.6);
    }
  }

  .v-timeline-content {
    padding: 2.5rem 3rem;
  }

  .timeline-num {
    font-family: var(--font-mono);
    color: var(--color-gold);
    font-size: 0.875rem;
    opacity: 0.8;
    display: block;
    margin-bottom: var(--sp-2);
  }

  .v-timeline-content h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    color: var(--color-ivory);
  }

  /* 4. Core Masonry Grid */
  .masonry-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }

  @media (min-width: 992px) {
    .masonry-grid {
      grid-template-columns: 1fr 1.2fr;
    }
    .mission {
      grid-column: 1 / -1; /* Full width top */
    }
    .vision {
      grid-column: 1 / 2;
    }
    .values {
      grid-column: 2 / 3;
    }
  }

  .mission-statement {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.3;
    color: var(--color-ivory);
    margin-top: var(--sp-4);
    max-width: 900px;
  }

  .vision-list, .values-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    color: rgba(231, 224, 207, 0.85);
  }

  .vision-list li, .values-list li {
    font-size: 1.05rem;
    line-height: 1.6;
    padding-left: var(--sp-6);
    position: relative;
  }

  .vision-list li::before, .values-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 10px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  /* Interactive List Hover Effect */
  .interactive-list li {
    transition: color 0.3s ease, transform 0.3s ease;
  }
  .interactive-list li:hover {
    color: var(--color-ivory);
    transform: translateX(4px);
  }
  .interactive-list li:hover::before {
    transform: scale(1.5);
    box-shadow: 0 0 10px var(--color-gold);
  }

  .vision-list strong, .values-list strong {
    color: var(--color-ivory);
    font-family: var(--font-sans);
  }

  /* 5. Gamble Free Gear (Immersive Edge-to-Edge) */
  .gfg-immersive {
    padding: var(--sp-32) 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-top: 1px solid rgba(255,255,255,0.05);
    border-bottom: 1px solid rgba(255,255,255,0.05);
  }

  .gfg-bg-text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-serif);
    font-size: 35vw;
    font-weight: 700;
    color: rgba(217, 162, 58, 0.03); /* Extremely faint gold */
    white-space: nowrap;
    z-index: 1;
    pointer-events: none;
    user-select: none;
    line-height: 1;
  }

  .gfg-overlay {
    position: absolute;
