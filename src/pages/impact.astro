---
import Layout from '../layouts/Layout.astro';
import ImpactHero from '../components/impact/ImpactHero.astro';
import UpcomingEngagements from '../components/impact/UpcomingEngagements.astro';
import PastEngagements from '../components/impact/PastEngagements.astro';
import OutcomeStories from '../components/impact/OutcomeStories.astro';
import ImpactPartners from '../components/impact/ImpactPartners.astro';
import ImpactGallery from '../components/impact/ImpactGallery.astro';
import EngagementJourney from '../components/impact/EngagementJourney.astro';
import BookingSection from '../components/BookingSection.astro';
---

<Layout title="Community Impact | Tiffany Webb" theme="secondary">
  <main class="page-content">
    
    <!-- 
      WHAT WE NEED FROM TIFFANY BEFORE THIS PAGE CAN BE REAL:
      - Past engagements: event name, date, host organisation, city, format, audience size — as many as she can recall, even approximate.
      - Written permission per named event and per named organisation.
      - Any outcome numbers she has, even rough — people screened, staff trained, students reached, resolutions passed.
      - Real photographs from real events, with permission.
      - Three contacts willing to give a testimonial, and permission to approach them.
      - Her partner list with the relationship type for each.
    -->

    <ImpactHero />
    <UpcomingEngagements />
    <PastEngagements />
    <OutcomeStories />
    <ImpactPartners />
    <ImpactGallery />
    <EngagementJourney />
    <BookingSection hideJourney={true} />
    
  </main>
</Layout>
