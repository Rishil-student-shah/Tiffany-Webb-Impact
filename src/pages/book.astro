---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
---

<Layout title="Book Tiffany | Tiffany Webb" description="Ready to bring Tiffany Webb to your next event? Submit a booking inquiry today." theme="secondary">
  <main class="page-content">
    
    <!-- 6.1 Hero -->
    <section class="inner-hero theme-dark">
      <div class="container reveal-up">
        <Eyebrow>Booking</Eyebrow>
        <h1 class="inner-hero-title">Bring Tiffany to your next event.</h1>
        <p class="inner-hero-sub">Tell us about your audience and your goals. She reviews every enquiry personally.</p>
      </div>
    </section>

    <!-- 6.2 Event Types (chips) & 6.4 Form -->
    <section class="booking-section section-pad bg-cream">
      <div class="container grid-2 stagger-group">
        
        <!-- Left: Form -->
        <div class="booking-form-wrapper stagger-item">
          <h2>Send your request.</h2>
          <form class="booking-form mt-8" onsubmit="event.preventDefault(); document.getElementById('success-msg').style.display='block'; this.style.display='none';">
            
            <div class="form-group">
              <label for="name">Your name *</label>
              <input type="text" id="name" name="name" required />
            </div>
            
            <div class="form-group">
              <label for="org">Organization *</label>
              <input type="text" id="org" name="org" required />
            </div>
            
            <div class="form-group">
              <label for="email">Email address *</label>
              <input type="email" id="email" name="email" required />
            </div>
            
            <div class="form-group">
              <label for="phone">Phone (optional)</label>
              <input type="tel" id="phone" name="phone" />
            </div>
            
            <div class="form-group full-width">
              <label for="event_type">What kind of event? *</label>
              <!-- Chips helper -->
              <div class="chip-group mt-2 mb-4">
                <button type="button" class="form-chip" onclick="document.getElementById('event_type').value = this.innerText;">Conference</button>
                <button type="button" class="form-chip" onclick="document.getElementById('event_type').value = this.innerText;">School or University</button>
                <button type="button" class="form-chip" onclick="document.getElementById('event_type').value = this.innerText;">Healthcare Organization</button>
                <button type="button" class="form-chip" onclick="document.getElementById('event_type').value = this.innerText;">Community Event</button>
                <button type="button" class="form-chip" onclick="document.getElementById('event_type').value = this.innerText;">Panel Discussion</button>
                <button type="button" class="form-chip" onclick="document.getElementById('event_type').value = this.innerText;">Workshop or Training</button>
                <button type="button" class="form-chip" onclick="document.getElementById('event_type').value = this.innerText;">Government or Public Health</button>
              </div>
              <input type="text" id="event_type" name="event_type" required />
            </div>
            
            <div class="form-group">
              <label for="date">Event date (or "flexible")</label>
              <input type="text" id="date" name="date" />
            </div>
            
            <div class="form-group">
              <label for="location">Location, or "virtual"</label>
              <input type="text" id="location" name="location" />
            </div>
            
            <div class="form-group">
              <label for="size">Approximate audience size</label>
              <select id="size" name="size">
                <option value="">Select size</option>
                <option value="Under 50">Under 50</option>
                <option value="50–150">50–150</option>
                <option value="150–500">150–500</option>
                <option value="500+">500+</option>
                <option value="Not sure yet">Not sure yet</option>
              </select>
            </div>
            
            <div class="form-group">
              <label for="budget">Budget range</label>
              <select id="budget" name="budget">
                <option value="">Select range</option>
                <option value="Under $2,500">Under $2,500</option>
                <option value="$2,500–$5,000">$2,500–$5,000</option>
                <option value="$5,000–$10,000">$5,000–$10,000</option>
                <option value="$10,000+">$10,000+</option>
                <option value="Honorarium only">Honorarium only</option>
                <option value="Prefer to discuss">Prefer to discuss</option>
              </select>
              <span class="text-micro helper-text">This just helps her understand what's possible for your organization. Nothing is fixed.</span>
            </div>
            
            <div class="form-group full-width">
              <label for="topic">Topic you have in mind</label>
              <select id="topic" name="topic">
                <option value="">Select topic</option>
                <option value="Prevention & Awareness">Prevention & Awareness</option>
                <option value="Treatment, Recovery & Professional Training">Treatment, Recovery & Professional Training</option>
                <option value="Family & Community Impact">Family & Community Impact</option>
                <option value="Creative & Promotional Engagement">Creative & Promotional Engagement</option>
                <option value="The flagship keynote">The flagship keynote</option>
                <option value="Not sure yet">Not sure yet</option>
              </select>
            </div>
            
            <div class="form-group full-width">
              <label for="message">Tell us about your event</label>
              <textarea id="message" name="message" rows="4"></textarea>
            </div>
            
            <div class="form-group full-width checkbox-group">
              <input type="checkbox" id="consent" name="consent" required />
              <label for="consent" class="consent-label">I agree to the <a href="/privacy" style="text-decoration: underline;">Privacy Policy</a></label>
            </div>
            
            <div class="form-group full-width mt-4">
              <button type="submit" class="btn btn-primary" style="width: 100%;">Submit Speaking Request &rarr;</button>
            </div>
            
          </form>
          
          <div id="success-msg" style="display: none;" class="mt-8">
            <h3>Thank you — your request is in.</h3>
            <p class="mt-4">Tiffany personally reviews every enquiry and responds within two business days. In the meantime, here's her speaker one-sheet.</p>
          </div>
        </div>

        <!-- Right: Process & FAQ -->
        <div class="booking-info stagger-item">
          <!-- 6.3 Process -->
          <div class="process-box mb-12">
            <h3>How booking works.</h3>
            <ol class="process-list mt-6">
              <li><strong>Enquiry</strong> — you share your event, audience, and dates.</li>
              <li><strong>Review</strong> — she personally reviews fit and availability.</li>
              <li><strong>Discovery call</strong> — a short conversation about what you actually need.</li>
              <li><strong>Proposal</strong> — format, content outline, and terms in writing.</li>
              <li><strong>Preparation</strong> — content built for your specific audience.</li>
              <li><strong>She speaks</strong> — and your audience leaves with something usable.</li>
            </ol>
          </div>
          
          <!-- 6.5 FAQ -->
          <div class="faq-box">
            <h3>Frequently Asked</h3>
            <div class="faq-accordion mt-6">
              <div class="faq-item">
                <button class="faq-trigger" aria-expanded="false">
                  <span class="faq-question">Does Tiffany travel?</span>
                  <span class="faq-icon">+</span>
                </button>
                <div class="faq-content">
                  <p>Yes. She speaks nationally, and also delivers virtual sessions and webinars when travel isn't practical for your budget or timeline.</p>
                </div>
              </div>
              
              <div class="faq-item">
                <button class="faq-trigger" aria-expanded="false">
                  <span class="faq-question">Can she tailor the content to our audience?</span>
                  <span class="faq-icon">+</span>
                </button>
                <div class="faq-content">
                  <p>Every session is built for the specific room. She'll ask about your audience, your goals, and what's already been tried before she writes anything.</p>
                </div>
              </div>
              
              <div class="faq-item">
                <button class="faq-trigger" aria-expanded="false">
                  <span class="faq-question">How far in advance should we book?</span>
                  <span class="faq-icon">+</span>
                </button>
                <div class="faq-content">
                  <p>Earlier is better, particularly for conference season and for March — Problem Gambling Awareness Month fills fastest. That said, she does accommodate shorter timelines when she can.</p>
                </div>
              </div>
              
              <div class="faq-item">
                <button class="faq-trigger" aria-expanded="false">
                  <span class="faq-question">How do we discuss budget?</span>
                  <span class="faq-icon">+</span>
                </button>
                <div class="faq-content">
                  <p>Share your range in the form and she'll tell you honestly what's possible. Organizations of very different sizes work with her, and the format usually flexes to fit.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        
      </div>
    </section>

  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const faqTriggers = document.querySelectorAll('.faq-trigger');
    faqTriggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
        // Close all others
        faqTriggers.forEach(t => {
          t.setAttribute('aria-expanded', 'false');
          t.nextElementSibling.style.maxHeight = null;
        });
        
        // Toggle current
        if (!isExpanded) {
          trigger.setAttribute('aria-expanded', 'true');
          const content = trigger.nextElementSibling;
          content.style.maxHeight = content.scrollHeight + "px";
        }
      });
    });
  });
</script>

<style>
  .page-content {
    padding-top: 0;
  }

  .inner-hero {
    background-color: var(--color-ink);
    color: var(--color-ivory);
    padding: calc(var(--sp-24) + 80px) 0 var(--sp-12);
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  .inner-hero-title {
    margin-bottom: var(--sp-4);
  }

  .inner-hero-sub {
    font-size: 1.25rem;
    color: rgba(253, 252, 248, 0.8);
    max-width: 700px;
  }

  .section-pad { padding: var(--sp-24) 0; }
  .bg-cream { background-color: var(--color-cream); }
  .mt-8 { margin-top: var(--sp-8); }
  .mt-6 { margin-top: var(--sp-6); }
  .mt-4 { margin-top: var(--sp-4); }
  .mt-2 { margin-top: var(--sp-2); }
  .mb-12 { margin-bottom: var(--sp-12); }
  .mb-4 { margin-bottom: var(--sp-4); }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-12);
  }

  @media (min-width: 1024px) {
    .grid-2 {
      grid-template-columns: 3fr 2fr;
      gap: var(--sp-16);
    }
  }

  /* Form Styles */
  .booking-form {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
    background-color: var(--color-ivory);
    padding: var(--sp-8);
    border: 1px solid var(--border-light);
  }

  @media (min-width: 768px) {
    .booking-form {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .full-width {
    grid-column: 1 / -1;
  }

  label {
    font-weight: 500;
    margin-bottom: var(--sp-2);
    color: var(--color-charcoal);
  }

  input[type="text"],
  input[type="email"],
  input[type="tel"],
  select,
  textarea {
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border-light);
    background-color: transparent;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-ink);
    border-radius: 2px;
    transition: border-color 0.3s ease;
  }

  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--color-gold);
  }

  .helper-text {
    color: var(--color-muted-grey);
    margin-top: var(--sp-2);
    display: block;
  }

  .checkbox-group {
    flex-direction: row;
    align-items: center;
    gap: var(--sp-3);
  }
  
  .checkbox-group input {
    width: 20px;
    height: 20px;
  }

  .consent-label {
    margin-bottom: 0;
    font-weight: 400;
  }

  /* Chips */
  .chip-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .form-chip {
    padding: var(--sp-1) var(--sp-3);
    font-size: 0.875rem;
    background-color: var(--color-cream);
    border: 1px solid var(--border-light);
    border-radius: 100px;
    color: var(--color-charcoal);
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .form-chip:hover {
    background-color: var(--border-light);
  }

  /* Info sidebar */
  .process-box, .faq-box {
    background-color: var(--color-ivory);
    padding: var(--sp-8);
    border: 1px solid var(--border-light);
  }

  .process-box h3, .faq-box h3 {
    font-size: 1.5rem;
    color: var(--color-emerald);
  }

  .process-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding-left: var(--sp-6);
  }

  .process-list li {
    color: var(--color-charcoal);
  }

  .process-list strong {
    color: var(--color-ink);
  }

  /* FAQ Accordion */
  .faq-accordion {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .faq-item {
    border-bottom: 1px solid var(--border-light);
  }

  .faq-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--sp-4) 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    color: var(--color-ink);
    font-size: 1.125rem;
    font-weight: 500;
  }

  .faq-icon {
    color: var(--color-emerald);
    font-size: 1.5rem;
    transition: transform 0.3s ease;
  }

  .faq-trigger[aria-expanded="true"] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .faq-content p {
    color: var(--color-charcoal);
    padding-bottom: var(--sp-4);
    margin: 0;
  }

  /* Button */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-4) var(--sp-8);
    font-family: var(--font-mono);
    font-size: var(--text-button);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.3s ease;
    border-radius: 2px;
    cursor: pointer;
  }
  .btn-primary {
    background-color: var(--color-gold);
    color: var(--color-ink);
    border: 1px solid var(--color-gold);
  }
  .btn-primary:hover {
    background-color: #E5C354;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(212, 175, 55, 0.2);
  }
</style>
