    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 1.5rem;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .header-left-cluster {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .bio-num-tag {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    font-weight: 800;
