    margin: 0 0 1.4rem 0;
    font-weight: 400;
  }

  .bio-text-content p:last-child {
    margin-bottom: 0;
  }

  /* Footer Bar */
  .dribbble-bio-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1.25rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .footer-left-status {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .status-txt {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #CFC5B0 !important;
    font-weight: 500;
  }

  .footer-right-count {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: #D9A23A !important;
    letter-spacing: 0.1em;
  }

  /* ---------------------------------------------------- */
  /* EMCEE CARD                                           */
  /* ---------------------------------------------------- */
  .dribbble-emcee-card {
    background: #17140F;
    border: 1px solid rgba(217, 162, 58, 0.35);
    border-radius: 20px;
    padding: 2.75rem;
