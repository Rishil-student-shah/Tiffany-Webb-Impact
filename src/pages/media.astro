---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Waveform from '../components/Waveform.astro';
import Button from '../components/Button.astro';
import PageNavigation from '../components/PageNavigation.astro';
import mysql from 'mysql2/promise';

let dbContent = {};
let dbCollections = {};

try {
  const pool = mysql.createPool({
    host: 'localhost',
    user: 'root',
    password: '@rishil8124shah',
    database: 'tiffany_crm',
    waitForConnections: true,
    connectionLimit: 10,
    queueLimit: 0
  });

  const [rows] = await pool.query(`
    SELECT section, key_name, content_value 
    FROM website_content 
    JOIN website_pages ON website_content.page_id = website_pages.id 
    WHERE website_pages.slug = 'media'
  `);
  
  rows.forEach(row => {
    if (!dbContent[row.section]) dbContent[row.section] = {};
    dbContent[row.section][row.key_name] = row.content_value;
  });

  const [colRows] = await pool.query(`
    SELECT id, section_name, item_slug, title, sort_order, subtitle, badge, content_html, link_url, image_url, icon_svg 
    FROM website_collections 
    JOIN website_pages ON website_collections.page_id = website_pages.id 
    WHERE website_pages.slug = 'media'
    ORDER BY section_name, sort_order ASC
  `);
  
  colRows.forEach(row => {
    if (!dbCollections[row.section_name]) dbCollections[row.section_name] = [];
    dbCollections[row.section_name].push(row);
  });
  await pool.end();
} catch (e) {
  console.error("Database connection failed for media page, using fallbacks:", e);
}

const colorThemes = [
  { color: "#6C2D5A", borderColor: "rgba(108, 45, 90, 0.5)", bgBadge: "rgba(108, 45, 90, 0.2)" },
  { color: "#D9A23A", borderColor: "rgba(217, 162, 58, 0.5)", bgBadge: "rgba(217, 162, 58, 0.2)" },
  { color: "#0E6B54", borderColor: "rgba(14, 107, 84, 0.5)", bgBadge: "rgba(14, 107, 84, 0.2)" }
];

const fallbackBios = [
  {
    id: "short",
    label: "SHORT BIO",
    words: "~50 WORDS",
    subtitle: "For Event Programs, Printed Flyers & Social Media",
    text: "Tiffany Webb is a Chicago-born Community Impact Strategist and Public Health Speaker with over 15 years of experience in behavioral health and public health education. She brings lived insight and clinical rigor to problem gambling prevention, youth digital risk, and human-centered community health strategies across Illinois and nationally."
  },
  {
    id: "medium",
    label: "MEDIUM BIO",
    words: "~150 WORDS",
    subtitle: "For Conference Programs, Agendas & Website Speaker Profiles",
    text: "Tiffany Webb is a Community Impact Strategist, Public Health Educator, and Speaker specializing in problem gambling prevention, youth digital risk, and community health strategy. With over 15 years of leadership across behavioral health systems and more than 4,000 hours of frontline community outreach, Tiffany bridges the gap between clinical protocols and community trust.\n\nShe is the founder of GambleFreeGear and the creator of the GEAR Method™ (Generate, Engage, Activate, Resource). An affiliate speaker with the Illinois Council on Problem Gambling (ICPG) and an active advisor to regional ROSC coalitions, Tiffany is trusted by healthcare networks, civic leaders, and youth organizations to deliver high-impact keynotes and actionable workshops."
  },
  {
    id: "long",
    label: "LONG BIO",
    words: "~300 WORDS",
    subtitle: "For Keynote Introductions, Press Releases & Feature Articles",
    text: "Tiffany Webb is a Community Impact Strategist, Public Health Educator, and Speaker dedicated to transforming how organizations, healthcare systems, and communities address behavioral addiction, emerging digital risks, and public health equity. Raised by her grandmother and a close village of family in Chicago with deep Louisiana roots, Tiffany learned early that true community support requires showing up with empathy, consistency, and respect.\n\nOver the past 15 years, Tiffany has worked across healthcare networks, municipal health agencies, and grassroots recovery coalitions. With more than 4,000 hours of frontline outreach, she specializes in identifying hidden behavioral addictions—including mobile sports wagering and youth digital gaming—that traditional intake protocols often overlook.\n\nShe is the creator of the GEAR Method™ (Generate, Engage, Activate, Resource), a proprietary four-phase framework that helps institutions move from passive awareness to sustainable community action. Tiffany is also the founder of GambleFreeGear, a mission-driven awareness enterprise providing wearable advocacy and educational resources.\n\nAn affiliate speaker with the Illinois Council on Problem Gambling (ICPG) and a trusted facilitator for Recovery Oriented Systems of Care (ROSC) councils, Tiffany delivers evidence-based, emotionally resonant keynotes, clinical trainings, and executive advisory sessions across the country."
  }
];

const bios = (dbCollections.bios && dbCollections.bios.length > 0)
  ? dbCollections.bios.map((b, idx) => ({
      id: b.item_slug || (idx === 0 ? "short" : idx === 1 ? "medium" : "long"),
      label: b.title || (idx === 0 ? "SHORT BIO" : idx === 1 ? "MEDIUM BIO" : "LONG BIO"),
      words: b.badge || (idx === 0 ? "~50 WORDS" : idx === 1 ? "~150 WORDS" : "~300 WORDS"),
      subtitle: b.subtitle || (idx === 0 ? "For Event Programs & Social Media" : idx === 1 ? "For Conference Agendas & Speaker Profiles" : "For Keynote Introductions & Feature Articles"),
      text: b.content_html || b.content_value || b.description || "",
      ...colorThemes[idx % colorThemes.length]
    }))
  : fallbackBios.map((b, idx) => ({
      ...b,
      ...colorThemes[idx % colorThemes.length]
    }));

const emceeScript = dbContent.intro_script?.script_text || `Please welcome Tiffany Webb — Community Impact Strategist, Public Health Educator, and founder of GambleFreeGear. With over 15 years of experience across behavioral health and community systems, Tiffany helps healthcare networks, schools, and civic leaders reimagine prevention and build human-centered strategies that last. Please join me in welcoming Tiffany Webb!`;

const downloadColors = [
  { color: "#D9A23A", borderColor: "rgba(217, 162, 58, 0.45)", bgBadge: "rgba(217, 162, 58, 0.18)" },
  { color: "#6C2D5A", borderColor: "rgba(108, 45, 90, 0.55)", bgBadge: "rgba(108, 45, 90, 0.22)" },
  { color: "#0E6B54", borderColor: "rgba(14, 107, 84, 0.55)", bgBadge: "rgba(14, 107, 84, 0.22)" },
  { color: "#C15427", borderColor: "rgba(193, 84, 39, 0.55)", bgBadge: "rgba(193, 84, 39, 0.22)" }
];

const fallbackDownloads = [
  {
    title: "Speaker One-Sheet PDF",
    tag: "FOR EVENT ORGANIZERS",
    desc: "Single-page executive overview of signature topics, speaking formats, and organizer credentials. Perfect for committee review.",
    link: "/downloads/Tiffany_Webb_Speaker_One_Sheet.pdf",
    btnText: "Download One-Sheet &darr;"
  },
  {
    title: "Official Headshot (Print Resolution)",
    tag: "HIGH-RES 300 DPI · CMYK",
    desc: "Approved print-quality photography for conference booklets, printed programs, and event banners.",
    link: "/uploads/tiffany_headshot_print.jpg",
    btnText: "Download Print Image &darr;"
  },
  {
    title: "Official Headshot (Digital / Web)",
    tag: "WEB READY · RGB",
    desc: "Optimized web-ready portrait for social media promotion, event landing pages, and slide decks.",
    link: "/uploads/tiffany_headshot_web.jpg",
    btnText: "Download Web Image &darr;"
  },
  {
    title: "Media & Brand Kit (ZIP)",
    tag: "COMPLETE ASSET PACK",
    desc: "All approved bios, introduction script, logos, and photography in one convenient download package.",
    link: "/downloads/Tiffany_Webb_Media_Kit.zip",
    btnText: "Download Media Kit (ZIP) &darr;"
  }
];

const downloads = (dbCollections.downloads && dbCollections.downloads.length > 0)
  ? dbCollections.downloads.map((d, idx) => ({
      title: d.title,
      tag: d.badge || d.subtitle || "PRESS ASSET",
      desc: d.content_html || d.description || d.content_value || "",
      link: d.link_url || "/downloads/Tiffany_Webb_Media_Kit.zip",
      btnText: "Download &darr;",
      ...downloadColors[idx % downloadColors.length]
    }))
  : fallbackDownloads.map((d, idx) => ({
      ...d,
      ...downloadColors[idx % downloadColors.length]
    }));

const eyebrow = dbContent.hero?.eyebrow ?? "PRESS KIT & MEDIA ASSETS";
let headline = dbContent.hero?.headline ?? 'Official speaker <span class="italic-accent">press kit.</span>';
const subtitle = dbContent.hero?.subtitle ?? "Approved bios, high-resolution photography, stage introduction script, and promotional assets for conference chairs, event organizers, and journalists.";
---

<Layout title="Press Kit & Media Assets | Tiffany Webb" description="Official press kit, approved speaker bios, stage introduction script, and high-resolution headshots for Tiffany Webb." theme="dark">
  <main class="page-content bg-ink">
    
    <!-- Hero Header -->
    <section class="media-hero-section relative overflow-hidden">
      <Waveform opacity={0.06} variant="A" flipX={true} />
      
      <div class="media-container relative z-10 text-center">
        <div class="section-header-block reveal-up" style="max-width: 860px; margin-bottom: 0;">
          <Eyebrow className="justify-center text-center">{eyebrow}</Eyebrow>
          <h1 class="media-h1" set:html={headline}></h1>
          <p class="media-subtitle">{subtitle}</p>
        </div>
      </div>
    </section>

    <!-- Section 1: Approved Biographies (Fail-Safe Executive Tabbed Reader) -->
    <section class="media-section relative overflow-hidden" id="approved-bios">
      <Waveform opacity={0.03} variant="B" />
      <div class="media-container relative z-10" style="max-width: 1000px; margin: 0 auto; padding: 0 1.5rem;">
        
        <!-- Section Header -->
        <div class="section-header-block reveal-up" style="text-align: center; margin-bottom: 3rem;">
          <Eyebrow className="justify-center text-center">OFFICIAL BIOGRAPHIES</Eyebrow>
          <h2 class="media-h2" style="font-family: var(--font-serif); font-size: clamp(2.2rem, 4vw, 3.4rem); color: #FBF6EA; margin: 0.5rem 0 1rem 0;">
            Approved <span class="italic-accent">biographies.</span>
          </h2>
          <p class="section-subtext" style="font-size: 1.15rem; color: rgba(251, 246, 234, 0.85); max-width: 680px; margin: 0 auto;">
            Select the length that best fits your program format. Click "Copy Bio" to copy the formatted text directly to your clipboard.
          </p>
        </div>

        <!-- Luxury Gold Pill Tabs -->
        <div class="bio-tabs-container" style="display: flex; justify-content: center; gap: 1rem; margin-bottom: 2.5rem; flex-wrap: wrap;">
          <button class="bio-tab-pill" data-bio-target="short" type="button" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.75rem; border-radius: 9999px; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.25s ease; background: #1A1713; color: #FBF6EA; border: 1px solid rgba(255, 255, 255, 0.2);">
            <span>SHORT BIO</span>
            <span style="opacity: 0.5; font-size: 0.75rem;">(~50w)</span>
          </button>
          
          <button class="bio-tab-pill active-tab" data-bio-target="medium" type="button" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.75rem; border-radius: 9999px; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.25s ease; background: #D9A23A; color: #0D0C08; border: 1px solid #D9A23A; box-shadow: 0 4px 20px rgba(217, 162, 58, 0.3);">
            <span>MEDIUM BIO</span>
            <span style="font-size: 0.75rem; font-weight: 800;">(~150w)</span>
          </button>
          
          <button class="bio-tab-pill" data-bio-target="long" type="button" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.85rem 1.75rem; border-radius: 9999px; font-family: var(--font-mono); font-size: 0.85rem; font-weight: 700; cursor: pointer; transition: all 0.25s ease; background: #1A1713; color: #FBF6EA; border: 1px solid rgba(255, 255, 255, 0.2);">
            <span>LONG BIO</span>
            <span style="opacity: 0.5; font-size: 0.75rem;">(~300w)</span>
          </button>
        </div>

        <!-- Single Executive Reader Card (Strict Inline Display Guard) -->
        <div class="bio-reader-card" style="background: #14120E; border: 1px solid rgba(217, 162, 58, 0.4); border-radius: 24px; padding: 3.25rem 2.75rem; box-shadow: 0 25px 50px rgba(0,0,0,0.6); position: relative;">
          
          {bios.map((bio, index) => {
            // Default to Medium Bio (index 1) active on load
            const isDefault = (bio.id === "medium" || index === 1);
            return (
              <div 
                class="bio-panel" 
                id={`bio-panel-${bio.id}`} 
                style={isDefault ? "display: block;" : "display: none;"}
              >
                <!-- Card Top: Centered Meta & Centered Copy Button -->
                <div class="bio-card-top-header" style="display: flex; flex-direction: column; align-items: center; text-align: center; border-bottom: 1px solid rgba(255, 255, 255, 0.12); padding-bottom: 2rem; margin-bottom: 2.25rem; gap: 1.25rem;">
                  <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem;">
                    <div style="display: flex; align-items: center; justify-content: center; gap: 0.75rem;">
                      <span style="font-family: var(--font-mono); font-size: 0.8rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; padding: 0.35rem 0.95rem; border-radius: 6px; background: rgba(217, 162, 58, 0.18); color: #D9A23A; border: 1px solid rgba(217, 162, 58, 0.4);">
                        {bio.label}
                      </span>
                      <span style="font-family: var(--font-mono); font-size: 0.8rem; color: #FBF6EA; opacity: 0.85; font-weight: 600;">
                        {bio.words}
                      </span>
                    </div>
                    <p style="font-family: var(--font-mono); font-size: 0.9rem; color: #D9A23A; margin: 0; font-weight: 600;">
                      {bio.subtitle}
                    </p>
                  </div>

                  <!-- Centered Copy Button with Luxury Hover State -->
                  <div style="display: flex; justify-content: center; align-items: center; width: 100%;">
                    <button 
                      class="copy-btn copy-bio-btn" 
                      data-copy-target={`bio-text-${bio.id}`} 
                      type="button"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                      <span class="copy-text">Copy Bio to Clipboard</span>
                    </button>
                  </div>
                </div>

                <!-- Card Body: Bio Text -->
                <div style="min-height: 160px; max-width: 880px; margin: 0 auto;">
                  <p id={`bio-text-${bio.id}`} style="font-family: var(--font-sans); font-size: 1.15rem; line-height: 1.85; color: #FFFFFF !important; margin: 0; white-space: pre-line; font-weight: 400; text-align: left;">
                    {bio.text}
                  </p>
                </div>

                <!-- Card Footer: Verification Tag -->
                <div style="border-top: 1px solid rgba(255, 255, 255, 0.08); margin-top: 2.25rem; padding-top: 1.5rem; text-align: center; font-family: var(--font-mono); font-size: 0.82rem; color: rgba(251, 246, 234, 0.6);">
                  ✓ Approved for conference programs, press releases, website speaker profiles, and printed event marketing.
                </div>
              </div>
            );
          })}
        </div>

      </div>
    </section>

    <!-- Section 2: Stage Emcee Introduction Script -->
    <section class="media-section relative overflow-hidden" id="emcee-script" style="background: rgba(18, 16, 12, 0.75);">
      <Waveform opacity={0.04} variant="C" flipY={true} />
      <div class="media-container relative z-10">
        
        <div class="section-header-block reveal-up">
          <Eyebrow className="justify-center text-center">STAGE INTRODUCTION</Eyebrow>
          <h2 class="media-h2">Emcee introduction <span class="italic-accent">script.</span></h2>
          <p class="section-subtext">Recommended verbatim script for event hosts and session moderators when introducing Tiffany to the stage.</p>
        </div>

        <div class="emcee-box reveal-up" style="max-width: 960px; margin: 0 auto;">
          <div class="emcee-header">
            <span class="emcee-badge">VERBATIM STAGE SCRIPT (~30 SECONDS)</span>
            <button class="copy-btn copy-btn-large" data-copy-target="emcee-script-text" type="button" style="border-color: var(--color-gold); color: var(--color-gold);">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span class="copy-text">Copy Script</span>
            </button>
          </div>
          
          <blockquote class="emcee-quote">
            <p id="emcee-script-text">"{emceeScript}"</p>
          </blockquote>
        </div>

      </div>
    </section>

    <!-- Section 3: Downloadable Speaker Assets (4 Color-Accented Cards) -->
    <section class="media-section relative overflow-hidden" id="downloads">
      <Waveform opacity={0.03} variant="A" />
      <div class="media-container relative z-10" style="max-width: 1200px; margin: 0 auto;">
        
        <div class="section-header-block reveal-up">
          <Eyebrow className="justify-center text-center">MEDIA ASSETS & DOWNLOADS</Eyebrow>
          <h2 class="media-h2">High-resolution <span class="italic-accent">downloads.</span></h2>
          <p class="section-subtext">Official photography, one-sheets, and comprehensive brand materials for media publications and event marketing.</p>
        </div>

        <div class="downloads-grid stagger-group">
          {downloads.map((item) => (
            <div class="download-card stagger-item" style={`border-color: ${item.borderColor};`}>
              <div class="download-card-top">
                <span class="download-tag" style={`color: ${item.color}; border: 1px solid ${item.color}66; background: ${item.bgBadge};`}>
                  {item.tag}
                </span>
                <h3 class="download-title">{item.title}</h3>
                <p class="download-desc">{item.desc}</p>
              </div>

              <div class="download-action">
                <a href={item.link} class="download-btn" style={`color: ${item.color}; border: 1px solid ${item.color}66; background: ${item.color}15;`} download>
                  <span set:html={item.btnText}></span>
                </a>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- Section 4: Media & Podcast Interview Inquiry Banner -->
    <section class="media-inquiry-banner relative overflow-hidden">
      <Waveform opacity={0.06} variant="B" />
      
      <div class="media-container relative z-10 text-center" style="max-width: 880px; margin: 0 auto; padding: 5rem 1.5rem;">
        <div class="section-header-block reveal-up" style="margin-bottom: 2.5rem;">
          <Eyebrow className="justify-center text-center">MEDIA & PODCAST APPEARANCES</Eyebrow>
          <h2 class="media-h2">
            Host Tiffany on your <span class="italic-accent">broadcast or podcast.</span>
          </h2>
          <p class="section-subtext">
            Tiffany is available for television, radio, print, and podcast interviews discussing problem gambling prevention, youth digital health, and community health strategy.
          </p>
        </div>
        <div style="display: flex; justify-content: center; align-items: center; width: 100%;">
          <Button href="/work-with-tiffany?inquiry=media" variant="primary" className="magnetic-btn">
            Request a Media Interview or Podcast Appearance &rarr;
          </Button>
        </div>
      </div>
    </section>

    <!-- Footer Navigation Loop -->
    <PageNavigation 
      prevLink="/about" 
      prevLabel="About Tiffany" 
      nextLink="/work-with-tiffany" 
      nextLabel="Book Tiffany for an Event" 
    />

  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabButtons = document.querySelectorAll('.bio-tab-pill');
    const panels = document.querySelectorAll('.bio-panel');

    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.getAttribute('data-bio-target');
        
        // 1. Update button styles
        tabButtons.forEach(b => {
          b.style.background = '#1A1713';
          b.style.color = '#FBF6EA';
          b.style.borderColor = 'rgba(255, 255, 255, 0.2)';
          b.style.boxShadow = 'none';
        });
        btn.style.background = '#D9A23A';
        btn.style.color = '#0D0C08';
        btn.style.borderColor = '#D9A23A';
        btn.style.boxShadow = '0 4px 20px rgba(217, 162, 58, 0.3)';

        // 2. Direct DOM show/hide
        panels.forEach(p => {
          p.style.display = 'none';
        });

        const activePanel = document.getElementById(`bio-panel-${target}`);
        if (activePanel) {
          activePanel.style.display = 'block';
        }
      });
    });

    // Copy button handler
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const targetId = btn.getAttribute('data-copy-target');
        const targetEl = document.getElementById(targetId);
        if (!targetEl) return;

        const textToCopy = targetEl.innerText.trim();
        try {
          await navigator.clipboard.writeText(textToCopy);
          const copyTextSpan = btn.querySelector('.copy-text');
          const originalText = copyTextSpan.innerText;
          copyTextSpan.innerText = 'Copied to Clipboard!';
          btn.classList.add('copied');
          
          setTimeout(() => {
            copyTextSpan.innerText = originalText;
            btn.classList.remove('copied');
          }, 2500);
        } catch (err) {
          console.error('Failed to copy text:', err);
        }
      });
    });
  });
</script>

<style>
  .media-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .media-hero-section {
    padding: 10rem 0 5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: radial-gradient(circle at 50% 0%, rgba(217, 162, 58, 0.12) 0%, rgba(13, 12, 8, 1) 75%);
  }

  .media-section {
    padding: 7rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
  }

  .media-inquiry-banner {
    padding: 3rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background: radial-gradient(circle at 50% 50%, rgba(217, 162, 58, 0.1) 0%, rgba(13, 12, 8, 1) 80%);
  }

  /* ---------------------------------------------------- */
  /* PROPERLY SPACED CENTERED SECTION HEADERS             */
  /* ---------------------------------------------------- */
  .section-header-block {
    max-width: 840px;
    margin: 0 auto 3.5rem auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
  }

  .media-h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 5.5vw, 4.8rem);
    color: var(--color-ivory, #FBF6EA);
    line-height: 1.15;
    margin: 0;
    text-align: center;
  }

  .media-h2 {
    font-family: var(--font-serif);
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    color: var(--color-ivory, #FBF6EA);
    line-height: 1.2;
    margin: 0.25rem 0 0.5rem 0;
    text-align: center;
  }

  .media-subtitle {
    font-size: 1.2rem;
    color: #FFFFFF;
    line-height: 1.65;
    max-width: 760px;
    text-align: center;
    margin: 0 auto;
  }

  .section-subtext {
    font-size: 1.15rem;
    color: rgba(251, 246, 234, 0.85);
    line-height: 1.65;
    text-align: center;
    max-width: 720px;
    margin: 0 auto 1.5rem auto;
  }

  /* ---------------------------------------------------- */
  /* COPY BUTTON HOVER & INTERACTION                      */
  /* ---------------------------------------------------- */
  .copy-bio-btn,
  .copy-btn-large {
    padding: 0.8rem 2rem !important;
    font-size: 0.85rem !important;
    border: 2px solid var(--color-gold, #D9A23A) !important;
    background: var(--color-gold, #D9A23A) !important;
    color: #0D0C08 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.6rem !important;
    font-family: var(--font-mono, monospace) !important;
    font-weight: 800 !important;
