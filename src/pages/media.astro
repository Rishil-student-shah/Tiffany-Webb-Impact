    line-height: 1;
    padding-top: 0.2rem;
  }

  .bio-meta-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .bio-pills-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .pill-badge-gold {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.12em;
