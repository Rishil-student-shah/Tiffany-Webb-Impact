---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
---

<Layout title="Media & Press | Tiffany Webb" theme="secondary">
  <main class="page-content">
    
    <!-- 7.0 Hero -->
    <section class="inner-hero theme-dark">
      <div class="container reveal-up">
        <Eyebrow>Media & Press</Eyebrow>
        <h1 class="inner-hero-title">Media &amp; Press Resources</h1>
        <p class="inner-hero-sub">Everything you need to feature, interview, or introduce Tiffany — without needing to email first.</p>
      </div>
    </section>

    <!-- 7.1 Bios -->
    <section class="bios section-pad">
      <div class="container stagger-group">
        <h2 class="stagger-item">Official Bios</h2>
        
        <div class="bio-grid mt-8">
          <div class="bio-card stagger-item">
            <h3>Short (≈40 words)</h3>
            <div class="bio-text">
              <p>Tiffany Webb is a public-health educator and Community Impact Strategist with 15+ years and 4,000+ hours preventing gambling harm. She helps conferences, schools, and health systems turn hard conversations into action — with the cultural fluency to reach the people other programs miss.</p>
            </div>
            <button class="btn btn-secondary btn-copy" onclick="navigator.clipboard.writeText(this.previousElementSibling.innerText); alert('Copied to clipboard');">Copy Bio</button>
          </div>
          
          <div class="bio-card stagger-item">
            <h3>Medium (≈90 words)</h3>
            <div class="bio-text">
              <p>Tiffany Webb, BBA, MHP, is a Chicago-born public-health educator, gambling-prevention leader, and Community Impact Strategist with deep Louisiana roots. Over 15+ years and 4,000+ hours of frontline outreach, she has built coalitions, trained professionals, and led community screenings across Illinois — partnering with health systems, schools, government, and recovery organizations. A dynamic keynote speaker, panelist, and workshop facilitator, she makes difficult topics approachable and leaves organizations with practical tools. She is also the founder of GambleFreeGear, an awareness apparel brand built to "Break the Silence" on gambling addiction.</p>
            </div>
            <button class="btn btn-secondary btn-copy" onclick="navigator.clipboard.writeText(this.previousElementSibling.innerText); alert('Copied to clipboard');">Copy Bio</button>
          </div>
          
          <div class="bio-card stagger-item">
            <h3>Long (≈150 words)</h3>
            <div class="bio-text">
              <p>Tiffany Webb, BBA, MHP, is a public-health educator, gambling-prevention leader, and Community Impact Strategist based in the Chicago area. Chicago-born and raised with deep Louisiana family roots, she blends behavioral-health expertise, bold community outreach, and entrepreneurial drive into a singular mission: no one should face gambling harm in silence. Across 15+ years and 4,000+ hours of prevention outreach, Tiffany has led community screenings, built coalitions, trained clinicians and frontline workers, and partnered with hospitals, schools, universities, government agencies, faith communities, and recovery organizations — including work connected to Healthcare Alternative Systems, the Illinois Council on Problem Gambling, and the statewide "Are You Really Winning?" awareness effort. As a keynote speaker, panelist, and workshop facilitator, she is known for making difficult topics approachable, leading with both heart and strategy, and equipping communities with practical tools. She is also the founder of GambleFreeGear, an awareness apparel brand on a mission to "Break the Silence."</p>
            </div>
            <button class="btn btn-secondary btn-copy" onclick="navigator.clipboard.writeText(this.previousElementSibling.innerText); alert('Copied to clipboard');">Copy Bio</button>
          </div>
        </div>
      </div>
    </section>

    <!-- 7.2 Introduction Script -->
    <section class="intro-script section-pad bg-cream">
      <div class="container stagger-group">
        <h2 class="stagger-item">Introduction Script</h2>
        <p class="subtitle stagger-item">For event hosts</p>
        
        <div class="script-box stagger-item mt-8">
          <p class="script-text">Our next speaker has spent more than fifteen years and four thousand hours doing prevention work in the places it's hardest to do — schools, clinics, and community rooms across Illinois. She's a public-health educator, a Community Impact Strategist, and the founder of GambleFreeGear. She believes prevention begins with a conversation, and she's here to start one with us. Please welcome Tiffany Webb.</p>
          <button class="btn btn-secondary mt-4" onclick="navigator.clipboard.writeText(this.previousElementSibling.innerText); alert('Copied to clipboard');">Copy Script</button>
        </div>
      </div>
    </section>

    <!-- 7.3 Headshots -->
    <section class="headshots section-pad">
      <div class="container stagger-group">
        <h2 class="stagger-item">Headshots &amp; Photography</h2>
        <p class="subtitle stagger-item">High-resolution and web-optimized versions available for download. Please credit where indicated.</p>
        
        <div class="grid-2 mt-8 stagger-item">
          <div class="media-image-container">
            <img src="/media_portrait.jpg" alt="Tiffany Webb Studio Portrait" class="media-image" />
            <a href="/media_portrait.jpg" download class="text-micro mt-4" style="text-decoration: underline; display: inline-block;">Download Portrait</a>
          </div>
          <div class="media-image-container">
            <img src="/media_action.jpg" alt="Tiffany Webb speaking on stage" class="media-image" />
            <a href="/media_action.jpg" download class="text-micro mt-4" style="text-decoration: underline; display: inline-block;">Download Action Shot</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 7.4 Speaker Info & 7.5 Press Resources -->
    <section class="info-resources section-pad bg-cream">
      <div class="container grid-2 stagger-group">
        <div class="stagger-item">
          <h2>Speaker Information</h2>
          <ul class="info-list mt-8">
            <li><strong>Positioning:</strong> Community Impact Strategist &middot; Public Health Educator &amp; Speaker</li>
            <li><strong>Topic areas:</strong> Prevention &amp; Awareness &middot; Treatment, Recovery &amp; Professional Training &middot; Family &amp; Community Impact &middot; Creative &amp; Promotional Engagement</li>
            <li><strong>Formats:</strong> Keynote &middot; Conference session &middot; Panel &middot; Workshop &middot; School program &middot; Custom</li>
            <li><strong>Experience:</strong> 15+ years &middot; 4,000+ hours of gambling-prevention outreach</li>
          </ul>
        </div>
        <div class="stagger-item">
          <h2>Press Resources</h2>
          <ul class="resource-links mt-8">
            <li><a href="#" class="resource-link">Media Kit (PDF) &darr;</a></li>
            <li><a href="#" class="resource-link">Capability Kit (PDF) &darr;</a></li>
            <li><a href="#" class="resource-link">Speaker One-Sheet (PDF) &darr;</a></li>
            <li><a href="#" class="resource-link">Logo &amp; brand assets (ZIP) &darr;</a></li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 7.6 Media Appearances -->
    <section class="appearances section-pad">
      <div class="container stagger-group">
        <h2 class="stagger-item">Media Appearances</h2>
        
        <div class="appearance-card mt-8 stagger-item">
          <h3>Gateway Foundation &mdash; <em>Wager Danger</em> podcast</h3>
          <p>A conversation on community-based gambling prevention and harm reduction.</p>
        </div>
      </div>
    </section>

    <!-- 7.7 Media Contact -->
    <section class="contact section-pad bg-ink text-center theme-dark">
      <div class="container stagger-group">
        <h2 class="stagger-item color-ivory">Media Contact</h2>
        <p class="subtitle stagger-item mx-auto color-ivory" style="opacity: 0.8;">For interviews, quotes, or speaking enquiries:</p>
        <div class="mt-8 stagger-item">
          <a href="mailto:booking@tiffanywebb.com" class="contact-email">booking@tiffanywebb.com</a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .page-content {
    padding-top: 0;
  }

  .inner-hero {
    background-color: var(--color-ink);
    color: var(--color-ivory);
    padding: calc(var(--sp-24) + 80px) 0 var(--sp-12);
  }

  .container {
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  .inner-hero-title {
    margin-bottom: var(--sp-4);
  }

  .inner-hero-sub {
    font-size: 1.25rem;
    color: rgba(253, 252, 248, 0.8);
    max-width: 700px;
  }

  .section-pad { padding: var(--sp-24) 0; }
  .bg-cream { background-color: var(--color-cream); }
  .bg-ink { background-color: var(--color-ink); }
  .color-ivory { color: var(--color-ivory); }
  .text-center { text-align: center; }
  .mt-12 { margin-top: var(--sp-12); }
  .mt-8 { margin-top: var(--sp-8); }
  .mt-4 { margin-top: var(--sp-4); }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .subtitle {
    font-size: 1.25rem;
    color: var(--color-charcoal);
  }

  .bio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }

  .bio-card {
    background-color: var(--color-cream);
    padding: var(--sp-8);
    border: 1px solid var(--border-light);
  }

  .bio-card h3 {
    margin-bottom: var(--sp-4);
    font-size: 1.25rem;
  }

  .bio-text {
    margin-bottom: var(--sp-6);
    color: var(--color-charcoal);
  }

  .script-box {
    background-color: var(--color-ivory);
    padding: var(--sp-8);
    border: 1px solid var(--border-light);
    border-left: 4px solid var(--color-emerald);
  }

  .script-text {
    font-size: 1.125rem;
    color: var(--color-charcoal);
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-8);
  }
  @media (min-width: 768px) {
    .grid-2 {
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-12);
    }
  }

  .media-image-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .media-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
  }

  .info-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .info-list li {
    color: var(--color-charcoal);
    line-height: 1.5;
  }
  .info-list strong {
    color: var(--color-ink);
  }

  .resource-links {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }
  .resource-link {
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-size: 0.875rem;
    color: var(--color-emerald);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }
  .resource-link:hover {
    border-color: var(--color-emerald);
  }

  .appearance-card {
    padding: var(--sp-6);
    background-color: var(--color-cream);
    border-left: 4px solid var(--color-gold);
  }
  .appearance-card h3 {
    margin-bottom: var(--sp-2);
  }
  .appearance-card p {
    color: var(--color-charcoal);
  }

  .contact-email {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    color: var(--color-gold);
    text-decoration: none;
    transition: color 0.3s ease;
  }
  .contact-email:hover {
    color: var(--color-ivory);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-4) var(--sp-8);
    font-family: var(--font-mono);
    font-size: var(--text-button);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.3s ease;
    border-radius: 2px;
    cursor: pointer;
  }
  .btn-secondary {
    background-color: transparent;
    color: var(--color-gold);
    border: 1px solid var(--color-gold);
  }
  .btn-secondary:hover {
    background-color: rgba(212, 175, 55, 0.1);
  }
</style>
