    color: #0D0C08 !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(217, 162, 58, 0.4);
  }

  .dribbble-copy-btn:hover svg {
    color: #0D0C08;
  }

  .dribbble-copy-btn.copied-state {
    background: #0E6B54 !important;
    border-color: #0E6B54 !important;
    color: #FFFFFF !important;
  }

  .dribbble-copy-btn.copied-state svg {
    color: #FFFFFF !important;
  }

  /* Body Prose Typography */
  .dribbble-bio-body {
    margin-bottom: 2rem;
  }

  .bio-text-content p {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    line-height: 1.85;
