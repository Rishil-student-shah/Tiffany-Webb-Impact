---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Waveform from '../components/Waveform.astro';
---

<Layout title="Press Kits | Tiffany Webb" theme="dark">
  <main class="page-content bg-ink">
    
    <!-- Hero -->
    <section class="spk-hero-v2 relative overflow-hidden" style="position: relative;">
      <Waveform opacity={0.05} variant="A" flipX={true} />
      
      <div class="spk-container" style="position: relative; z-index: 10;">
        <div class="spk-hero-content text-center">
          <Eyebrow className="justify-center">Media & Press</Eyebrow>
          <h1 class="spk-h1">Official <span class="italic-accent">Press Kits.</span></h1>
          <p class="spk-subtitle">
            Downloadable assets, one-sheets, and capability decks for event organizers, journalists, and partners.
          </p>
        </div>
      </div>
    </section>

    <!-- Downloads Grid -->
    <section class="spk-section relative overflow-hidden" style="padding-top: 2rem; position: relative;">
      <Waveform opacity={0.04} variant="B" flipY={true} />
      <div class="spk-container" style="position: relative; z-index: 10;">
        
        <div class="spk-tracks-grid" style="grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));">
          
          <!-- Kit 1: One Sheet -->
          <div class="spk-track-card flex-col">
            <div class="track-header">
              <h3 class="track-title">Speaker One-Sheet</h3>
              <p class="track-subtitle">For Event Organizers</p>
            </div>
            <p class="text-gray mb-8" style="color: rgba(251, 246, 234, 0.7); line-height: 1.6; margin-bottom: 2rem;">
              A single-page overview of Tiffany's signature keynotes, core topics, and professional background. Perfect for sharing with your committee or board.
            </p>
            <div class="mt-auto">
              <a href="#" class="download-btn">Download PDF &darr;</a>
            </div>
          </div>

          <!-- Kit 2: Media Kit -->
          <div class="spk-track-card flex-col">
            <div class="track-header">
              <h3 class="track-title">Media Kit</h3>
              <p class="track-subtitle">For Journalists & Press</p>
            </div>
            <p class="text-gray mb-8" style="color: rgba(251, 246, 234, 0.7); line-height: 1.6; margin-bottom: 2rem;">
              Includes official high-resolution headshots, approved short and long bios, and brand assets for features and interviews.
            </p>
            <div class="mt-auto">
              <a href="#" class="download-btn">Download ZIP &darr;</a>
            </div>
          </div>

          <!-- Kit 3: Capability Kit -->
          <div class="spk-track-card flex-col">
            <div class="track-header">
              <h3 class="track-title">Capability Kit</h3>
              <p class="track-subtitle">For Corporate & Healthcare</p>
            </div>
            <p class="text-gray mb-8" style="color: rgba(251, 246, 234, 0.7); line-height: 1.6; margin-bottom: 2rem;">
              A detailed prospectus of consulting services, clinical training capabilities, and specialized organizational workshops.
            </p>
            <div class="mt-auto">
              <a href="#" class="download-btn">Download PDF &darr;</a>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>
</Layout>

<style is:global>
  .bg-ink { background: var(--ink); }
  .spk-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }
  .spk-section {
    padding: 8rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }
  .text-center { text-align: center; }
  .flex-col {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .mt-auto { margin-top: auto; }

  .spk-h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 5rem);
    color: var(--color-ivory);
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }
  .spk-subtitle {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    color: rgba(251, 246, 234, 0.75);
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto 3rem auto;
  }

  .spk-hero-v2 {
    padding: 12rem 0 4rem 0;
  }
  .spk-hero-content {
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Grid & Cards */
  .spk-tracks-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .spk-track-card {
    background: rgba(15, 15, 15, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 24px;
    padding: 3rem;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.4s ease, box-shadow 0.4s ease;
  }
  .spk-track-card:hover {
    transform: translateY(-8px);
    border-color: rgba(217, 162, 58, 0.4);
    box-shadow: 0 20px 50px rgba(0,0,0,0.6), 0 0 40px rgba(217, 162, 58, 0.05);
  }
  .track-header {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(217, 162, 58, 0.2);
    transition: border-color 0.4s ease;
  }
  .spk-track-card:hover .track-header {
    border-color: rgba(217, 162, 58, 0.5);
  }
  .track-title {
    font-family: var(--font-serif);
    font-size: 2rem;
    color: var(--color-ivory);
    margin-bottom: 0.5rem;
  }
  .track-subtitle {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-gold);
    opacity: 0.8;
  }

  /* Buttons */
  .download-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: transparent;
    border: 1px solid rgba(217, 162, 58, 0.5);
    color: var(--color-gold);
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.85rem;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .download-btn:hover {
    background: rgba(217, 162, 58, 0.1);
    border-color: var(--color-gold);
    color: #fff;
  }
</style>
