try {
  const pool = mysql.createPool({
    host: 'localhost',
    user: 'root',
    password: '@rishil8124shah',
    database: 'tiffany_crm',
    waitForConnections: true,
    connectionLimit: 10,
    queueLimit: 0
  });

  const [rows] = await pool.query(`
    SELECT * FROM speaking_topics 
    WHERE is_active = 1 
    ORDER BY track_id ASC, topic_number ASC
  `);

  if (rows && rows.length > 0) {
    topics = rows;
  } else {
    topics = fallbackTopics;
  }
  await pool.end();
} catch (e) {
  console.error("Database connection failed for speaking-topics, using verified fallback list:", e);
  topics = fallbackTopics;
}

// Track configuration definitions
const trackConfig = [
  { id: 1, filterKey: "prevention", label: "Prevention", name: "Prevention, Gambling & Emerging Risk", color: "#0E6B54" },
  { id: 2, filterKey: "outreach", label: "Outreach", name: "Community Engagement & Outreach", color: "#D9A23A" },
  { id: 3, filterKey: "systems", label: "Systems", name: "Human-Centered Systems & Services", color: "#C15427" },
  { id: 4, filterKey: "youth", label: "Youth & Leadership", name: "Purpose, Leadership & Youth Impact", color: "#6C2D5A" }
];

const getTrackColor = (trackId) => {
  switch (trackId) {
    case 1: return "#0E6B54";
    case 2: return "#D9A23A";
    case 3: return "#C15427";
    case 4: return "#6C2D5A";
    default: return "#D9A23A";
  }
};

const getTrackKey = (trackId) => {
  switch (trackId) {
    case 1: return "prevention";
    case 2: return "outreach";
    case 3: return "systems";
    case 4: return "youth";
    default: return "all";
  }
};
---

<Layout title="Speaking Topics Catalog | Tiffany Webb" theme="dark">
  <main class="page-content bg-ink" style="padding-top: 6rem; padding-bottom: 8rem;">
    
    <!-- Hero Header -->
    <section class="spk-hero relative overflow-hidden" style="padding: 5rem 0 3rem 0;">
      <Waveform opacity={0.05} variant="B" flipY={true} />
      <div class="spk-container relative z-10 text-center">
        <div class="reveal-up">
          <Eyebrow className="justify-center">SPEAKING & FACILITATION CATALOG</Eyebrow>
          <h1 class="spk-title mt-4">
            Twenty-one topics. <br/><span class="italic-accent">Four signature tracks.</span>
          </h1>
          <p class="spk-subtitle mx-auto mt-4">
            Every session below is actively delivered by Tiffany Webb — built for specific audiences, evidence-grounded, and designed for immediate Monday-morning application.
          </p>
        </div>

        <!-- Interactive Track Filter Navigation -->
        <div class="filter-bar reveal-up mt-10">
          <button class="filter-btn active" data-filter="all">All Topics (21)</button>
          <button class="filter-btn" data-filter="prevention">Prevention (5)</button>
          <button class="filter-btn" data-filter="outreach">Outreach (5)</button>
          <button class="filter-btn" data-filter="systems">Systems (6)</button>
          <button class="filter-btn" data-filter="youth">Youth & Leadership (5)</button>
        </div>
      </div>
    </section>

    <!-- Topics Grid by Track -->
    <section class="spk-catalog-section relative">
      <div class="spk-container relative z-10">
        
        {trackConfig.map(track => {
          const trackTopics = topics.filter(t => t.track_id === track.id);
          return (
            <div class="track-group-section mt-16" data-track-section={track.filterKey}>
              
              <!-- Track Header Banner -->
              <div class="track-section-header mb-8">
                <div class="track-header-left">
                  <span class="track-pill" style={`background: ${track.color}22; color: ${track.color}; border: 1px solid ${track.color}55;`}>
                    TRACK 0{track.id}
                  </span>
                  <h2 class="track-section-title">{track.name}</h2>
                </div>
                <span class="track-count">{trackTopics.length} Topics</span>
              </div>

              <!-- Cards Grid -->
              <div class="topics-grid">
                {trackTopics.map(topic => {
                  const numStr = (topic.topic_number || "").toString().padStart(2, '0');
                  const topicSlug = encodeURIComponent(topic.title);
                  const trackKey = getTrackKey(topic.track_id);
                  const trackColor = getTrackColor(topic.track_id);

                  return (
                    <div class="topic-card ultra-glass-card stagger-item" data-track={trackKey} data-topic-num={topic.topic_number}>
                      <div class="topic-card-inner">
                        
                        <!-- Top Meta Header -->
                        <div class="topic-top-meta">
                          <div class="topic-num-wrap">
                            <span class="topic-num" style={`color: ${trackColor};`}>#{numStr}</span>
                            {topic.is_flagship ? (
                              <span class="flagship-badge">★ FLAGSHIP KEYNOTE</span>
                            ) : null}
                          </div>
                          {topic.format_badge && (
                            <span class="badge-format">{topic.format_badge}</span>
                          )}
                        </div>

                        <!-- Card Body -->
                        <div class="topic-body">
                          <h3 class="topic-title">{topic.title}</h3>
                          
                          {topic.target_audience && (
                            <div class="topic-audience-wrap">
                              <span class="audience-label">Audience:</span>
                              <span class="audience-text">{topic.target_audience}</span>
                            </div>
                          )}

                          <p class="topic-desc">{topic.description}</p>
                        </div>

                        <!-- Card Footer Action -->
                        <div class="topic-footer">
                          <a href={`/work-with-tiffany?topic=${encodeURIComponent(topic.title)}&track=${encodeURIComponent(topic.track_name)}&audience=${encodeURIComponent(topic.target_audience || '')}`} class="book-topic-btn">
                            Book This Topic &rarr;
                          </a>
                        </div>

                      </div>
                    </div>
                  );
                })}
              </div>

            </div>
          );
        })}

        <!-- Bottom CTA Box -->
        <div class="catalog-bottom-cta ultra-glass-card mt-20 text-center reveal-up">
          <h3 class="cta-title">Need a customized keynote or specific training format?</h3>
          <p class="cta-subtitle">Tiffany works directly with executive committees and conference chairs to tailor sessions to your specific objectives.</p>
          <div class="mt-6">
            <Button href="/work-with-tiffany" variant="primary" className="magnetic-btn">START A CONVERSATION &rarr;</Button>
          </div>
        </div>

      </div>
    </section>

    <!-- Footer Navigation Loop -->
    <PageNavigation 
      prevLink="/services" 
      prevLabel="Explore Services & GEAR Method™" 
      nextLink="/impact" 
      nextLabel="See Real-World Engagements & Impact" 
    />

  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.topic-card');
    const trackSections = document.querySelectorAll('.track-group-section');

    function applyFilter(filter) {
      filterBtns.forEach(b => {
        if (b.getAttribute('data-filter') === filter) {
          b.classList.add('active');
        } else {
          b.classList.remove('active');
        }
      });

      if (filter === 'all') {
        cards.forEach(card => card.style.display = 'flex');
        trackSections.forEach(section => section.style.display = 'block');
      } else {
        trackSections.forEach(section => {
          const sectionTrack = section.getAttribute('data-track-section');
          if (sectionTrack === filter) {
            section.style.display = 'block';
          } else {
            section.style.display = 'none';
          }
        });

        cards.forEach(card => {
          const cardTrack = card.getAttribute('data-track');
          if (cardTrack === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        applyFilter(filter);
        
        // Update URL query parameter cleanly without reload
        const url = new URL(window.location);
        if (filter === 'all') {
          url.searchParams.delete('track');
        } else {
          url.searchParams.set('track', filter);
        }
        window.history.replaceState({}, '', url);
      });
    });

    // Check URL search parameters on page load
    const urlParams = new URLSearchParams(window.location.search);
    const initialTrack = urlParams.get('track');
    if (initialTrack) {
      applyFilter(initialTrack.toLowerCase());
    }
  });
</script>

