    function initCCPicker(btnId, dropdownId, searchId, listId, hiddenId, phoneId) {
      const btn = document.getElementById(btnId);
      const dropdown = document.getElementById(dropdownId);
      const search = document.getElementById(searchId);
      const list = document.getElementById(listId);
      const hidden = document.getElementById(hiddenId);
      const phoneInput = document.getElementById(phoneId);
      if (!btn || !dropdown) return;
      function updatePhoneValidation(country) {
        if (phoneInput && country.d) {
          const [min, max] = country.d;
          if (min === max) {
            phoneInput.pattern = `[0-9]{${min}}`;
            phoneInput.title = `Enter exactly ${min} digits for ${country.n}`;
            phoneInput.placeholder = '0'.repeat(min);
          } else {
            phoneInput.pattern = `[0-9]{${min},${max}}`;
            phoneInput.title = `Enter ${min}-${max} digits for ${country.n}`;
            phoneInput.placeholder = '0'.repeat(min);
          }
        }
      }
      const usEntry = CC.find(x => x.f === 'US');
      if (usEntry) updatePhoneValidation(usEntry);
      function render(filter = '') {
        const q = filter.toLowerCase();
        list.innerHTML = '';
        CC.filter(x => x.n.toLowerCase().includes(q) || x.c.includes(q) || x.f.toLowerCase().includes(q))
          .forEach(x => {
            const li = document.createElement('li');
            const digitInfo = x.d[0] === x.d[1] ? `${x.d[0]} digits` : `${x.d[0]}-${x.d[1]} digits`;
            li.textContent = `${x.c} — ${x.n} (${digitInfo})`;
            li.style.cssText = 'padding:0.6rem 1rem;color:rgba(255,255,255,0.9);font-size:0.85rem;cursor:pointer;transition:background 0.15s;';
            li.addEventListener('mouseenter', () => { li.style.background = 'rgba(194,149,69,0.25)'; li.style.color = '#fff'; });
            li.addEventListener('mouseleave', () => { li.style.background = 'transparent'; li.style.color = 'rgba(255,255,255,0.9)'; });
            li.addEventListener('click', () => {
              hidden.value = x.c;
              btn.textContent = `${x.c} (${x.f})`;
              dropdown.classList.remove('open');
              search.value = '';
              updatePhoneValidation(x);
            });
            list.appendChild(li);
          });
      }
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        dropdown.classList.toggle('open');
        if (dropdown.classList.contains('open')) { render(); setTimeout(() => search.focus(), 50); }
      });
      search.addEventListener('input', () => render(search.value));
      search.addEventListener('click', (e) => e.stopPropagation());
      document.addEventListener('click', () => { dropdown.classList.remove('open'); search.value = ''; });
    }

    initCCPicker('book-cc-btn', 'book-cc-dropdown', 'book-cc-search', 'book-cc-list', 'country_code', 'phone');

    // Auto-populate from URL query params (topic, track, audience, format, type)
    const urlParams = new URLSearchParams(window.location.search);
    const topicParam = urlParams.get('topic');
    const trackParam = urlParams.get('track');
    const audienceParam = urlParams.get('audience');
    const formatParam = urlParams.get('format');
    const typeParam = urlParams.get('type');

    const topicSelect = document.getElementById('topic');
    const messageInput = document.getElementById('message');
    const eventTypeSelect = document.getElementById('event_type_select');
    const customEventWrapper = document.getElementById('custom_event_wrapper');
    const eventTypeInput = document.getElementById('event_type');

    if (topicParam) {
      if (topicSelect) {
        let found = false;
        Array.from(topicSelect.options).forEach(opt => {
          if (opt.value.toLowerCase() === topicParam.toLowerCase() || opt.text.toLowerCase().includes(topicParam.toLowerCase())) {
            opt.selected = true;
            found = true;
          }
        });
        if (!found) {
          const newOpt = new Option(topicParam, topicParam, true, true);
          topicSelect.add(newOpt, 1);
        }
      }
      if (messageInput && !messageInput.value) {
        let note = `Interested in topic: "${topicParam}"`;
        if (trackParam) note += `\nTrack: ${trackParam}`;
        if (audienceParam) note += `\nTarget Audience: ${audienceParam}`;
        messageInput.value = note;
      }
    }

    if (formatParam || typeParam) {
      const targetType = formatParam || typeParam;
      if (eventTypeSelect) {
        let found = false;
        Array.from(eventTypeSelect.options).forEach(opt => {
          if (opt.value.toLowerCase().includes(targetType.toLowerCase())) {
            opt.selected = true;
            found = true;
          }
        });
        if (!found && customEventWrapper && eventTypeInput) {
          eventTypeSelect.value = 'Other';
          customEventWrapper.style.display = 'block';
          eventTypeInput.value = targetType;
        }
      }
    }

    // Form Submission to CRM
    const form = document.getElementById('booking-form');
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Disable button to prevent double-submit
        const submitBtn = form.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        submitBtn.innerHTML = 'Submitting...';

        try {
          const formData = new FormData(form);
          const payload = {
            contact_name: formData.get('name'),
            organization_name: formData.get('org'),
            email: formData.get('email'),
            country_code: formData.get('country_code'),
            phone: formData.get('phone'),
            event_type: formData.get('event_type'),
            event_date: formData.get('date'),
            event_location: formData.get('location'),
            estimated_audience_size: formData.get('size'),
            message: formData.get('message')
          };

          const response = await fetch('http://localhost:3000/api/leads', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });

          if (response.ok) {
            document.getElementById('success-msg').style.display = 'block';
            form.style.display = 'none';
          } else {
            alert('There was a problem submitting your request. Please try again later.');
            submitBtn.disabled = false;
            submitBtn.innerHTML = 'Submit Speaking Request &rarr;';
          }
        } catch (error) {
          console.error('Error submitting form:', error);
          alert('Could not connect to the server. Please try again later.');
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'Submit Speaking Request &rarr;';
        }
      });
    }
  });
</script>

