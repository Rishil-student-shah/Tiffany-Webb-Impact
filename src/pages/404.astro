---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | Tiffany Webb" theme="secondary">
  <main class="page-content not-found">
    
    <div class="container reveal-up">
      <h1 class="not-found-title">This page has gone quiet.</h1>
      <p class="not-found-prose">The page you're looking for doesn't exist — but the conversation doesn't have to end here.</p>
      
      <div class="not-found-ctas mt-8">
        <a href="/" class="btn btn-secondary">Back to home</a>
        <a href="/speaking" class="text-link">Explore her speaking &rarr;</a>
      </div>
    </div>

  </main>
</Layout>

<style>
  .not-found {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-ink);
    color: var(--color-ivory);
    text-align: center;
    padding: var(--sp-12) var(--sp-6);
  }

  .container {
    width: 100%;
    max-width: 600px;
  }

  .not-found-title {
    margin-bottom: var(--sp-4);
    font-size: var(--text-h2);
    color: var(--color-gold);
  }

  .not-found-prose {
    font-size: 1.25rem;
    color: rgba(253, 252, 248, 0.8);
  }

  .mt-8 { margin-top: var(--sp-8); }

  .not-found-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sp-6);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-4) var(--sp-8);
    font-family: var(--font-mono);
    font-size: var(--text-button);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
    transition: all 0.3s ease;
    border-radius: 2px;
  }
  .btn-secondary {
    background-color: transparent;
    color: var(--color-gold);
    border: 1px solid var(--color-gold);
  }
  .btn-secondary:hover {
    background-color: rgba(212, 175, 55, 0.1);
  }

  .text-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-button);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ivory);
    position: relative;
    text-decoration: none;
  }

  .text-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .text-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }
</style>
