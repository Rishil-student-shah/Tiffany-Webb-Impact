---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ImpactBand from '../components/ImpactBand.astro';
import CredibilityBar from '../components/CredibilityBar.astro';
import MeetTiffany from '../components/MeetTiffany.astro';
import WhereSheWorks from '../components/WhereSheWorks.astro';
import Expertise from '../components/Expertise.astro';
import SpeakingSection from '../components/SpeakingSection.astro';
import EventsImpact from '../components/EventsImpact.astro';
import ProofTestimonials from '../components/ProofTestimonials.astro';
import VideoReels from '../components/VideoReels.astro';
import MediaBand from '../components/MediaBand.astro';
import BookingSection from '../components/BookingSection.astro';
import mysql from 'mysql2/promise';

// Fetch content from the CRM Database
let dbContent = {};
let dbCollections = {};
try {
  const pool = mysql.createPool({
    host: 'localhost',
    user: 'root',
    password: '@rishil8124shah',
    database: 'tiffany_crm',
    waitForConnections: true,
    connectionLimit: 10,
    queueLimit: 0
  });
  
  // Fetch KV content
  const [rows] = await pool.query(`
    SELECT section, key_name, content_value 
    FROM website_content 
    JOIN website_pages ON website_content.page_id = website_pages.id 
    WHERE website_pages.slug = 'home'
  `);
  
  rows.forEach(row => {
    if (!dbContent[row.section]) dbContent[row.section] = {};
    dbContent[row.section][row.key_name] = row.content_value;
  });

  // Fetch Collections
  const [colRows] = await pool.query(`
    SELECT section_name, title, sort_order, subtitle, content_html, image_url, icon_svg 
    FROM website_collections 
    JOIN website_pages ON website_collections.page_id = website_pages.id 
    WHERE website_pages.slug = 'home'
    ORDER BY section_name, sort_order ASC
  `);
  
  colRows.forEach(row => {
    if (!dbCollections[row.section_name]) dbCollections[row.section_name] = [];
    dbCollections[row.section_name].push(row);
  });
  await pool.end();
} catch (e) {
  console.error("Database connection failed for SSG, using fallbacks:", e);
}
---

<Layout title="Tiffany Webb | Strategist & Speaker">
	<main>
		<!-- 01. Hero -->
		{(!dbContent.hero || dbContent.hero.section_is_active !== "0") && <Hero content={dbContent.hero || {}} />}
		
		<!-- 02. Value Impact Bar -->
		{(!dbContent.impact_band || dbContent.impact_band.section_is_active !== "0") && <ImpactBand collections={dbCollections} />}
		
		<!-- 03. Credibility Numbers Bar (15+ | 50+ | 100+) -->
		{(!dbContent.credibility_bar || dbContent.credibility_bar.section_is_active !== "0") && <CredibilityBar collections={dbCollections} />}
		
		<!-- 04. Meet Tiffany (Story & Lived Wisdom) -->
		{(!dbContent.meet_tiffany || dbContent.meet_tiffany.section_is_active !== "0") && <MeetTiffany content={dbContent.meet_tiffany || {}} collections={dbCollections} />}
		
		<!-- 05. Who Can Benefit (8 Audiences) -->
		{(!dbContent.who_can_benefit || dbContent.who_can_benefit.section_is_active !== "0") && <WhereSheWorks content={dbContent.who_can_benefit || {}} collections={dbCollections} />}
		
		<!-- 06. Ways to Work (6 Engagement Formats) -->
		{(!dbContent.expertise || dbContent.expertise.section_is_active !== "0") && <Expertise content={dbContent.expertise || {}} collections={dbCollections} />}
		
		<!-- 07. Speaking Tracks (4 Flip Cards) -->
		{(!dbContent.speaking || dbContent.speaking.section_is_active !== "0") && <SpeakingSection content={dbContent.speaking || {}} collections={dbCollections} />}
		
		<!-- 08. Events & Impact Carousel -->
		{(!dbContent.events || dbContent.events.section_is_active !== "0") && <EventsImpact content={dbContent.events || {}} collections={dbCollections} />}
		
		<!-- 09. Proof & Testimonials (CRM Toggleable) -->
		{dbContent.proof_testimonials?.section_is_active === "1" && <ProofTestimonials content={dbContent.proof_testimonials || {}} collections={dbCollections} />}
		
		<!-- 10. Watch The Reel (CRM Toggleable) -->
		{(!dbContent.video_reels || dbContent.video_reels.section_is_active !== "0") && <VideoReels content={dbContent.video_reels || {}} collections={dbCollections} />}
		
		<!-- 11. Media Band -->
		{(!dbContent.media || dbContent.media.section_is_active !== "0") && <MediaBand content={dbContent.media || {}} />}
		
		<!-- 12. Booking Inquiry -->
		{(!dbContent.booking || dbContent.booking.section_is_active !== "0") && <BookingSection content={dbContent.booking || {}} />}
	</main>
</Layout>
