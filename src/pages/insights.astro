---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Waveform from '../components/Waveform.astro';
import mysql from 'mysql2/promise';

let dbContent = {};
let articles = [];
try {
  const pool = mysql.createPool({ host: 'localhost', user: 'root', password: '@rishil8124shah', database: 'tiffany_crm' });
  
  const [rows] = await pool.query("SELECT section, key_name, content_value FROM website_content JOIN website_pages ON website_content.page_id = website_pages.id WHERE website_pages.slug = 'insights'");
  rows.forEach(row => {
    if (!dbContent[row.section]) dbContent[row.section] = {};
    dbContent[row.section][row.key_name] = row.content_value;
  });

  const [colRows] = await pool.query("SELECT title, subtitle, image_url, sort_order FROM website_collections JOIN website_pages ON website_collections.page_id = website_pages.id WHERE website_pages.slug = 'insights' AND section_name = 'articles' ORDER BY sort_order ASC");
  articles = colRows;

  await pool.end();
} catch (e) {
  console.error("DB Error in insights:", e);
}

const hero = dbContent.hero || {};
let headline = hero.headline || 'Latest <span class="italic-accent">Insights.</span>';
if (headline && !headline.includes('<span')) {
  const words = headline.split(' ');
  if (words.length > 1) {
    const mid = Math.ceil(words.length / 2);
    headline = words.slice(0, mid).join(' ') + ' <span class="italic-accent">' + words.slice(mid).join(' ') + '</span>';
  }
}
---

<Layout title="Insights & Articles | Tiffany Webb" theme="dark">
  <main class="page-content bg-ink">
    
    <!-- Hero -->
    <section class="spk-hero-v2 relative overflow-hidden" style="position: relative;">
      <Waveform opacity={0.06} variant="B" flipX={true} />
      
      <div class="spk-container" style="position: relative; z-index: 10;">
        <div class="spk-hero-content text-center">
          {hero.eyebrow && <Eyebrow className="justify-center">{hero.eyebrow}</Eyebrow>}
          <h1 class="spk-h1" set:html={headline}></h1>
          {hero.subtitle && <p class="spk-subtitle">{hero.subtitle}</p>}
        </div>
      </div>
    </section>

    <!-- Articles Grid -->
    <section class="spk-section relative overflow-hidden" style="padding-top: 2rem; position: relative;">
      <Waveform opacity={0.03} variant="A" />
      <div class="spk-container" style="position: relative; z-index: 10;">
        
        <div class="insights-grid">
          {articles.map(article => (
            <a href="#" class="insight-card">
              <div class="insight-image">
                <img src={article.image_url} alt={article.title} style="width: 100%; height: 100%; object-fit: cover;" />
              </div>
              <div class="insight-content">
                <div class="insight-meta">
                  <span class="insight-tag">{article.subtitle.split('|')[0].trim()}</span>
                  <span class="insight-date">{article.subtitle.split('|')[1]?.trim() || ''}</span>
                </div>
                <h3 class="insight-title">{article.title}</h3>
                <span class="read-more">Read Article &rarr;</span>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

  </main>
</Layout>

<style>
  .bg-ink {
    background-color: var(--color-ink);
    color: var(--color-ivory);
    min-height: 100vh;
  }
  
  .spk-container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
  }
  
  .text-center {
    text-align: center;
  }
  
  .justify-center {
    justify-content: center;
  }
  
  /* Hero */
  .spk-hero-v2 {
    padding: 8rem 0 4rem;
  }
  
  .spk-h1 {
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 1.1;
    margin: 1rem 0 1.5rem;
    letter-spacing: -0.02em;
    font-family: var(--font-serif);
  }
  
  .spk-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.6;
    color: rgba(251, 246, 234, 0.7);
    max-width: 600px;
    margin: 0 auto;
    font-weight: 400;
  }
  
  /* Grid */
  .spk-section {
    padding-bottom: 8rem;
  }
  
  .insights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 3rem;
  }
  
  .insight-card {
    display: flex;
    flex-direction: column;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
  }
  
  .insight-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    border-color: rgba(217, 162, 58, 0.3);
  }
  
  .insight-image {
    width: 100%;
    aspect-ratio: 16/10;
    overflow: hidden;
  }
  
  .insight-card:hover .insight-image img {
    transform: scale(1.05);
  }
  
  .insight-image img {
    transition: transform 0.6s ease;
  }
  
  .insight-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  
  .insight-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    font-size: 0.8rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .insight-tag {
    color: var(--color-gold);
    font-weight: 600;
  }
  
  .insight-date {
    color: rgba(251, 246, 234, 0.5);
  }
  
  .insight-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    color: var(--color-ivory);
    line-height: 1.3;
    margin: 0 0 1rem 0;
  }
  
  .insight-excerpt {
    font-size: 0.95rem;
    line-height: 1.6;
    color: rgba(251, 246, 234, 0.7);
    margin: 0 0 2rem 0;
    flex-grow: 1;
  }
  
  .read-more {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-ivory);
    font-weight: 600;
    margin-top: auto;
    transition: color 0.2s ease;
  }
  
  .insight-card:hover .read-more {
    color: var(--color-gold);
  }
  
  @media (max-width: 768px) {
    .insights-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
