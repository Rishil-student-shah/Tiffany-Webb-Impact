---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Waveform from '../components/Waveform.astro';
import mysql from 'mysql2/promise';

let dbContent = {};
try {
  const pool = mysql.createPool({ host: 'localhost', user: 'root', password: '@rishil8124shah', database: 'tiffany_crm' });
  const [rows] = await pool.query("SELECT section, key_name, content_value FROM website_content JOIN website_pages ON website_content.page_id = website_pages.id WHERE website_pages.slug = 'terms'");
  rows.forEach(row => {
    if (!dbContent[row.section]) dbContent[row.section] = {};
    dbContent[row.section][row.key_name] = row.content_value;
  });
  await pool.end();
} catch (e) {
  console.error("DB Error in terms:", e);
}

const hero = dbContent.hero || {};
const legal = dbContent.legal || {};
---

<Layout title="Terms of Service | Tiffany Webb" theme="dark">
  <main class="page-content bg-ink">
    
    <section class="spk-hero-v2 relative overflow-hidden" style="padding: 10rem 0 4rem 0; position: relative;">
      <Waveform opacity={0.04} variant="B" flipY={true} />
      <div class="spk-container" style="position: relative; z-index: 10;">
        <div class="text-center">
          {hero.eyebrow && <Eyebrow className="justify-center">{hero.eyebrow}</Eyebrow>}
          <h1 class="spk-h1" set:html={hero.headline || 'Terms of <span class="italic-accent">Service.</span>'}></h1>
          {hero.subtitle && <p class="spk-subtitle">{hero.subtitle}</p>}
        </div>
      </div>
    </section>

    <section class="spk-section relative overflow-hidden" style="padding-top: 4rem; padding-bottom: 8rem; position: relative; background: radial-gradient(circle at right center, rgba(217,162,58,0.03) 0%, transparent 60%);">
      <Waveform opacity={0.03} variant="D" />
      <div class="spk-container" style="max-width: 900px; position: relative; z-index: 10;">
        <div class="legal-card prose-column" set:html={legal.body_text || ''}></div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .bg-ink { background: var(--color-ink); color: var(--color-ivory); min-height: 100vh; }
  .spk-container { width: 90%; max-width: 1200px; margin: 0 auto; }
  .text-center { text-align: center; }
  .justify-center { justify-content: center; }
  
  .spk-h1 {
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 1.1;
    margin: 1rem 0 1.5rem;
    letter-spacing: -0.02em;
    font-family: var(--font-serif);
    color: var(--color-ivory);
  }
  
  .spk-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    line-height: 1.6;
    color: rgba(251, 246, 234, 0.7);
    max-width: 600px;
    margin: 0 auto;
    font-weight: 400;
  }
  
  .legal-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 20px;
    padding: clamp(2rem, 5vw, 4rem);
  }
  
  .prose-column {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(251, 246, 234, 0.85);
  }
  
  :global(.prose-block h3) {
    font-family: var(--font-serif);
    font-size: 1.8rem;
    color: var(--color-gold);
    margin: 2rem 0 1rem;
    font-weight: 400;
  }
  
  :global(.prose-block p) {
    margin-bottom: 1rem;
  }
  
  :global(.prose-block .intro) {
    font-size: 1.25rem;
    color: var(--color-ivory);
    margin-bottom: 2rem;
  }
  
  :global(.prose-block ul) {
    list-style: none;
    padding-left: 1.5rem;
  }
  
  :global(.prose-block ul li) {
    margin-bottom: 0.75rem;
    position: relative;
  }
  
  :global(.prose-block ul li::before) {
    content: "•";
    color: var(--color-gold);
    position: absolute;
    left: -1.5rem;
    top: 0;
  }
  
  :global(.prose-block strong) {
    color: var(--color-ivory);
  }
  
  .mt-8 { margin-top: 2rem; }
</style>
