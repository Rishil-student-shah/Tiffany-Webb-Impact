---
import Layout from '../layouts/Layout.astro';
import Eyebrow from '../components/Eyebrow.astro';
---

<Layout title="Terms of Service | Tiffany Webb" theme="secondary">
  <main class="page-content">
    
    <section class="utility-hero">
      <div class="container reveal-up">
        <Eyebrow>Legal</Eyebrow>
        <h1 class="utility-title">Terms of Use</h1>
      </div>
    </section>

    <section class="utility-content section-pad bg-cream">
      <div class="container prose-column stagger-group">
        
        <div class="stagger-item">
          <p class="intro">By using this website you agree to these terms.</p>
        </div>

        <div class="stagger-item mt-8">
          <h3>Use of this site</h3>
          <p>This website is provided for information about Tiffany Webb's speaking, training, and consulting services.</p>
        </div>
        
        <div class="stagger-item mt-8">
          <h3>Intellectual property</h3>
          <p>All content, including text, images, and branding, is the property of Tiffany Webb unless otherwise credited, and may not be reproduced without permission.</p>
        </div>
        
        <div class="stagger-item mt-8">
          <h3>No professional advice</h3>
          <p>Content on this site is educational and does not constitute clinical, medical, or legal advice. If you or someone you know needs support with gambling harm, please contact a qualified professional or a problem-gambling helpline.</p>
        </div>
        
        <div class="stagger-item mt-8 mb-12">
          <h3>Contact</h3>
          <p><a href="mailto:booking@tiffanywebb.com" style="text-decoration: underline;">booking@tiffanywebb.com</a></p>
        </div>

      </div>
    </section>

  </main>
</Layout>

<style>
  .page-content {
    padding-top: 0;
  }

  .utility-hero {
    background-color: var(--color-ink);
    color: var(--color-ivory);
    padding: var(--sp-16) 0 var(--sp-12);
    text-align: center;
  }

  .container {
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  .utility-title {
    margin-bottom: var(--sp-4);
  }

  .section-pad { padding: var(--sp-16) 0; }
  .bg-cream { background-color: var(--color-cream); }
  .mt-8 { margin-top: var(--sp-8); }
  .mb-12 { margin-bottom: var(--sp-12); }

  .prose-column {
    font-size: 1.125rem;
    color: var(--color-charcoal);
  }
  
  .intro {
    font-size: 1.25rem;
    color: var(--color-ink);
    border-left: 4px solid var(--color-gold);
    padding-left: var(--sp-4);
  }

  .prose-column h3 {
    font-size: 1.5rem;
    color: var(--color-emerald);
    margin-bottom: var(--sp-2);
  }

  .prose-column p {
    line-height: 1.6;
  }
</style>
