---
import Layout from '../../layouts/Layout.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import Waveform from '../../components/Waveform.astro';
import Button from '../../components/Button.astro';
import { getArticleBySlug, getArticles } from '../../lib/cms.js';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => {
    const slug = article.item_slug || article.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    return {
      params: { slug },
      props: { article }
    };
  });
}

const { slug } = Astro.params;
const article = Astro.props.article || await getArticleBySlug(slug);

if (!article) {
  return Astro.redirect('/404');
}

// Fetch all articles for next/previous navigation
const allArticles = await getArticles();
const currentIndex = allArticles.findIndex(a => (a.item_slug === slug || a.title?.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') === slug));
const nextArticle = currentIndex >= 0 && currentIndex < allArticles.length - 1 ? allArticles[currentIndex + 1] : null;
const prevArticle = currentIndex > 0 ? allArticles[currentIndex - 1] : null;
---

<Layout 
  title={`${article.title} | Tiffany Webb`} 
  description={article.excerpt || "An article by Tiffany Webb, BBA, MHP on gambling harm prevention and community impact."} 
  theme="dark"
>
  <main class="page-content bg-ink">
    
    <!-- Article Header -->
    <header class="article-hero theme-ink relative overflow-hidden">
      <Waveform opacity={0.06} flipX={true} variant="A" />
      <div class="ambient-glow" style="top: -10%; left: 50%; transform: translateX(-50%); width: 50vw; height: 300px; background: radial-gradient(ellipse, rgba(200, 162, 76, 0.08) 0%, transparent 70%);"></div>

      <div class="container relative z-10">
        <div class="article-header-inner max-w-3xl mx-auto text-center">
          
          <div class="mb-6">
            <a href="/insights" class="back-link font-mono text-xs text-gold uppercase tracking-wider hover:underline inline-flex items-center gap-1">
              &larr; Back to Insights
            </a>
          </div>

          <div class="article-meta-badges flex justify-center items-center gap-4 mb-4">
            <span class="category-tag text-gold font-mono text-xs uppercase tracking-wider">
              {article.category || 'Prevention'}
            </span>
            <span class="meta-dot text-ivory-dim">•</span>
            <span class="read-time font-mono text-xs text-ivory-dim">
              {article.badge || '5 min read'}
            </span>
            <span class="meta-dot text-ivory-dim">•</span>
            <span class="publish-date font-mono text-xs text-ivory-dim">
              {article.date || 'August 2026'}
            </span>
          </div>

          <h1 class="article-headline font-serif text-ivory">
            {article.title}
          </h1>

          {article.subtitle && (
            <p class="article-subhead font-serif italic text-gold text-lg mt-4">
              {article.subtitle}
            </p>
          )}

          <div class="author-byline mt-6 pt-6 border-t-subtle flex items-center justify-center gap-3">
            <div class="author-info text-center">
              <span class="author-name font-mono text-xs uppercase tracking-widest text-ivory">By Tiffany Webb, BBA, MHP</span>
              <span class="author-title block text-xs text-ivory-dim mt-0.5">Community Impact Strategist & Public Health Educator</span>
            </div>
          </div>

        </div>
      </div>
    </header>

    <!-- Article Content (max-width 68ch centered column) -->
    <article class="article-body-section section-pad theme-ink relative border-t-subtle">
      <Waveform opacity={0.03} variant="B" />
      <div class="container relative z-10">
        
        <div class="article-prose-container max-w-prose mx-auto">
          <div class="article-body-content" set:html={article.content_html}></div>

          <!-- Author Bio Box -->
          <div class="author-bio-box glass-panel p-8 mt-16 flex flex-col sm:flex-row gap-6 items-center">
            <div class="author-bio-text flex-1">
              <span class="font-mono text-xs uppercase tracking-widest text-gold block mb-1">About the Author</span>
              <h3 class="font-serif text-xl text-ivory mb-2">Tiffany Webb, BBA, MHP</h3>
              <p class="text-sm text-ivory-dim leading-relaxed">
                Tiffany Webb is a Chicago-born public-health educator, Community Impact Strategist, and founder of GambleFreeGear with 15+ years and 4,000+ hours preventing gambling harm. She partners with health systems, schools, and community coalitions nationwide.
              </p>
              <div class="mt-4">
                <a href="/about" class="text-gold font-mono text-xs uppercase tracking-wider hover:underline">
                  Read Tiffany's Full Story &rarr;
                </a>
              </div>
            </div>
          </div>

          <!-- Next / Previous Article Navigation -->
          <div class="article-nav-grid grid grid-cols-1 sm:grid-cols-2 gap-6 mt-12 pt-8 border-t-subtle">
            {prevArticle ? (
              <a href={`/insights/${prevArticle.item_slug || prevArticle.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`} class="article-nav-card glass-panel p-6 text-left">
                <span class="font-mono text-xs text-gold uppercase tracking-wider block mb-1">&larr; Previous Article</span>
                <h4 class="font-serif text-base text-ivory line-clamp-2">{prevArticle.title}</h4>
              </a>
            ) : <div />}

            {nextArticle ? (
              <a href={`/insights/${nextArticle.item_slug || nextArticle.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`} class="article-nav-card glass-panel p-6 text-right sm:col-start-2">
                <span class="font-mono text-xs text-gold uppercase tracking-wider block mb-1">Next Article &rarr;</span>
                <h4 class="font-serif text-base text-ivory line-clamp-2">{nextArticle.title}</h4>
              </a>
            ) : <div />}
          </div>

        </div>

      </div>
    </article>

    <!-- Closing CTA -->
    <section class="section-pad theme-forest relative text-center overflow-hidden border-t-subtle" id="cta">
      <Waveform opacity={0.05} variant="A" flipX={true} />
      <div class="container relative z-10 max-w-3xl mx-auto">
        <Eyebrow className="justify-center">WORK WITH TIFFANY</Eyebrow>
        <h2 class="cta-headline mt-4">Bring these insights to your stage or team.</h2>
        <p class="cta-subtitle mt-4">
          Book a keynote, clinical training, or strategic consultation customized for your audience.
        </p>
        <div class="cta-actions mt-8">
          <Button href="/work-with-tiffany" variant="primary" className="magnetic-btn px-10 py-4 text-base">
            Invite Tiffany to Speak →
          </Button>
        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .bg-ink {
    background-color: var(--color-ink);
    color: var(--color-ivory);
    min-height: 100vh;
  }

  .container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--sp-6);
  }

  /* Article Hero */
  .article-hero {
    padding: calc(var(--sp-24) + 50px) 0 var(--sp-12);
    position: relative;
  }

  .article-headline {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    line-height: 1.15;
    margin: var(--sp-2) 0;
  }

  .back-link {
    transition: transform 0.2s ease;
  }
  .back-link:hover {
    transform: translateX(-4px);
  }

  .section-pad {
    padding: var(--sp-16) 0 var(--sp-24);
  }

  .border-t-subtle { border-top: 1px solid rgba(255, 255, 255, 0.08); }

  /* 68ch Max Width Column */
  .max-w-prose {
    max-width: 68ch;
    margin-left: auto;
    margin-right: auto;
  }

  /* Article Typography & Prose */
  .article-body-content {
    font-family: var(--font-sans);
    font-size: 1.15rem;
    line-height: 1.85;
    color: rgba(251, 246, 234, 0.88);
  }

  .article-body-content :global(p) {
    margin-bottom: 1.75rem;
  }

  .article-body-content :global(p.lead) {
    font-size: 1.35rem;
    line-height: 1.6;
    color: var(--color-ivory);
    font-weight: 400;
    margin-bottom: 2rem;
  }

  .article-body-content :global(h2),
  .article-body-content :global(h3) {
    font-family: var(--font-serif);
    color: var(--color-ivory);
    margin-top: 2.5rem;
    margin-bottom: 1.25rem;
    line-height: 1.3;
  }

  .article-body-content :global(h2) {
    font-size: 2rem;
  }

  .article-body-content :global(h3) {
    font-size: 1.6rem;
  }

  .article-body-content :global(ul),
  .article-body-content :global(ol) {
    margin-bottom: 2rem;
    padding-left: 1.75rem;
  }

  .article-body-content :global(li) {
    margin-bottom: 0.75rem;
  }

  .article-body-content :global(strong) {
    color: var(--color-ivory);
    font-weight: 600;
  }

  .article-body-content :global(blockquote) {
    border-left: 2px solid var(--color-gold);
    padding: 1.5rem 2rem;
    margin: 2.5rem 0;
    background: rgba(200, 162, 76, 0.05);
    border-radius: 0 12px 12px 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.4rem;
    line-height: 1.5;
    color: var(--color-gold);
  }

  /* Glass Panels */
  .glass-panel {
    background: rgba(20, 19, 14, 0.45);
    backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    transition: all 0.3s ease;
  }

  .article-nav-card {
    text-decoration: none;
    display: block;
  }

  .article-nav-card:hover {
    border-color: rgba(200, 162, 76, 0.4);
    transform: translateY(-4px);
  }

  /* Theme Forest CTA */
  .theme-forest {
    background: radial-gradient(circle at center, rgba(14, 107, 84, 0.15) 0%, rgba(13, 17, 23, 0.95) 100%);
  }

  .cta-headline {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--color-ivory);
    line-height: 1.2;
  }

  .cta-subtitle {
    font-size: 1.15rem;
    color: rgba(251, 246, 234, 0.75);
    line-height: 1.6;
  }

  .text-gold { color: var(--color-gold); }
  .text-ivory { color: var(--color-ivory); }
  .text-ivory-dim { color: rgba(251, 246, 234, 0.65); }
</style>
